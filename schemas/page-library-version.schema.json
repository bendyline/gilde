{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gezelgilde.com/schemas/page-library-version.schema.json",
  "type": "object",
  "properties": {
    "minGezelVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "releasedAt": {
      "type": "string"
    },
    "lines": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
          },
          "answers": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "before": {
                "type": "string"
              }
            },
            "required": [
              "from"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "npm"
              },
              "package": {
                "type": "string",
                "minLength": 1,
                "maxLength": 214
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "publishedAt": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "package",
              "version",
              "sha256"
            ]
          },
          "packages": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 214
            }
          },
          "include": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "module": {
            "type": "object",
            "properties": {
              "default": {
                "type": "boolean"
              },
              "entries": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^\\.(?:\\/.+)?$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            },
            "required": [
              "entries"
            ]
          },
          "classic": {
            "type": "object",
            "properties": {
              "default": {
                "type": "boolean"
              },
              "entries": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^\\.(?:\\/.+)?$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "global": {
                "type": "string"
              }
            },
            "required": [
              "entries"
            ]
          },
          "style": {
            "type": "object",
            "properties": {
              "default": {
                "type": "boolean"
              },
              "entries": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^\\.(?:\\/.+)?$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            },
            "required": [
              "entries"
            ]
          },
          "globals": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^\\.(?:\\/[\\w.-]+)*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "global": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][\\w$]*$"
                },
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "exports": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_$][\\w$]*$"
                  }
                },
                "after": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "jsxRuntime": {
                  "type": "boolean"
                }
              },
              "required": [
                "global",
                "file"
              ]
            }
          },
          "commonjs": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^\\.(?:\\/[\\w.-]+)*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "exports": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_$][\\w$]*$"
                  }
                },
                "imports": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "file"
              ]
            }
          },
          "paths": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "cdnjs": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            },
            "required": [
              "name"
            ]
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "form": {
                  "type": "string",
                  "enum": [
                    "module",
                    "classic",
                    "style"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "url",
                "form",
                "path"
              ]
            }
          },
          "requires": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "notice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "hosts": {
            "default": [
              "desktop"
            ],
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "desktop",
                "phone"
              ]
            }
          },
          "phoneRequests": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\.(?:\\/[\\w.-]+)*$"
            }
          }
        },
        "required": [
          "version",
          "answers",
          "source",
          "packages",
          "include",
          "license"
        ]
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "releasedAt",
    "lines"
  ]
}
