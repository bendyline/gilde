{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gezelgilde.com/schemas/project-type-identity.schema.json",
  "type": "object",
  "properties": {
    "minGezelVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.\\-:]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maintainer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "logo": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "licenseClass": {
      "type": "string",
      "enum": [
        "open",
        "commercial-restricted",
        "custom-restricted"
      ]
    },
    "licenseShortName": {
      "type": "string"
    },
    "licenseUrl": {
      "type": "string",
      "format": "uri"
    },
    "recoScore": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "yankedVersions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "minSupportedVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "project-type"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "code",
        "communication",
        "creative",
        "writing",
        "growth",
        "game",
        "data",
        "home",
        "money",
        "events",
        "other"
      ]
    },
    "icon": {
      "type": "string",
      "enum": [
        "sheet",
        "folder",
        "code",
        "branch",
        "envelope",
        "calendar",
        "bubbles",
        "chart",
        "frame",
        "quill",
        "sprout",
        "die",
        "house",
        "coin",
        "banner",
        "terminal",
        "globe",
        "server",
        "package",
        "book",
        "palette",
        "camera",
        "briefcase",
        "heart",
        "cards",
        "meal",
        "plane",
        "people",
        "dots"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "maintainer",
    "kind"
  ]
}
