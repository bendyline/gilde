{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gezelgilde.com/schemas/gezel-template-version.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "releasedAt": {
      "type": "string"
    },
    "about": {
      "type": "string"
    },
    "suggestedProvider": {
      "type": "string",
      "enum": [
        "copilot",
        "openai",
        "anthropic",
        "anthropic-cli",
        "codex-cli",
        "ollama",
        "llama-cpp",
        "mlx",
        "ds4",
        "remote"
      ]
    },
    "suggestedModel": {
      "type": "string"
    },
    "suggestedTools": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "frontmatter": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "nameSuggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "releasedAt",
    "about"
  ]
}
