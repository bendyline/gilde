{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gezelgilde.com/schemas/image-model-identity.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.\\-:]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maintainer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "logo": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "licenseClass": {
      "type": "string",
      "enum": [
        "open",
        "commercial-restricted",
        "custom-restricted"
      ]
    },
    "licenseShortName": {
      "type": "string"
    },
    "licenseUrl": {
      "type": "string",
      "format": "uri"
    },
    "recoScore": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "yankedVersions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "minSupportedVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "image-model"
    },
    "recommendedSteps": {
      "default": 20,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "widthRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "heightRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "upstream": {
      "type": "string",
      "format": "uri"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "artistic",
        "photographic"
      ]
    },
    "weightsKind": {
      "default": "checkpoint",
      "type": "string",
      "enum": [
        "checkpoint",
        "diffusion-model"
      ]
    },
    "hardwareTier": {
      "type": "string",
      "enum": [
        "low",
        "mid",
        "high",
        "workstation"
      ]
    },
    "minRamGB": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "commercialUse": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "maintainer",
    "kind",
    "hardwareTier",
    "minRamGB",
    "commercialUse"
  ]
}
