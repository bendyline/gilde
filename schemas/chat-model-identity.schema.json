                    "maximum": 2
                  },
                  "dry": {
                    "type": "object",
                    "properties": {
                      "multiplier": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5,
                        "description": "DRY penalty strength. 0 disables. 0.8 is a reasonable default."
                      },
                      "base": {
                        "description": "Base of the exponential penalty for repeated tokens. Default 1.75.",
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "allowedLength": {
                        "description": "Minimum n-gram length before DRY kicks in. Default 2.",
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 64
                      }
                    },
                    "required": [
                      "multiplier"
                    ],
                    "description": "DRY anti-repetition sampler (llama.cpp only)."
                  },
                  "xtc": {
                    "type": "object",
                    "properties": {
                      "probability": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Probability of triggering XTC on any given step."
                      },
                      "threshold": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Minimum top-token probability for XTC to fire."
                      }
                    },
                    "required": [
                      "probability",
                      "threshold"
                    ],
                    "description": "XTC sampler (llama.cpp only)."
                  }
                }
              },
              "reasoning": {
                "type": "object",
                "properties": {
                  "effort": {
                    "description": "Cloud reasoning effort. Maps to OpenAI `reasoning.effort` and Anthropic `thinking.budget_tokens` tiers.",
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "thinkingBudget": {
                    "description": "Explicit thinking-token budget (Anthropic `thinking.budget_tokens`, Nemotron `reasoning_budget`). Wins over `effort` when both set.",
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "enableThinking": {
                    "description": "Chat-template toggle for dual-mode models (Qwen3+, Nemotron Nano/Super). Implicit on cloud thinking models.",
                    "type": "boolean"
                  },
                  "templateKwargs": {
                    "description": "Chat-template variables that drive this model's reasoning depth, forwarded verbatim as `chat_template_kwargs` on local engines. The names are the model's own — GPT-OSS reads `reasoning_effort`, Muse Glimmer reads `reasoning_strength` (low|medium|high|xhigh) — so the manifest declares them rather than the runtime guessing. Lives under `reasoning` (not `engine`) because depth is a per-request choice a tuning profile overrides: `thinking-coding` can ask for xhigh while `instruct` asks for low. Cloud providers ignore it; use `reasoning.effort` there.",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                },
                "description": "Reasoning controls."
              },
              "output": {
                "type": "object",
                "properties": {
                  "responseFormat": {
                    "description": "Output mode. `text` = freeform (default). `json_object` = enforce JSON.",
                    "type": "string",
                    "enum": [
                      "text",
                      "json_object"
                    ]
                  },
                  "jsonSchema": {
                    "description": "Pin output to a JSON Schema (OpenAI strict mode, llama.cpp --json-schema)."
                  },
                  "grammar": {
                    "description": "llama.cpp GBNF grammar. Last-resort structured-output knob.",
                    "type": "string"
                  }
                },
                "description": "Structured-output controls."
              },
              "toolChoice": {
                "description": "Tool selection mode (cloud + llama.cpp + MLX). `auto` lets the model decide; `required` forces a tool call this turn; `none` disables tools.",
                "type": "string",
                "enum": [
                  "auto",
                  "required",
                  "none"
                ]
              },
              "promptTags": {
                "type": "object",
                "properties": {
                  "enableThinkingTag": {
                    "description": "User-prompt tag that enables thinking for this turn (e.g. `/think`).",
                    "type": "string"
                  },
                  "disableThinkingTag": {
                    "description": "User-prompt tag that disables thinking for this turn (e.g. `/no_think`).",
                    "type": "string"
                  }
                },
                "description": "Per-turn reasoning toggle tags."
              }
            }
          }
        }
      },
      "description": "Per-model sampling, reasoning, and output defaults."
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "maintainer",
    "kind",
    "parameterSize",
    "supportsTools"
  ]
}
