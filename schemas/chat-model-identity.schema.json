{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gezelgilde.com/schemas/chat-model-identity.schema.json",
  "type": "object",
  "properties": {
    "minGezelVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.\\-:]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maintainer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "logo": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "licenseClass": {
      "type": "string",
      "enum": [
        "open",
        "commercial-restricted",
        "custom-restricted"
      ]
    },
    "licenseShortName": {
      "type": "string"
    },
    "licenseUrl": {
      "type": "string",
      "format": "uri"
    },
    "recoScore": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "yankedVersions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "minSupportedVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "chat-model"
    },
    "maker": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "parameterSize": {
      "type": "string"
    },
    "supportsTools": {
      "type": "boolean"
    },
    "contextWindow": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "kvBytesPerTokenF16": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "kvFixedBytesF16": {
      "type": "number",
      "minimum": 0
    },
    "upstream": {
      "type": "string",
      "format": "uri"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "coding",
        "reasoning",
        "vision",
        "embedding"
      ]
    },
    "style": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "enum": [
            "gemma",
            "qwen",
            "gpt-oss",
            "mistral",
            "llama",
            "deepseek",
            "qwq",
            "phi",
            "nemotron",
            "granite",
            "glm",
            "muse",
            "other"
          ]
        },
        "reasoningFormat": {
          "type": "string",
          "enum": [
            "think",
            "channel",
            "inline",
            "none"
          ]
        },
        "toolCallFormat": {
          "type": "string",
          "enum": [
            "function-call",
            "qwen-xml",
            "hermes",
            "gemma-special-token",
            "json-envelope"
          ]
        }
      },
      "required": [
        "family",
        "reasoningFormat",
        "toolCallFormat"
      ]
    },
    "behaviors": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "config": {}
            },
            "required": [
              "id"
            ]
          }
        ]
      }
    },
    "tuning": {
      "type": "object",
      "properties": {
        "sampling": {
          "type": "object",
          "properties": {
            "temperature": {
              "description": "Sampling temperature. 0 = greedy. Most reasoning models want 0.6–1.0.",
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "topP": {
              "description": "Nucleus sampling. 0.95 is the common default for Qwen, Gemma, Nemotron.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "topK": {
              "description": "Top-k cutoff. 20 for Qwen think, 64 for Gemma, 1 for greedy-on-instruct.",
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "minP": {
              "description": "Min-p cutoff (llama.cpp / MLX / Ollama). Qwen recommends 0.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maxTokens": {
              "description": "Per-turn output token cap. Maps to num_predict / max_tokens / n_predict.",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "seed": {
              "description": "RNG seed. Unset / negative = random. Best-effort determinism on cloud.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "repetitionPenalty": {
              "description": "Local engines (Ollama / llama.cpp / MLX): repeat_penalty. 1.0 = off, 1.1 = mild.",
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "repetitionContext": {
              "description": "Local engines: window size for repetition penalty (`repeat_last_n`).",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "frequencyPenalty": {
              "description": "Cloud (OpenAI) and Ollama / llama.cpp: penalize repeated tokens by frequency.",
              "type": "number",
              "minimum": -2,
              "maximum": 2
            },
            "presencePenalty": {
              "description": "Cloud (OpenAI) and Ollama / llama.cpp: penalize any reused token.",
              "type": "number",
              "minimum": -2,
              "maximum": 2
            },
            "dry": {
              "type": "object",
              "properties": {
                "multiplier": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5,
                  "description": "DRY penalty strength. 0 disables. 0.8 is a reasonable default."
                },
                "base": {
                  "description": "Base of the exponential penalty for repeated tokens. Default 1.75.",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5
                },
                "allowedLength": {
                  "description": "Minimum n-gram length before DRY kicks in. Default 2.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 64
                }
              },
              "required": [
                "multiplier"
              ],
              "description": "DRY anti-repetition sampler (llama.cpp only)."
            },
            "xtc": {
              "type": "object",
              "properties": {
                "probability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Probability of triggering XTC on any given step."
                },
                "threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Minimum top-token probability for XTC to fire."
                }
              },
              "required": [
                "probability",
                "threshold"
              ],
              "description": "XTC sampler (llama.cpp only)."
            }
          },
          "description": "Sampling parameters applied per-request."
        },
        "samplingWhenThinking": {
          "description": "Sparse override of `sampling` applied when the runtime determines reasoning is engaged. Used by Qwen3+ (different sampling for /think mode) and Nemotron Nano (different sampling for thinking vs instruct).",
          "type": "object",
          "properties": {
            "temperature": {
              "description": "Sampling temperature. 0 = greedy. Most reasoning models want 0.6–1.0.",
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "topP": {
              "description": "Nucleus sampling. 0.95 is the common default for Qwen, Gemma, Nemotron.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "topK": {
              "description": "Top-k cutoff. 20 for Qwen think, 64 for Gemma, 1 for greedy-on-instruct.",
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "minP": {
              "description": "Min-p cutoff (llama.cpp / MLX / Ollama). Qwen recommends 0.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maxTokens": {
              "description": "Per-turn output token cap. Maps to num_predict / max_tokens / n_predict.",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "seed": {
              "description": "RNG seed. Unset / negative = random. Best-effort determinism on cloud.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "repetitionPenalty": {
              "description": "Local engines (Ollama / llama.cpp / MLX): repeat_penalty. 1.0 = off, 1.1 = mild.",
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "repetitionContext": {
              "description": "Local engines: window size for repetition penalty (`repeat_last_n`).",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "frequencyPenalty": {
              "description": "Cloud (OpenAI) and Ollama / llama.cpp: penalize repeated tokens by frequency.",
              "type": "number",
              "minimum": -2,
              "maximum": 2
            },
            "presencePenalty": {
              "description": "Cloud (OpenAI) and Ollama / llama.cpp: penalize any reused token.",
              "type": "number",
              "minimum": -2,
              "maximum": 2
            },
            "dry": {
              "type": "object",
              "properties": {
                "multiplier": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5,
                  "description": "DRY penalty strength. 0 disables. 0.8 is a reasonable default."
                },
                "base": {
                  "description": "Base of the exponential penalty for repeated tokens. Default 1.75.",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5
                },
                "allowedLength": {
                  "description": "Minimum n-gram length before DRY kicks in. Default 2.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 64
                }
              },
              "required": [
                "multiplier"
              ],
              "description": "DRY anti-repetition sampler (llama.cpp only)."
            },
            "xtc": {
              "type": "object",
              "properties": {
                "probability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Probability of triggering XTC on any given step."
                },
                "threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Minimum top-token probability for XTC to fire."
                }
              },
              "required": [
                "probability",
                "threshold"
              ],
              "description": "XTC sampler (llama.cpp only)."
            }
          }
        },
        "reasoning": {
          "type": "object",
          "properties": {
            "effort": {
              "description": "Cloud reasoning effort. Maps to OpenAI `reasoning.effort` and Anthropic `thinking.budget_tokens` tiers.",
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "thinkingBudget": {
              "description": "Explicit thinking-token budget (Anthropic `thinking.budget_tokens`, Nemotron `reasoning_budget`). Wins over `effort` when both set.",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "enableThinking": {
              "description": "Chat-template toggle for dual-mode models (Qwen3+, Nemotron Nano/Super). Implicit on cloud thinking models.",
              "type": "boolean"
            },
            "templateKwargs": {
              "description": "Chat-template variables that drive this model's reasoning depth, forwarded verbatim as `chat_template_kwargs` on local engines. The names are the model's own — GPT-OSS reads `reasoning_effort`, Muse Glimmer reads `reasoning_strength` (low|medium|high|xhigh) — so the manifest declares them rather than the runtime guessing. Lives under `reasoning` (not `engine`) because depth is a per-request choice a tuning profile overrides: `thinking-coding` can ask for xhigh while `instruct` asks for low. Cloud providers ignore it; use `reasoning.effort` there.",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "description": "Reasoning controls."
        },
        "output": {
          "type": "object",
          "properties": {
            "responseFormat": {
              "description": "Output mode. `text` = freeform (default). `json_object` = enforce JSON.",
              "type": "string",
              "enum": [
                "text",
                "json_object"
              ]
            },
            "jsonSchema": {
              "description": "Pin output to a JSON Schema (OpenAI strict mode, llama.cpp --json-schema)."
            },
            "grammar": {
              "description": "llama.cpp GBNF grammar. Last-resort structured-output knob.",
              "type": "string"
            }
          },
          "description": "Structured-output controls."
        },
        "toolChoice": {
          "description": "Tool selection mode (cloud + llama.cpp + MLX). `auto` lets the model decide; `required` forces a tool call this turn; `none` disables tools.",
          "type": "string",
          "enum": [
            "auto",
            "required",
            "none"
          ]
        },
        "promptTags": {
          "type": "object",
          "properties": {
            "enableThinkingTag": {
              "description": "User-prompt tag that enables thinking for this turn (e.g. `/think`).",
              "type": "string"
            },
            "disableThinkingTag": {
              "description": "User-prompt tag that disables thinking for this turn (e.g. `/no_think`).",
              "type": "string"
            }
          },
          "description": "Per-turn reasoning toggle tags."
        },
        "engine": {
          "description": "Per-model ENGINE launch-flag defaults (llama.cpp `--n-gpu-layers`, `--cpu-moe`, `--spec-type`, …). Applied once at model load, not per request — so it lives on the top-level tuning object, not inside per-request `profiles`.",
          "type": "object",
          "properties": {
            "llamaCpp": {
              "type": "object",
              "properties": {
                "nGpuLayers": {
                  "description": "`--n-gpu-layers` override. -1 = all. Unset = b9843 `auto`/`--fit`.",
                  "type": "integer",
                  "minimum": -1,
                  "maximum": 9007199254740991
                },
                "cpuMoe": {
                  "description": "`--cpu-moe`: keep ALL MoE experts in system RAM (attention/dense on GPU).",
                  "type": "boolean"
                },
                "nCpuMoe": {
                  "description": "`--n-cpu-moe N`: keep the first N layers’ MoE experts in RAM. Partial split.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "cacheReuse": {
                  "description": "`--cache-reuse N` prefix-KV reuse chunk. 0 = disable. Unset inherits the global default.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "swaFull": {
                  "description": "`--swa-full`: full-size SWA cache (Gemma family).",
                  "type": "boolean"
                },
                "flashAttn": {
                  "description": "`--flash-attn` mode override for this model.",
                  "type": "string",
                  "enum": [
                    "on",
                    "off",
                    "auto"
                  ]
                },
                "ubatchSize": {
                  "description": "`--ubatch-size` (inner microbatch) override for this model.",
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "contextSize": {
                  "description": "Per-turn context ceiling (tokens) this model launches with. Capped by GGUF train ctx.",
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "chatTemplate": {
                  "description": "`--chat-template` override for GGUFs whose embedded Jinja template is incompatible with llama.cpp tool parsing.",
                  "type": "string",
                  "minLength": 1
                },
                "threads": {
                  "description": "`--threads` override.",
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "batchSize": {
                  "description": "`--batch-size` override.",
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "spec": {
                  "description": "Speculative-decoding config for this model.",
                  "type": "object",
                  "properties": {
                    "type": {
                      "description": "`--spec-type` speculative-decoding mode for this model.",
                      "type": "string",
                      "enum": [
                        "none",
                        "draft-mtp",
                        "draft-eagle3",
                        "draft-dflash",
                        "draft-simple",
                        "ngram-mod",
                        "ngram-simple",
                        "ngram-map-k",
                        "ngram-map-k4v",
                        "ngram-cache"
                      ]
                    },
                    "mtp": {
                      "description": "VERIFIED capability metadata: this model’s target or companion GGUF carries MTP tensors. Does not enable `draft-mtp` by itself.",
                      "type": "boolean"
                    },
                    "draftModelId": {
                      "description": "Catalog id / path of the draft model for `draft-simple`.",
                      "type": "string"
                    },
                    "nMax": {
                      "description": "`--spec-draft-n-max`: tokens drafted per step.",
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                }
              },
              "description": "Per-model llama.cpp launch-flag defaults (engine-level, applied at model load)."
            }
          }
        },
        "profiles": {
          "description": "Named tuning presets this model implements. Gezel frontmatter `tuningProfile` selects one; the resolver applies the profile as a layer between installDefault and catalog base. Missing requested profiles walk the canonical fallback chain.",
