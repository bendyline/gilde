{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gezelgilde.com/schemas/knowledge-catalog-version.schema.json",
  "type": "object",
  "properties": {
    "minGezelVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "releasedAt": {
      "type": "string"
    },
    "formatVersion": {
      "type": "string",
      "minLength": 1
    },
    "huggingface": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_\\-.]+\\/[A-Za-z0-9_\\-.]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repo",
        "revision",
        "path"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "archiveBytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "uncompressedBytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "documents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "chunks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "embeddingProfile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "multilingual-e5-small@1",
            "bge-small-en-v1.5@1"
          ]
        },
        "modelRepo": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "modelRepo"
      ]
    },
    "topics": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "taxonomyVersion": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "date"
      ]
    },
    "parquet": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_\\-.]+\\/[A-Za-z0-9_\\-.]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dir": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repo",
        "revision",
        "dir"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "releasedAt",
    "formatVersion",
    "huggingface",
    "sha256",
    "archiveBytes",
    "uncompressedBytes",
    "documents",
    "chunks",
    "embeddingProfile",
    "topics"
  ]
}
