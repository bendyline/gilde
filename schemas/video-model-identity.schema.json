{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gezelgilde.com/schemas/video-model-identity.schema.json",
  "type": "object",
  "properties": {
    "minGezelVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.\\-:]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maintainer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "logo": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "licenseClass": {
      "type": "string",
      "enum": [
        "open",
        "commercial-restricted",
        "custom-restricted"
      ]
    },
    "licenseShortName": {
      "type": "string"
    },
    "licenseUrl": {
      "type": "string",
      "format": "uri"
    },
    "recoScore": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "yankedVersions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "minSupportedVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "video-model"
    },
    "family": {
      "type": "string",
      "enum": [
        "ltx",
        "ltx2",
        "wan",
        "lingbot"
      ]
    },
    "engine": {
      "default": "diffusers",
      "type": "string",
      "enum": [
        "diffusers",
        "sd-cpp"
      ]
    },
    "architecture": {
      "type": "string",
      "enum": [
        "ltx-video-0.9",
        "ltx-2",
        "wan2.2-ti2v-5b",
        "wan2.1-1.3b",
        "lingbot-video-1.3b"
      ]
    },
    "sdCpp": {
      "type": "object",
      "properties": {
        "sampler": {
          "type": "string",
          "enum": [
            "euler",
            "euler_a",
            "heun",
            "dpm2",
            "dpm++2s_a",
            "dpm++2m",
            "dpm++2mv2",
            "ipndm",
            "ipndm_v",
            "lcm",
            "ddim_trailing",
            "tcd",
            "res_multistep",
            "lms"
          ]
        },
        "scheduler": {
          "type": "string",
          "enum": [
            "discrete",
            "karras",
            "exponential",
            "ays",
            "gits",
            "sgm_uniform",
            "simple",
            "smoothstep",
            "kl_optimal",
            "lcm"
          ]
        },
        "flowShift": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "customSigmas": {
          "minItems": 2,
          "maxItems": 1001,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "highNoise": {
          "type": "object",
          "properties": {
            "steps": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "cfg": {
              "type": "number",
              "minimum": 0
            },
            "sampler": {
              "type": "string",
              "enum": [
                "euler",
                "euler_a",
                "heun",
                "dpm2",
                "dpm++2s_a",
                "dpm++2m",
                "dpm++2mv2",
                "ipndm",
                "ipndm_v",
                "lcm",
                "ddim_trailing",
                "tcd",
                "res_multistep",
                "lms"
              ]
            },
            "scheduler": {
              "type": "string",
              "enum": [
                "discrete",
                "karras",
                "exponential",
                "ays",
                "gits",
                "sgm_uniform",
                "simple",
                "smoothstep",
                "kl_optimal",
                "lcm"
              ]
            },
            "flowShift": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "moeBoundary": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "vaeTiling": {
          "type": "object",
          "properties": {
            "spatial": {
              "default": true,
              "type": "boolean"
            },
            "temporal": {
              "default": false,
              "type": "boolean"
            },
            "tileSizePx": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048
            },
            "temporalTileFrames": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "temporalDecodeFrames": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "cacheMode": {
          "type": "string",
          "enum": [
            "easycache",
            "dbcache",
            "taylorseer",
            "cache-dit"
          ]
        },
        "negativePrompt": {
          "type": "string"
        },
        "outputCompression": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "promptFormat": {
      "type": "string",
      "enum": [
        "text",
        "lingbot-caption"
      ]
    },
    "load": {
      "type": "object",
      "properties": {
        "strategy": {
          "default": "diffusers-tree",
          "type": "string",
          "enum": [
            "diffusers-tree",
            "single-file"
          ]
        },
        "pipelineClass": {
          "type": "string"
        },
        "singleFileName": {
          "type": "string"
        },
        "transformerClass": {
          "type": "string"
        },
        "vaeDtype": {
          "type": "string",
          "enum": [
            "float32",
            "bfloat16"
          ]
        },
        "audio": {
          "default": false,
          "type": "boolean"
        },
        "sigmas": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "recommendedSteps": {
      "default": 40,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "guidanceScale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "defaultNumFrames": {
      "default": 97,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "numFramesRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "defaultFps": {
      "default": 24,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "fpsRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "maxDurationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "widthRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "heightRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "defaultWidth": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "defaultHeight": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "supportsImageToVideo": {
      "default": false,
      "type": "boolean"
    },
    "imageToVideoOnly": {
      "type": "boolean"
    },
    "upstream": {
      "type": "string",
      "format": "uri"
    },
    "hardwareTier": {
      "type": "string",
      "enum": [
        "low",
        "mid",
        "high",
        "workstation"
      ]
    },
    "minVramGB": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "commercialUse": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "maintainer",
    "kind",
    "family",
    "commercialUse"
  ]
}
