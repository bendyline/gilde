{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gezelgilde.com/schemas/video-model-identity.schema.json",
  "type": "object",
  "properties": {
    "minGezelVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.\\-:]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maintainer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "logo": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "licenseClass": {
      "type": "string",
      "enum": [
        "open",
        "commercial-restricted",
        "custom-restricted"
      ]
    },
    "licenseShortName": {
      "type": "string"
    },
    "licenseUrl": {
      "type": "string",
      "format": "uri"
    },
    "recoScore": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "yankedVersions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "minSupportedVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "video-model"
    },
    "family": {
      "type": "string",
      "enum": [
        "ltx",
        "ltx2",
        "wan"
      ]
    },
    "load": {
      "type": "object",
      "properties": {
        "strategy": {
          "default": "diffusers-tree",
          "type": "string",
          "enum": [
            "diffusers-tree",
            "single-file"
          ]
        },
        "pipelineClass": {
          "type": "string"
        },
        "singleFileName": {
          "type": "string"
        },
        "transformerClass": {
          "type": "string"
        },
        "vaeDtype": {
          "type": "string",
          "enum": [
            "float32",
            "bfloat16"
          ]
        },
        "audio": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "recommendedSteps": {
      "default": 40,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "guidanceScale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "defaultNumFrames": {
      "default": 97,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "numFramesRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "defaultFps": {
      "default": 24,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "fpsRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "maxDurationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "widthRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "heightRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "defaultWidth": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "defaultHeight": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "supportsImageToVideo": {
      "default": false,
      "type": "boolean"
    },
    "upstream": {
      "type": "string",
      "format": "uri"
    },
    "hardwareTier": {
      "type": "string",
      "enum": [
        "low",
        "mid",
        "high",
        "workstation"
      ]
    },
    "minVramGB": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "commercialUse": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "maintainer",
    "kind",
    "family",
    "hardwareTier",
    "minVramGB",
    "commercialUse"
  ]
}
