{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gezelgilde.com/schemas/image-lora-identity.schema.json",
  "type": "object",
  "properties": {
    "minGezelVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.\\-:]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maintainer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "logo": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "licenseClass": {
      "type": "string",
      "enum": [
        "open",
        "commercial-restricted",
        "custom-restricted"
      ]
    },
    "licenseShortName": {
      "type": "string"
    },
    "licenseUrl": {
      "type": "string",
      "format": "uri"
    },
    "recoScore": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "yankedVersions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "minSupportedVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "image-lora"
    },
    "baseModels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.\\-:]{1,63}$"
      }
    },
    "purpose": {
      "type": "string",
      "enum": [
        "style",
        "speed"
      ]
    },
    "strength": {
      "default": 1,
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 4
    },
    "prompt": {
      "type": "object",
      "properties": {
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "suffix": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "render": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "cfg": {
          "type": "number",
          "minimum": 0
        },
        "sampler": {
          "type": "string",
          "enum": [
            "euler",
            "euler_a",
            "heun",
            "dpm2",
            "dpm++2s_a",
            "dpm++2m",
            "dpm++2mv2",
            "ipndm",
            "ipndm_v",
            "lcm",
            "ddim_trailing",
            "tcd",
            "res_multistep",
            "lms"
          ]
        },
        "scheduler": {
          "type": "string",
          "enum": [
            "discrete",
            "karras",
            "exponential",
            "ays",
            "gits",
            "sgm_uniform",
            "simple",
            "smoothstep",
            "kl_optimal",
            "lcm"
          ]
        }
      }
    },
    "upstream": {
      "type": "string",
      "format": "uri"
    },
    "commercialUse": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "maintainer",
    "kind",
    "baseModels",
    "purpose",
    "commercialUse"
  ]
}
