{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gezelgilde.com/schemas/knowledge-catalog-keywords.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "sourceVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "terms": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200,
        "pattern": "^[^|\\s](?:[^|]*[^|\\s])?$"
      }
    },
    "articles": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000,
        "pattern": "^[^|\\s](?:[^|]*[^|\\s])?(?: \\| [^|\\s](?:[^|]*[^|\\s])?)*$"
      }
    },
    "matchCase": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200,
        "pattern": "^[^|\\s](?:[^|]*[^|\\s])?$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "catalogId"
  ]
}
