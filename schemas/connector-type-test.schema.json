{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gezelgilde.com/schemas/connector-type-test.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "recorded",
            "hand-written",
            "provider-docs"
          ]
        },
        "source": {
          "type": "string"
        },
        "recordedAt": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "alsoCovers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "config": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "credential": {
            "default": "none",
            "type": "string",
            "enum": [
              "none",
              "placeholder"
            ]
          },
          "passes": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "exchanges": {
            "maxItems": 60,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "http"
                    },
                    "request": {
                      "type": "object",
                      "properties": {
                        "method": {
                          "default": "GET",
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        }
                      },
                      "required": [
                        "url"
                      ]
                    },
                    "response": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "default": 200,
                          "type": "integer",
                          "minimum": 100,
                          "maximum": 599
                        },
                        "headers": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "body": {}
                      }
                    },
                    "times": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 50
                    }
                  },
                  "required": [
                    "kind",
                    "request",
                    "response"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "mcp-tool"
                    },
                    "tool": {
                      "type": "string",
                      "minLength": 1
                    },
                    "args": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "result": {},
                    "isError": {
                      "type": "boolean"
                    },
                    "times": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 50
                    }
                  },
                  "required": [
                    "kind",
                    "tool",
                    "result"
                  ]
                }
              ]
            }
          },
          "expect": {
            "type": "object",
            "properties": {
              "records": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "frontmatter": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "bodyIncludes": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              },
              "rows": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "required": [
          "id",
          "description",
          "exchanges",
          "expect"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "provenance",
    "cases"
  ]
}
