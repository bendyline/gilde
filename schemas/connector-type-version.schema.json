{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gezelgilde.com/schemas/connector-type-version.schema.json",
  "type": "object",
  "properties": {
    "minGezelVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "releasedAt": {
      "type": "string"
    },
    "driver": {
      "type": "string",
      "enum": [
        "mcp",
        "script",
        "spectral",
        "native"
      ]
    },
    "configSchema": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "secretShape": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "setupInstructions": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "urlLabel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title"
      ]
    },
    "source": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "normalize": {
      "default": {
        "kind": "native"
      },
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mapping"
            },
            "map": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "kind",
            "map"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "script"
            },
            "script": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "script"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "native"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "observations"
            },
            "tables": {
              "minItems": 1,
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "schemaVersion": {
                    "type": "number",
                    "const": 1
                  },
                  "table": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "^[a-z0-9][a-z0-9_-]*$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "grain": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "timeColumn": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "partitionColumn": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "columns": {
                    "minItems": 1,
                    "maxItems": 512,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120,
                          "pattern": "^[a-z_][a-z0-9_]*$"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "BOOLEAN",
                            "BIGINT",
                            "DOUBLE",
                            "VARCHAR",
                            "DATE",
                            "TIMESTAMP",
                            "JSON"
                          ]
                        },
                        "role": {
                          "default": "attribute",
                          "type": "string",
                          "enum": [
                            "time",
                            "dimension",
                            "measure",
                            "identifier",
                            "attribute"
                          ]
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "unit": {
                          "type": "string",
                          "maxLength": 60
                        },
                        "cardinalityHint": {
                          "type": "string",
                          "maxLength": 120
                        },
                        "examples": {
                          "maxItems": 8,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 200
                          }
                        }
                      },
                      "required": [
                        "name",
                        "type"
                      ]
                    }
                  },
                  "measures": {
                    "default": [],
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120,
                          "pattern": "^[a-z_][a-z0-9_]*$"
                        },
                        "sql": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "unit": {
                          "type": "string",
                          "maxLength": 60
                        }
                      },
                      "required": [
                        "name",
                        "sql"
                      ]
                    }
                  },
                  "exemplars": {
                    "default": [],
                    "maxItems": 32,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "question": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        },
                        "sql": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4000
                        }
                      },
                      "required": [
                        "question",
                        "sql"
                      ]
                    }
                  },
                  "rollups": {
                    "default": [],
                    "maxItems": 32,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120,
                          "pattern": "^[a-z_][a-z0-9_]*$"
                        },
                        "grain": {
                          "minItems": 1,
                          "maxItems": 16,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          }
                        },
                        "sql": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8000
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 500
                        }
                      },
                      "required": [
                        "name",
                        "grain",
                        "sql"
                      ]
                    }
                  },
                  "retention": {
                    "type": "object",
                    "properties": {
                      "rawDays": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 36500
                      }
                    }
                  },
                  "inferred": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "schemaVersion",
                  "table",
                  "columns"
                ]
              }
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "actions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "consentScope": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "consentScope"
        ]
      }
    },
    "completeness": {
      "type": "string",
      "enum": [
        "mirror",
        "window"
      ]
    },
    "allowedOrigins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "releasedAt",
    "driver",
    "source"
  ]
}
