{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gezelgilde.com/schemas/project-type-version.schema.json",
  "type": "object",
  "properties": {
    "minGezelVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "releasedAt": {
      "type": "string"
    },
    "extends": {
      "type": "string"
    },
    "meesterManaged": {
      "type": "boolean"
    },
    "tabVisibility": {
      "type": "object",
      "properties": {
        "overview": {
          "type": "boolean"
        },
        "tasks": {
          "type": "boolean"
        },
        "approvals": {
          "type": "boolean"
        },
        "workspace": {
          "type": "boolean"
        },
        "artifacts": {
          "type": "boolean"
        },
        "map": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "crew",
        "solo"
      ]
    },
    "leadLabel": {
      "type": "string",
      "minLength": 1
    },
    "leanProfile": {
      "type": "boolean"
    },
    "indexingEnabled": {
      "type": "boolean"
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "nameTemplate": {
      "type": "string",
      "minLength": 1
    },
    "aboutTemplate": {
      "type": "string"
    },
    "missionTemplate": {
      "type": "string"
    },
    "gezels": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string"
          },
          "voorman": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "templateId"
        ]
      }
    },
    "toolsets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "need": {
            "default": "suggested",
            "type": "string",
            "enum": [
              "required",
              "suggested"
            ]
          },
          "autoAllow": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "craftbooks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scripts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][\\w-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 65536
      }
    },
    "tools": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string"
          },
          "script": {
            "type": "string"
          },
          "inputs": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "bind": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "reaction": {
            "type": "object",
            "properties": {
              "gezel": {
                "type": "string"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "hideSeed": {
                "type": "boolean"
              }
            },
            "required": [
              "gezel",
              "prompt"
            ]
          }
        },
        "required": [
          "name",
          "description",
          "script"
        ]
      }
    },
    "pages": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string"
        },
        "reads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "artifacts",
                  "workspace",
                  "type"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "subtree": {
                "type": "boolean"
              }
            },
            "required": [
              "source",
              "path"
            ]
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "required": [
        "entry"
      ]
    },
    "schedules": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "runMode": {
            "default": "scheduled",
            "type": "string",
            "enum": [
              "scheduled",
              "night-shift"
            ]
          },
          "cron": {
            "type": "string"
          },
          "craftbook": {
            "type": "string"
          },
          "consent": {
            "default": "ask",
            "type": "string",
            "enum": [
              "ask",
              "auto",
              "disabled"
            ]
          },
          "overlap": {
            "type": "string",
            "enum": [
              "skip",
              "queue",
              "concurrent"
            ]
          }
        },
        "required": [
          "craftbook"
        ]
      }
    },
    "workspaceSeed": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifactsSeed": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "releasedAt"
  ]
}
