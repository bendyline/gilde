{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gezelgilde.com/schemas/video-model-version.schema.json",
  "type": "object",
  "properties": {
    "minGezelVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "releasedAt": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "huggingfaceRepo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_\\-.]+\\/[A-Za-z0-9_\\-.]+$"
        },
        "revision": {
          "type": "string"
        },
        "files": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "sizeBytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "repo": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_\\-.]+\\/[A-Za-z0-9_\\-.]+$"
              },
              "revision": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "sha256",
              "sizeBytes"
            ]
          }
        },
        "approxSizeBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "quantization": {
          "type": "string"
        }
      },
      "required": [
        "huggingfaceRepo",
        "files",
        "approxSizeBytes"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "releasedAt",
    "source"
  ]
}
