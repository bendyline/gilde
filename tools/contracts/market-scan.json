{
  "id": "market-scan",
  "contract": {
    "goal": "A market scan inside a stated boundary that sizes the market, maps its segments and players, and covers drivers, trends and risks, where every sized figure is cited to a dated source and appears in it.",
    "deliverables": [
      {
        "id": "scan",
        "path": "{{workPath}}/scan.md",
        "artifact": true,
        "kind": "markdown-report",
        "description": "The landscape report: the headline read and market boundary, a section per lens, a so-what takeaway, and the References its [n] citations point to"
      }
    ],
    "grounding": { "citationStyle": "numbered" },
    "criteria": [
      {
        "id": "substantial",
        "kind": "acceptance",
        "text": "The scan is a full document organized under section headings",
        "checks": [
          { "kind": "minBytes", "file": "{{workPath}}/scan.md", "bytes": 1500, "artifact": true },
          {
            "kind": "contains",
            "file": "{{workPath}}/scan.md",
            "pattern": "(?:^|\\n)#{1,3}\\s+\\S",
            "label": "section headings",
            "artifact": true
          }
        ]
      },
      {
        "id": "boundary",
        "kind": "acceptance",
        "text": "It states the market boundary and names the adjacent markets it excludes",
        "checks": [
          {
            "kind": "contains",
            "file": "{{workPath}}/scan.md",
            "pattern": "exclu(?:de|des|ded|ding|sion|sions)\\b|out of scope|outside (?:the |this |our )?(?:scope|boundary)|not (?:included|covered|in scope)",
            "flags": "i",
            "label": "the exclusions that bound the market",
            "artifact": true
          }
        ]
      },
      {
        "id": "lenses",
        "kind": "acceptance",
        "text": "It has its own section for market size and growth, segments, players, demand drivers, trends, and risks",
        "checks": [
          {
            "kind": "contains",
            "file": "{{workPath}}/scan.md",
            "pattern": "^#{1,4}\\s+[^\\n]*(?:\\b(?:size|sizing|spend|spending|revenue|market value|valuation|TAM)\\b|\\bgrowth\\b(?![^\\n]*\\bdriv))",
            "flags": "im",
            "label": "a market size and growth section",
            "artifact": true
          },
          {
            "kind": "contains",
            "file": "{{workPath}}/scan.md",
            "pattern": "^#{1,4}\\s+[^\\n]*\\b(?:segment|buyer|customer|sub-?market)",
            "flags": "im",
            "label": "a segments section",
            "artifact": true
          },
          {
            "kind": "contains",
            "file": "{{workPath}}/scan.md",
            "pattern": "^#{1,4}\\s+[^\\n]*\\b(?:player|competit|vendor|landscape|compan|incumbent|provider|leader|market map)",
            "flags": "im",
            "label": "a players section",
            "artifact": true
          },
          {
            "kind": "contains",
            "file": "{{workPath}}/scan.md",
            "pattern": "^#{1,4}\\s+[^\\n]*\\b(?:driv|demand|tailwind|catalyst)",
            "flags": "im",
            "label": "a demand drivers section",
            "artifact": true
          },
          {
            "kind": "contains",
            "file": "{{workPath}}/scan.md",
            "pattern": "^#{1,4}\\s+[^\\n]*\\btrend",
            "flags": "im",
            "label": "a trends section",
            "artifact": true
          },
          {
            "kind": "contains",
            "file": "{{workPath}}/scan.md",
            "pattern": "^#{1,4}\\s+[^\\n]*\\b(?:risk|headwind|threat|challenge|constraint|barrier)",
            "flags": "im",
            "label": "a risks section",
            "artifact": true
          }
        ]
      },
      {
        "id": "takeaway",
        "kind": "acceptance",
        "text": "It closes with a short so-what takeaway for the reader",
        "checks": [
          {
            "kind": "contains",
            "file": "{{workPath}}/scan.md",
            "pattern": "so[- ]what|takeaway|implications?\\b|bottom line|what this means|recommendations?\\b|key insight",
            "flags": "i",
            "label": "a so-what takeaway",
            "artifact": true
          }
        ]
      },
      {
        "id": "references",
        "kind": "acceptance",
        "text": "It lists the sources behind its [n] citations in a References or Sources section, each with a path or URL",
        "checks": [
          {
            "kind": "contains",
            "file": "{{workPath}}/scan.md",
            "pattern": "(?:^|\\n)#{1,6}\\s*(?:sources|references|citations|works cited|bibliography)\\b",
            "flags": "i",
            "label": "a References or Sources section",
            "artifact": true
          }
        ]
      },
      {
        "id": "cited",
        "kind": "quality",
        "text": "Its figures carry citations, and every cited file exists",
        "checks": [
          { "kind": "citationsResolve", "file": "{{workPath}}/scan.md", "minCitations": 1, "artifact": true }
        ]
      },
      {
        "id": "grounded",
        "kind": "quality",
        "text": "Every size, growth rate, date and quote appears in the source it cites; no figure is stated without a source",
        "checks": [{ "kind": "claimsGrounded", "file": "{{workPath}}/scan.md", "artifact": true }]
      },
      {
        "id": "focused",
        "kind": "quality",
        "enforce": "advisory",
        "text": "It leads with the headline read, stays inside the boundary without mixing in adjacent markets, gives each sized figure its year, and names at least three trends with evidence",
        "judge": {
          "rubric": "Does the scan lead with a clear headline read, stay inside its stated boundary, date its sized figures, and name at least three evidenced trends a decision-maker could use?"
        }
      }
    ]
  }
}
