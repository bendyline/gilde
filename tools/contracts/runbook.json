{
  "id": "runbook",
  "contract": {
    "goal": "An on-call runbook a tired engineer can follow literally: when to use it and when not to, prerequisites, numbered copy-pasteable steps that each say what to expect and how to verify it, warnings before risky steps, a rollback, and an escalation path.",
    "deliverables": [
      {
        "id": "runbook",
        "path": "runbook.md",
        "kind": "markdown-doc",
        "description": "The runbook, in Markdown"
      }
    ],
    "criteria": [
      {
        "id": "complete-runbook",
        "kind": "acceptance",
        "text": "The runbook is a complete document organized under headings",
        "checks": [
          {
            "kind": "minBytes",
            "file": "runbook.md",
            "bytes": 500
          },
          {
            "kind": "contains",
            "file": "runbook.md",
            "pattern": "(?:^|\\n)#{1,3}\\s+\\S",
            "label": "section headings"
          }
        ]
      },
      {
        "id": "when-to-use",
        "kind": "acceptance",
        "text": "It says when to use it and when not to",
        "checks": [
          {
            "kind": "contains",
            "file": "runbook.md",
            "pattern": "\\bwhen\\s+to\\s+use\\b|\\buse\\s+(?:this|it)\\s+(?:runbook\\s+|playbook\\s+|procedure\\s+)?(?:when|if|for)\\b|\\btriggers?\\b|\\bsymptoms?\\b|\\bapplies\\s+(?:when|to|if)\\b",
            "flags": "i",
            "label": "when to use it"
          },
          {
            "kind": "contains",
            "file": "runbook.md",
            "pattern": "\\bwhen\\s+not\\s+to\\s+use\\b|\\b(?:do\\s+not|don[’']t|never)\\s+use\\s+(?:this|it)\\b|\\bnot\\s+(?:for|applicable|suitable)\\b|\\bout\\s+of\\s+scope\\b|\\bdoes\\s+not\\s+(?:apply|cover)\\b",
            "flags": "i",
            "label": "when not to use it"
          }
        ]
      },
      {
        "id": "prerequisites",
        "kind": "acceptance",
        "text": "It lists prerequisites (access, tools, safety checks) before the procedure",
        "checks": [
          {
            "kind": "contains",
            "file": "runbook.md",
            "pattern": "\\bprerequisites?\\b|\\bbefore\\s+you\\s+(?:start|begin)\\b|\\bpre-?flight\\b|\\brequirements\\b|\\byou\\s+(?:will\\s+)?need\\b",
            "flags": "i",
            "label": "prerequisites"
          }
        ]
      },
      {
        "id": "numbered-steps",
        "kind": "acceptance",
        "text": "The procedure is written as numbered steps",
        "checks": [
          {
            "kind": "contains",
            "file": "runbook.md",
            "pattern": "(?:^|\\n)[ \\t]*(?:#{1,6}[ \\t]+)?(?:\\*\\*)?(?:step[ \\t]+)?2(?:[.):]|[ \\t]+[—–-])[ \\t]*\\S",
            "flags": "i",
            "label": "numbered steps"
          }
        ]
      },
      {
        "id": "commands",
        "kind": "acceptance",
        "text": "Commands are written out exactly in code formatting, ready to copy and paste",
        "checks": [
          {
            "kind": "contains",
            "file": "runbook.md",
            "pattern": "```|~~~|`[^`\\n]{3,}`",
            "label": "commands in code formatting"
          }
        ]
      },
      {
        "id": "rollback",
        "kind": "acceptance",
        "text": "It has a rollback section",
        "checks": [
          {
            "kind": "contains",
            "file": "runbook.md",
            "pattern": "(?:^|\\n)[ \\t]*(?:#{1,6}[ \\t]+|\\*\\*|__)[^\\n]{0,40}\\b(?:roll[- ]?back|back[- ]?out|revert|undo)",
            "flags": "i",
            "label": "a rollback section"
          }
        ]
      },
      {
        "id": "escalation",
        "kind": "acceptance",
        "text": "It has an escalation section",
        "checks": [
          {
            "kind": "contains",
            "file": "runbook.md",
            "pattern": "(?:^|\\n)[ \\t]*(?:#{1,6}[ \\t]+|\\*\\*|__)[^\\n]{0,40}\\bescalat",
            "flags": "i",
            "label": "an escalation section"
          }
        ]
      },
      {
        "id": "verified-steps",
        "kind": "quality",
        "text": "Steps say what output to expect and how to verify each one worked",
        "checks": [
          {
            "kind": "contains",
            "file": "runbook.md",
            "pattern": "\\bverif(?:y|ies|ied|ication)\\b|\\bexpected\\s+(?:output|result|response)s?\\b",
            "flags": "i",
            "label": "expected output or verification"
          }
        ]
      },
      {
        "id": "warnings",
        "kind": "quality",
        "text": "Risky or destructive steps carry a warning before them",
        "checks": [
          {
            "kind": "contains",
            "file": "runbook.md",
            "pattern": "\\b(?:warning|caution|danger|risk|irreversible|destructive)\\b|\\u26A0",
            "flags": "i",
            "label": "a warning"
          }
        ]
      },
      {
        "id": "no-unfinished-markers",
        "kind": "quality",
        "text": "Nothing is left unfinished: no TBD, TODO or FIXME",
        "checks": [
          {
            "kind": "notContains",
            "file": "runbook.md",
            "pattern": "\\bTBD\\b|\\bTODO\\b|\\bFIXME\\b",
            "label": "TBD, TODO or FIXME"
          }
        ]
      },
      {
        "id": "literal-and-safe",
        "kind": "quality",
        "enforce": "advisory",
        "text": "Each step is unambiguous and in order, rollback and escalation name real commands, people and timings, and it ends with a checklist that confirms the issue is fully resolved",
        "judge": {
          "rubric": "Could a tired on-call engineer follow every step literally and in order, with real commands, contacts and timings in the rollback and escalation sections, and a final check that the issue is resolved?"
        }
      },
      {
        "id": "supplied-facts",
        "kind": "quality",
        "enforce": "advisory",
        "text": "Commands, thresholds, names and contacts come from what the person supplied; anything unknown is a clearly marked placeholder, not an invention",
        "judge": {
          "rubric": "Do the commands, thresholds, names and contacts match what the person supplied, with anything unknown marked as a placeholder rather than invented?"
        }
      }
    ]
  }
}
