{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-07-08T00:00:00Z",
  "driver": "native",
  "source": {
    "adapterId": "calendar-google"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "calendars": {
        "type": "array",
        "title": "Calendar IDs (blank = all)",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "secretShape": {
    "kind": "oauth2",
    "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
    "tokenUrl": "https://oauth2.googleapis.com/token",
    "scopes": "https://www.googleapis.com/auth/calendar.readonly",
    "clientIdEnv": "GEZEL_GOOGLE_CLIENT_ID",
    "clientSecretEnv": "GEZEL_GOOGLE_CLIENT_SECRET",
    "authParams": {
      "access_type": "offline",
      "prompt": "consent"
    }
  },
  "normalize": {
    "kind": "native"
  },
  "completeness": "mirror"
}
