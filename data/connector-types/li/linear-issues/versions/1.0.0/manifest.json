{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-07-08T00:00:00Z",
  "driver": "mcp",
  "source": {
    "server": {
      "kind": "http",
      "transport": "streamable-http",
      "url": "https://mcp.linear.app/mcp",
      "headersFromSecret": {
        "Authorization": "Bearer $secret"
      }
    },
    "list": {
      "tool": "list_issues",
      "cursorArg": "updatedAfter",
      "itemsPath": "$.issues",
      "idPath": "$.id",
      "tsPath": "$.updatedAt"
    },
    "fetch": {
      "tool": "get_issue",
      "idArg": "id"
    }
  },
  "configSchema": {
    "type": "object",
    "properties": {}
  },
  "secretShape": {
    "kind": "apikey",
    "field": "Authorization"
  },
  "normalize": {
    "kind": "mapping",
    "map": {
      "id": "$.id",
      "title": "$.title",
      "group": "$.team.name",
      "timestamp": "$.updatedAt",
      "body": "$.description",
      "frontmatter": {
        "identifier": "$.identifier",
        "state": "$.state.name",
        "assignee": "$.assignee.name",
        "url": "$.url"
      }
    }
  },
  "completeness": "window"
}
