    "sampling": {
      "temperature": 0.7,
      "topP": 0.8,
      "topK": 20,
      "minP": 0,
      "maxTokens": 16384,
      "repetitionPenalty": 1.1,
      "repetitionContext": 20
    },
    "samplingWhenThinking": {
      "temperature": 0.6,
      "topP": 0.95
    },
    "reasoning": {
      "enableThinking": true,
      "thinkingBudget": 2048
    },
    "promptTags": {
      "enableThinkingTag": "/think",
      "disableThinkingTag": "/no_think"
    },
    "profiles": {
      "thinking-general": {
        "sampling": {
          "temperature": 0.6,
          "topP": 0.95,
          "topK": 20,
          "repetitionPenalty": 1.05
        }
      },
      "thinking-coding": {
        "sampling": {
          "temperature": 0.5,
          "topP": 0.9,
          "topK": 20,
          "repetitionPenalty": 1.05,
          "repetitionContext": 32,
          "dry": {
            "multiplier": 0.8,
            "base": 1.75,
            "allowedLength": 2
          }
        }
      },
      "thinking-precise": {
        "sampling": {
          "temperature": 0.3,
          "topP": 0.9,
          "topK": 10,
          "repetitionPenalty": 1.05
        }
      },
      "instruct": {
        "sampling": {
          "temperature": 0.7,
          "topP": 0.8,
          "topK": 20,
          "repetitionPenalty": 1.1
        }
      },
      "creative": {
        "sampling": {
          "temperature": 0.9,
          "topP": 0.95,
          "topK": 40,
          "repetitionPenalty": 1.1
        }
      }
    },
    "engine": {
