    "entry": "dist/index.js",
    "args": [],
    "envHints": [
      "DARKMATTER_API_KEY",
      "DARKMATTER_SHARE",
      "DARKMATTER_API_URL",
      "DARKMATTER_MCP_STORE_DIR"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "DARKMATTER_API_KEY",
      "envVar": "DARKMATTER_API_KEY",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Publishes each record to DarkMatter and returns a verification URL. Without it, records stay on local disk and verify offline."
    },
    {
      "id": "DARKMATTER_SHARE",
      "envVar": "DARKMATTER_SHARE",
      "label": "Optional",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional. Set to 'true' to make published records readable by anyone holding the link. Off by default.",
      "default": "false"
    },
    {
      "id": "DARKMATTER_API_URL",
      "envVar": "DARKMATTER_API_URL",
      "label": "Optional",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional. Override the API host. Defaults to https://darkmatterhub.ai."
    },
    {
      "id": "DARKMATTER_MCP_STORE_DIR",
      "envVar": "DARKMATTER_MCP_STORE_DIR",
      "label": "Optional",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional. Directory for local record storage."
    }
  ]
