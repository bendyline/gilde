{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-10-08T19:35:08.694501Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://app.sync-socials.com/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Sync Socials API key as a bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Sync Socials API key as a bearer token. Generate one in your workspace settings at app.sync-socials.com, then use the format: Bearer YOUR_API_KEY",
      "placeholder": "Bearer YOUR_SYNC_SOCIALS_API_KEY"
    }
  ]
}
