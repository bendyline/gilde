{
  "schemaVersion": 1,
  "version": "0.15.1",
  "releasedAt": "2026-06-16T08:37:32.521371Z",
  "runtime": {
    "kind": "npm-package",
    "package": "infomaniak-mcp-agent",
    "version": "0.15.1",
    "sha256": "8520828c97fa97b660ee21f0a664fb69a56d02f0f7c84555c81cbe1bccb4b9ac",
    "entry": "dist/server.js",
    "args": [],
    "envHints": [
      "INFOMANIAK_API_TOKEN",
      "INFOMANIAK_AUTH_MODE",
      "INFOMANIAK_SASESSION",
      "INFOMANIAK_XSRF_TOKEN"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "INFOMANIAK_API_TOKEN",
      "envVar": "INFOMANIAK_API_TOKEN",
      "label": "Bearer token for api",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token for api.infomaniak.com. Generate at https://manager.infomaniak.com/v3/api-token"
    },
    {
      "id": "INFOMANIAK_AUTH_MODE",
      "envVar": "INFOMANIAK_AUTH_MODE",
      "label": "Authentication mode for manager",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Authentication mode for manager.infomaniak.com endpoints. 'auto' (default) reads Chrome cookies on demand. 'manual' uses INFOMANIAK_SASESSION+INFOMANIAK_XSRF_TOKEN. 'disabled' skips manager-private endpoints.",
      "default": "auto"
    },
    {
      "id": "INFOMANIAK_SASESSION",
      "envVar": "INFOMANIAK_SASESSION",
      "label": "Manager session cookie (used when INFOMANIAK_AUTH_MODE=manual)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Manager session cookie (used when INFOMANIAK_AUTH_MODE=manual)."
    },
    {
      "id": "INFOMANIAK_XSRF_TOKEN",
      "envVar": "INFOMANIAK_XSRF_TOKEN",
      "label": "Manager XSRF cookie (used when INFOMANIAK_AUTH_MODE=manual)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Manager XSRF cookie (used when INFOMANIAK_AUTH_MODE=manual)."
    }
  ]
}
