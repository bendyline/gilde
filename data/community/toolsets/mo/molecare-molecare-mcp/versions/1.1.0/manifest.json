    "entry": "dist/index.js",
    "args": [],
    "envHints": [
      "MOLECARE_API_URL",
      "MOLECARE_API_KEY",
      "MLFLOW_TRACKING_URI",
      "AWS_REGION",
      "LOG_LEVEL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "MOLECARE_API_URL",
      "envVar": "MOLECARE_API_URL",
      "label": "Base URL of a MoleCare-compatible HTTP API",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Base URL of a MoleCare-compatible HTTP API. Omit to run in mock mode with synthetic data.",
      "default": "http://localhost:8080/api"
    },
    {
      "id": "MOLECARE_API_KEY",
      "envVar": "MOLECARE_API_KEY",
      "label": "API key for the MoleCare API",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "API key for the MoleCare API. Only needed when MOLECARE_API_URL points at a real backend."
    },
    {
      "id": "MLFLOW_TRACKING_URI",
      "envVar": "MLFLOW_TRACKING_URI",
      "label": "MLflow tracking server for experiment and model-run tools",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "MLflow tracking server for experiment and model-run tools. Mocked when unset.",
      "default": "http://localhost:5000"
    },
    {
      "id": "AWS_REGION",
      "envVar": "AWS_REGION",
      "label": "AWS region for EC2 and CloudWatch operations tools",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "AWS region for EC2 and CloudWatch operations tools. Credentials come from the standard AWS chain.",
      "default": "us-east-1"
    },
    {
      "id": "LOG_LEVEL",
      "envVar": "LOG_LEVEL",
      "label": "Logging verbosity (error, warn, info, debug)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Logging verbosity (error, warn, info, debug).",
      "default": "info"
    }
  ]
}
