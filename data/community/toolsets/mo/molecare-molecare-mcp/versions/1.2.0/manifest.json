      "id": "MOLECARE_API_KEY",
      "envVar": "MOLECARE_API_KEY",
      "label": "API key for the MoleCare API",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "API key for the MoleCare API. Only needed when MOLECARE_API_URL points at a real backend."
    },
    {
      "id": "LOG_LEVEL",
      "envVar": "LOG_LEVEL",
      "label": "Logging verbosity (error, warn, info, debug)",
