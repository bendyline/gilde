{
  "schemaVersion": 1,
  "version": "1.3.0",
  "releasedAt": "2026-10-31T11:48:47.064383Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.moltrust.ch/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-API-Key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-API-Key",
      "envVar": "X-API-Key",
      "label": "Your MolTrust API key (authenticates identity/credits/register tools)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Your MolTrust API key (authenticates identity/credits/register tools). Optional — read-only tools work without it.",
      "default": "{api_key}"
    }
  ]
}
