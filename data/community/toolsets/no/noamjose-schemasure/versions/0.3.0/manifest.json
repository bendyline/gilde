{
  "schemaVersion": 1,
  "version": "0.3.0",
  "releasedAt": "2026-07-31T20:02:58.298314Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@noamjose/schemasure",
    "version": "0.3.0",
    "sha256": "2ec603eeb735ba2e1cec9a38d00772bec9ea394b46d2f7e3d6ab605c0efe323e",
    "entry": "dist/server.mjs",
    "args": [],
    "envHints": [
      "SCHEMASURE_API_URL",
      "SCHEMASURE_TIMEOUT_MS",
      "SCHEMASURE_PRIVATE_KEY",
      "SCHEMASURE_MAX_PRICE_USD"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "SCHEMASURE_API_URL",
      "envVar": "SCHEMASURE_API_URL",
      "label": "Base URL of SchemaSure",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Base URL of SchemaSure. Text has free V1 evaluation without a wallet; image extraction is V2-only and always requires a wallet.",
      "default": "https://schemasure.com"
    },
    {
      "id": "SCHEMASURE_TIMEOUT_MS",
      "envVar": "SCHEMASURE_TIMEOUT_MS",
      "label": "Per-call request timeout in milliseconds",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Per-call request timeout in milliseconds.",
      "default": "90000"
    },
    {
      "id": "SCHEMASURE_PRIVATE_KEY",
      "envVar": "SCHEMASURE_PRIVATE_KEY",
      "label": "Optional 0x-prefixed EVM key",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional 0x-prefixed EVM key. Enables paid x402 V2 text and image calls; signs Base USDC payments locally. Never sent to SchemaSure."
    },
    {
      "id": "SCHEMASURE_MAX_PRICE_USD",
      "envVar": "SCHEMASURE_MAX_PRICE_USD",
      "label": "Client-side spend cap in USD per call (paid mode)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Client-side spend cap in USD per call (paid mode). The client refuses to pay more than this, even if the server advertises a higher price.",
      "default": "0.10"
    }
  ]
}
