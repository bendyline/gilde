{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-05-10T01:15:55.750398Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.puckapi.com/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "x-api-key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-api-key",
      "envVar": "x-api-key",
      "label": "Your PuckAPI API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your PuckAPI API key. Get a free key with 500 credits at puckapi.com/signup"
    }
  ]
}
