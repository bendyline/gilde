{
  "schemaVersion": 1,
  "version": "1.1.6",
  "releasedAt": "2026-10-16T19:30:18.770034Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.fastballapi.com/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "x-api-key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-api-key",
      "envVar": "x-api-key",
      "label": "Your FastballAPI API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your FastballAPI API key. Get a free key (500 credits every month) at fastballapi.com/signup"
    }
  ]
}
