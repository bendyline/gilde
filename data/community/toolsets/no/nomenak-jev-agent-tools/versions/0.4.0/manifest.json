{
  "schemaVersion": 1,
  "version": "0.4.0",
  "releasedAt": "2026-10-07T13:15:35.326836Z",
  "runtime": {
    "kind": "npm-package",
    "package": "jev-agent-tools",
    "version": "0.4.0",
    "sha256": "d05802c14619692bb0e25f4c955ecfce7e7723aaa4fd79f7325dbe3fd68162db",
    "entry": "dist/mcp/main.js",
    "args": [
      "--root"
    ],
    "envHints": [
      "JEV_TOOLS_URL",
      "JEV_TOOLS_API_KEY",
      "JEV_TOOLS_MODEL",
      "JEV_TOOLS_ALLOW_COMMAND"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "JEV_TOOLS_URL",
      "envVar": "JEV_TOOLS_URL",
      "label": "Complete endpoint URL compatible with the Jev API format",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Complete endpoint URL compatible with the Jev API format."
    },
    {
      "id": "JEV_TOOLS_API_KEY",
      "envVar": "JEV_TOOLS_API_KEY",
      "label": "Bearer credential for the endpoint",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer credential for the endpoint."
    },
    {
      "id": "JEV_TOOLS_MODEL",
      "envVar": "JEV_TOOLS_MODEL",
      "label": "Requested Jev model",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Requested Jev model.",
      "default": "openjev"
    },
    {
      "id": "JEV_TOOLS_ALLOW_COMMAND",
      "envVar": "JEV_TOOLS_ALLOW_COMMAND",
      "label": "Set to 0 to remove shell commands from jev_ask",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Set to 0 to remove shell commands from jev_ask."
    }
  ]
}
