{
  "schemaVersion": 1,
  "version": "0.3.3",
  "releasedAt": "2026-11-12T22:18:58.78865Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.norc.app/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token with your norc API key (vault",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token with your norc API key (vault.norc.app, Settings, API Keys)",
      "default": "Bearer {api_key}"
    }
  ]
}
