{
  "schemaVersion": 1,
  "version": "4.2.0",
  "releasedAt": "2026-11-05T17:59:11.2179Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://eif.leocelis.com/sse",
    "transport": "sse",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "API key for the EIF hosted server",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "API key for the EIF hosted server. Request one at https://github.com/leocelis/eif/discussions",
      "default": "Bearer {api_key}"
    }
  ]
}
