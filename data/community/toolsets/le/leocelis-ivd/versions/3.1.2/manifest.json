{
  "schemaVersion": 1,
  "version": "3.1.2",
  "releasedAt": "2026-07-22T18:46:51.136744Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.ivdframework.dev/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "API key for the IVD hosted server",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "API key for the IVD hosted server. Request one at https://ivdframework.dev.",
      "default": "Bearer {api_key}"
    }
  ]
}
