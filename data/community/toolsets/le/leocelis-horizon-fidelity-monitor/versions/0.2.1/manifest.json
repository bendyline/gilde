{
  "schemaVersion": 1,
  "version": "0.2.1",
  "releasedAt": "2026-05-06T23:14:11.413858Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://horizon.leocelis.com/sse",
    "transport": "sse",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "API key for the Horizon hosted server",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "API key for the Horizon hosted server. Request one at https://github.com/leocelis/horizon/discussions",
      "default": "Bearer {api_key}"
    }
  ]
}
