{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-11-02T10:46:47.927644Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.testoptim.com/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your TestOptim API key as a bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your TestOptim API key as a bearer token. Create one under Settings > API keys.",
      "default": "Bearer {api_key}"
    }
  ]
}
