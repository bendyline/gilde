{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-20T20:42:37.655622Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.openfinance.tech/agent/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "x-api-key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-api-key",
      "envVar": "x-api-key",
      "label": "Optional OpenFinance API key (starts with open_)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional OpenFinance API key (starts with open_). Leave unset to sign in with OAuth instead."
    }
  ]
}
