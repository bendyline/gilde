    "entry": "dist/src/cli.js",
    "args": [
      "mcp"
    ],
    "envHints": [
      "MARK_NETWORK",
      "MARK_ESCROW_URL",
      "MARK_HOME",
      "MARK_PASSWORD"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "MARK_NETWORK",
      "envVar": "MARK_NETWORK",
      "label": "bitcoin (default, real money) or mutinynet (test)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "bitcoin (default, real money) or mutinynet (test)",
      "default": "bitcoin"
    },
    {
      "id": "MARK_ESCROW_URL",
      "envVar": "MARK_ESCROW_URL",
      "label": "Escrow server URL",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Escrow server URL. Default on bitcoin: https://agentescrow.to"
    },
    {
      "id": "MARK_HOME",
      "envVar": "MARK_HOME",
      "label": "Directory for the agent's key and config (default ~/",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Directory for the agent's key and config (default ~/.mark)"
    },
    {
      "id": "MARK_PASSWORD",
      "envVar": "MARK_PASSWORD",
      "label": "Keystore password (else MARK_PASSWORD_FILE, else an auto-created 0600 file)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Keystore password (else MARK_PASSWORD_FILE, else an auto-created 0600 file)"
    }
