{
  "schemaVersion": 1,
  "version": "1.1.1",
  "releasedAt": "2026-10-10T01:47:01.515856Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://genmagic.co/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization",
      "X-GenMagic-Client"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "GenMagic API key as a Bearer token, created at https://genmagic",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "GenMagic API key as a Bearer token, created at https://genmagic.co/get-api-key",
      "default": "Bearer {api_key}"
    },
    {
      "id": "X-GenMagic-Client",
      "envVar": "X-GenMagic-Client",
      "label": "X-GenMagic-Client",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "default": "mcp-registry/1.1.1"
    }
  ]
}
