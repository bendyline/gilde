{
  "schemaVersion": 1,
  "version": "0.3.0-rc.2",
  "releasedAt": "2026-11-11T12:51:00.289353Z",
  "runtime": {
    "kind": "npm-package",
    "package": "comfyui-light-mcp",
    "version": "0.3.0-rc.2",
    "sha256": "c2dea246d3bbcdf671184bb0753fb4b44056ebfe1b9a6f4a0ff022b81951ca6f",
    "entry": "dist/index.js",
    "args": [],
    "envHints": [
      "COMFYUI_URL",
      "WORKFLOWS_DIR",
      "DATA_DIR",
      "OUTPUT_DIR",
      "AUTO_SAVE_OUTPUTS",
      "MAX_IN_FLIGHT",
      "MAX_QUEUED_JOBS",
      "JOB_TIMEOUT_MS"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "COMFYUI_URL",
      "envVar": "COMFYUI_URL",
      "label": "Required installation choice: your trusted running ComfyUI HTTP(S) endpoint",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Required installation choice: your trusted running ComfyUI HTTP(S) endpoint. No credentials, query or fragment.",
      "placeholder": "http://127.0.0.1:8188"
    },
    {
      "id": "WORKFLOWS_DIR",
      "envVar": "WORKFLOWS_DIR",
      "label": "Required absolute existing directory containing your reviewed workflow API JSON and manifest pairs",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Required absolute existing directory containing your reviewed workflow API JSON and manifest pairs.",
      "placeholder": "C:/mcp/workflows"
    },
    {
      "id": "DATA_DIR",
      "envVar": "DATA_DIR",
      "label": "Required absolute writable SQLite state directory",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Required absolute writable SQLite state directory. Use a separate directory per MCP process.",
      "placeholder": "C:/mcp/data"
    },
    {
      "id": "OUTPUT_DIR",
      "envVar": "OUTPUT_DIR",
      "label": "Required absolute writable output/download/index directory",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Required absolute writable output/download/index directory.",
      "placeholder": "C:/mcp/output"
    },
    {
      "id": "AUTO_SAVE_OUTPUTS",
      "envVar": "AUTO_SAVE_OUTPUTS",
      "label": "Application default: true",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Application default: true. Download outputs on completion; false defers downloads to result queries.",
      "default": "true"
    },
    {
      "id": "MAX_IN_FLIGHT",
      "envVar": "MAX_IN_FLIGHT",
      "label": "Application default: 1",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Application default: 1. Integer 1-64; includes uncertain submissions.",
      "default": "1"
    },
    {
      "id": "MAX_QUEUED_JOBS",
      "envVar": "MAX_QUEUED_JOBS",
      "label": "Application default: 1",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Application default: 1. Integer 1-64, no greater than MAX_IN_FLIGHT.",
      "default": "1"
    },
    {
      "id": "JOB_TIMEOUT_MS",
      "envVar": "JOB_TIMEOUT_MS",
      "label": "Application default: 600000",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Application default: 600000. Integer 10000-86400000 milliseconds.",
      "default": "600000"
    }
  ]
}
