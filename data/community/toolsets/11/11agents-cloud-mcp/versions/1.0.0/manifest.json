{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-07-19T11:16:03.433781Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://app.11agents.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "11agents project token, sent as a Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "11agents project token, sent as a Bearer token.",
      "default": "Bearer {project_token}"
    }
  ]
}
