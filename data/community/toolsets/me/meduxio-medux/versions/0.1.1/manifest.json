  "runtime": {
    "kind": "http-mcp",
    "url": "https://medux.io/api/mcp/v1",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Medux API key as a Bearer token, e",
