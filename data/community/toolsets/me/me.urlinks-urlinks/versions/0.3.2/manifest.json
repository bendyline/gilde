{
  "schemaVersion": 1,
  "version": "0.3.2",
  "releasedAt": "2026-11-08T16:18:35.686655Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://urlinks.me/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your URLinks API key, sent as a bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your URLinks API key, sent as a bearer token.",
      "default": "Bearer {api_key}"
    }
  ]
}
