{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-08-06T18:36:03.79779Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.usepalim.com/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "x-api-key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-api-key",
      "envVar": "x-api-key",
      "label": "Palim API key from https://api",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Palim API key from https://api.usepalim.com/setup (OAuth also supported in clients that use it)"
    }
  ]
}
