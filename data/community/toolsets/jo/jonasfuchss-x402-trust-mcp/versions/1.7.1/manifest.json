      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Cumulative auto-pay cap per process in USD. 0 = unlimited.",
      "default": "1.00"
    },
    {
      "id": "X402_MAX_CALLS",
      "envVar": "X402_MAX_CALLS",
