    {
      "id": "X402_PRIVATE_KEY",
      "envVar": "X402_PRIVATE_KEY",
      "label": "Optional Base wallet private key (with or without the 0x prefix)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional Base wallet private key (with or without the 0x prefix). When set, the paid tools auto-pay over x402 up to X402_MAX_USD; otherwise they return a price quote. The free tools need no key."
    },
    {
      "id": "X402_MAX_USD",
      "envVar": "X402_MAX_USD",
      "label": "Per-call auto-pay ceiling in USD",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Per-call auto-pay ceiling in USD. 0 disables auto-pay.",
      "default": "0.05"
    },
    {
      "id": "X402_MAX_TOTAL_USD",
      "envVar": "X402_MAX_TOTAL_USD",
      "label": "Cumulative auto-pay cap per process in USD",
