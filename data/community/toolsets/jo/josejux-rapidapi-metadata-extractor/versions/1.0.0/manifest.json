{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-08-11T12:26:02.981353Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.rapidapi.com",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "x-api-host",
      "x-api-key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-api-host",
      "envVar": "x-api-host",
      "label": "RapidAPI host header - use exactly: web-metadata-and-contact-extractor",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "RapidAPI host header - use exactly: web-metadata-and-contact-extractor.p.rapidapi.com"
    },
    {
      "id": "x-api-key",
      "envVar": "x-api-key",
      "label": "Your RapidAPI key - get a free one at https://rapidapi",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your RapidAPI key - get a free one at https://rapidapi.com/josejuanjocoding/api/web-metadata-and-contact-extractor"
    }
  ]
}
