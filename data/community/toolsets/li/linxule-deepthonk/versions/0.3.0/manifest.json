{
  "schemaVersion": 1,
  "version": "0.3.0",
  "releasedAt": "2026-07-10T13:46:29.483611Z",
  "runtime": {
    "kind": "npm-package",
    "package": "deepthonk",
    "version": "0.3.0",
    "sha256": "cac1fc5cd27df53e3da2d7dcae120f79691ab8ec6d1230643ad6bce2b898cd15",
    "entry": "dist/index.js",
    "args": [
      "serve-mcp"
    ],
    "envHints": [
      "DEEPSEEK_API_KEY",
      "OPENROUTER_API_KEY",
      "DEEPTHONK_API_KEY",
      "DEEPTHONK_CONFIG",
      "DEEPTHONK_PROFILES_DIR"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "DEEPSEEK_API_KEY",
      "envVar": "DEEPSEEK_API_KEY",
      "label": "API key for the DeepSeek provider",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "API key for the DeepSeek provider. Optional: omit to use MCP sampling or another provider."
    },
    {
      "id": "OPENROUTER_API_KEY",
      "envVar": "OPENROUTER_API_KEY",
      "label": "API key for the OpenRouter provider",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "API key for the OpenRouter provider. Optional: omit to use MCP sampling or another provider."
    },
    {
      "id": "DEEPTHONK_API_KEY",
      "envVar": "DEEPTHONK_API_KEY",
      "label": "API key for a custom openai-compatible provider endpoint",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "API key for a custom openai-compatible provider endpoint. Optional."
    },
    {
      "id": "DEEPTHONK_CONFIG",
      "envVar": "DEEPTHONK_CONFIG",
      "label": "Path to config",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Path to config.yaml. Defaults to ~/.config/deepthonk/config.yaml."
    },
    {
      "id": "DEEPTHONK_PROFILES_DIR",
      "envVar": "DEEPTHONK_PROFILES_DIR",
      "label": "Directory of custom profile YAML files",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Directory of custom profile YAML files. Defaults to the config directory's profiles/."
    }
  ]
}
