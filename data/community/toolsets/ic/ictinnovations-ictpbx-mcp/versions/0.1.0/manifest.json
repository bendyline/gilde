  "tools": [],
  "config": [
    {
      "id": "ICTPBX_BASE_URL",
      "envVar": "ICTPBX_BASE_URL",
      "label": "ICTCore REST base URL of your ICTPBX server, normally ending in /api, e",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "ICTCore REST base URL of your ICTPBX server, normally ending in /api, e.g. https://your-ictpbx/api."
    },
    {
      "id": "ICTPBX_USERNAME",
      "envVar": "ICTPBX_USERNAME",
      "label": "API account email (ICTCore logs in by email)",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "API account email (ICTCore logs in by email)."
    },
    {
      "id": "ICTPBX_PASSWORD",
      "envVar": "ICTPBX_PASSWORD",
      "label": "Password for the account",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Password for the account."
    },
    {
      "id": "ICTPBX_TIMEOUT_MS",
      "envVar": "ICTPBX_TIMEOUT_MS",
      "label": "Per request timeout in milliseconds",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Per request timeout in milliseconds. Defaults to 30000.",
      "default": "30000"
    },
    {
      "id": "ICTPBX_TLS_INSECURE",
      "envVar": "ICTPBX_TLS_INSECURE",
      "label": "Skip TLS certificate verification",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Skip TLS certificate verification. Only for a self-signed test server.",
      "default": "false"
    }
  ]
