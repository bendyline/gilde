{
  "schemaVersion": 1,
  "version": "0.2.0",
  "releasedAt": "2026-09-14T00:21:30.936902Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://agentwares-agentguard.vercel.app/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <account key>",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer <account key>. POST /api/v1/signup {\"accept_terms\": true} for one — no human, no card. agentguard_spend_report and agentguard_get_pricing work without it."
    }
  ]
}
