{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-11-08T17:48:56.761742Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{host}/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer of_",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer of_... (OpenFault API token)",
      "default": "Bearer {token}"
    }
  ]
}
