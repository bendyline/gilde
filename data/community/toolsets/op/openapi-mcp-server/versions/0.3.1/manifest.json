{
  "schemaVersion": 1,
  "version": "0.3.1",
  "releasedAt": "2026-10-16T08:42:15.170517Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.openapi.com/",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Openapi® Bearer token, created at https://console",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Openapi® Bearer token, created at https://console.openapi.com/oauth with the scopes you need",
      "default": "Bearer {token}"
    }
  ]
}
