{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-07-22T04:54:50.385617Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://storeboard.dev/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer followed by your Storeboard API key, for example Bearer sb_live_your_key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer followed by your Storeboard API key, for example Bearer sb_live_your_key"
    }
  ]
}
