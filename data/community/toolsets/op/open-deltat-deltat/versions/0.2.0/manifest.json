{
  "schemaVersion": 1,
  "version": "0.2.0",
  "releasedAt": "2026-10-04T13:20:22.35757Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@open-deltat/mcp",
    "version": "0.2.0",
    "sha256": "0bf1604e3bd615bacc71cb3a0ed92e3fc22ab72a2f167eaf245185e316ec2f10",
    "entry": "dist/stdio.js",
    "args": [],
    "envHints": [
      "DELTAT_PASSWORD",
      "DELTAT_HOST",
      "DELTAT_PORT",
      "DELTAT_DATABASE",
      "DELTAT_USER",
      "DELTAT_TLS",
      "DELTAT_TLS_CA"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "DELTAT_PASSWORD",
      "envVar": "DELTAT_PASSWORD",
      "label": "Password for the deltat server",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Password for the deltat server. Required; there is no default."
    },
    {
      "id": "DELTAT_HOST",
      "envVar": "DELTAT_HOST",
      "label": "Hostname of the deltat server",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Hostname of the deltat server.",
      "default": "localhost"
    },
    {
      "id": "DELTAT_PORT",
      "envVar": "DELTAT_PORT",
      "label": "Port deltat listens on",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Port deltat listens on.",
      "default": "5433"
    },
    {
      "id": "DELTAT_DATABASE",
      "envVar": "DELTAT_DATABASE",
      "label": "Tenant to connect to",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Tenant to connect to. Each database name is an isolated tenant.",
      "default": "public"
    },
    {
      "id": "DELTAT_USER",
      "envVar": "DELTAT_USER",
      "label": "Username presented at connect time",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Username presented at connect time.",
      "default": "user"
    },
    {
      "id": "DELTAT_TLS",
      "envVar": "DELTAT_TLS",
      "label": "on to encrypt the connection and verify deltat's certificate",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "on to encrypt the connection and verify deltat's certificate. Unset means off unless DELTAT_TLS_CA is set; without TLS the password is sent in the clear, so use it for any deltat that is not on this machine."
    },
    {
      "id": "DELTAT_TLS_CA",
      "envVar": "DELTAT_TLS_CA",
      "label": "Path to a PEM certificate to trust instead of the system's authorities, for a deltat with a self-signed certificate",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Path to a PEM certificate to trust instead of the system's authorities, for a deltat with a self-signed certificate. Implies DELTAT_TLS=on."
    }
  ]
}
