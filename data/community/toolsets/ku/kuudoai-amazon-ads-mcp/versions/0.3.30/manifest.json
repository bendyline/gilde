{
  "schemaVersion": 1,
  "version": "0.3.30",
  "releasedAt": "2026-09-06T23:08:36.364216Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{HOSTNAME}/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer credential required by the selected Amazon Ads MCP deployment",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Bearer credential required by the selected Amazon Ads MCP deployment.",
      "default": "Bearer {AUTH_TOKEN}"
    }
  ]
}
