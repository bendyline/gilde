{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-09-06T12:33:47.904298Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{SELLING_PARTNER_HOST}/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Kuudo API key or deployment bearer token",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Kuudo API key or deployment bearer token.",
      "default": "Bearer {AUTH_TOKEN}"
    }
  ]
}
