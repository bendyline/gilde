      "envVar": "DATALINK_ANALYTICS_READONLY",
      "label": "Set to 'true' for read-only access",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Set to 'true' for read-only access. Pattern: DATALINK_<NAME>_READONLY"
