{
  "schemaVersion": 1,
  "version": "4.8.0",
  "releasedAt": "2026-10-27T09:25:32.595576Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@pipeshub-ai/mcp",
    "version": "4.8.0",
    "sha256": "9f927ffadabadfa6d68eeefbbef0922561a5324d54b3c57264df3b22110c9de0",
    "entry": "bin/mcp-server.js",
    "args": [
      "start",
      "--server-url",
      "--bearer-auth"
    ],
    "envHints": [
      "PIPESHUB_MCP_CHAT"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "PIPESHUB_MCP_CHAT",
      "envVar": "PIPESHUB_MCP_CHAT",
      "label": "\"off\" leaves out pipeshub_chat and pipeshub_agents so agents search and read records themselves",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "\"off\" leaves out pipeshub_chat and pipeshub_agents so agents search and read records themselves. Default \"on\" keeps every tool.",
      "default": "on",
      "options": [
        "on",
        "off"
      ]
    },
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer PAT",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer PAT. Value is 'Bearer <token>'. Never client_credentials."
    }
  ]
