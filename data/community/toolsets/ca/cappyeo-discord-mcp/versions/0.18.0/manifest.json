    {
      "id": "DISCORD_EXPECTED_BOT_ID",
      "envVar": "DISCORD_EXPECTED_BOT_ID",
      "label": "Expected Discord bot ID",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Expected Discord bot ID. Startup fails if the token belongs to another bot."
    },
    {
      "id": "ALLOWED_GUILDS",
      "envVar": "ALLOWED_GUILDS",
      "label": "Comma-separated Discord guild IDs this deployment may operate against",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Comma-separated Discord guild IDs this deployment may operate against."
