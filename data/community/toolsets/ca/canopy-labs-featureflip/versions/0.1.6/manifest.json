{
  "schemaVersion": 1,
  "version": "0.1.6",
  "releasedAt": "2026-09-16T12:05:35.692644Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@featureflip/mcp",
    "version": "0.1.6",
    "sha256": "d07f37783571a54c04672bc00ab5819a00656826f174167b328b3b2e95461f3e",
    "entry": "bin/featureflip-mcp.mjs",
    "args": [],
    "envHints": [
      "FEATUREFLIP_TOKEN",
      "FEATUREFLIP_API_URL",
      "FEATUREFLIP_ORG"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "FEATUREFLIP_TOKEN",
      "envVar": "FEATUREFLIP_TOKEN",
      "label": "Featureflip API token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Featureflip API token. A personal token (ffp_) acts as you; a service token (ffs_) is a scoped machine identity for CI and agents."
    },
    {
      "id": "FEATUREFLIP_API_URL",
      "envVar": "FEATUREFLIP_API_URL",
      "label": "Management API base URL",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Management API base URL. Defaults to https://api.featureflip.io.",
      "default": "https://api.featureflip.io"
    },
    {
      "id": "FEATUREFLIP_ORG",
      "envVar": "FEATUREFLIP_ORG",
      "label": "Organization slug",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Organization slug. Only needed for a personal token that can reach more than one organization."
    }
  ]
}
