  "tools": [],
  "config": [
    {
      "id": "OPENSWISSDATA_API_KEY",
      "envVar": "OPENSWISSDATA_API_KEY",
      "label": "Optional existing OAuth token for Pro tools (closed to new subscribers)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional existing OAuth token for Pro tools (closed to new subscribers). Without it: 3 free tools (100 calls/hour/IP) plus a trial of the 3 search tools (20 calls/day/IP in total)."
    },
    {
      "id": "OPENSWISSDATA_BASE_URL",
      "envVar": "OPENSWISSDATA_BASE_URL",
      "label": "Override the remote MCP endpoint (default: https://mcp",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Override the remote MCP endpoint (default: https://mcp.openswissdata.com). Useful for staging or self-hosting.",
      "default": "https://mcp.openswissdata.com"
    },
    {
      "id": "OPENSWISSDATA_TIMEOUT_MS",
      "envVar": "OPENSWISSDATA_TIMEOUT_MS",
      "label": "Per-request timeout in milliseconds",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Per-request timeout in milliseconds.",
      "default": "30000"
    }
  ]
