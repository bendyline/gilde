{
  "schemaVersion": 1,
  "version": "1.4.0",
  "releasedAt": "2026-10-26T20:23:38.13788Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://icx.caleralabs.com/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-License-Key",
      "X-Space-ID"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-License-Key",
      "envVar": "X-License-Key",
      "label": "Calera Labs API Key (obtain free at https://dashboard",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Calera Labs API Key (obtain free at https://dashboard.caleralabs.com)"
    },
    {
      "id": "X-Space-ID",
      "envVar": "X-Space-ID",
      "label": "Memory partition namespace (default: 'default')",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Memory partition namespace (default: 'default')"
    }
  ]
}
