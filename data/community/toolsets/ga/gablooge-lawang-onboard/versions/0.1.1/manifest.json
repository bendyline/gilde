{
  "schemaVersion": 1,
  "version": "0.1.1",
  "releasedAt": "2026-09-30T03:36:19.245186Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://lawang-onboard.samsulhadi.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token for your role (maintainer, employee or contractor)",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token for your role (maintainer, employee or contractor). Ask the server operator for one.",
      "default": "Bearer {onboard_token}"
    }
  ]
}
