{
  "schemaVersion": 1,
  "version": "1.2.3",
  "releasedAt": "2026-08-12T20:06:47.972473Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://whitepact-mcp-http.onrender.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer API key for the hosted WhitePact MCP server",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer API key for the hosted WhitePact MCP server. Obtain one from the WhitePact dashboard (Settings → API Keys) after creating a free org.",
      "placeholder": "Bearer <your-api-key>"
    }
  ]
}
