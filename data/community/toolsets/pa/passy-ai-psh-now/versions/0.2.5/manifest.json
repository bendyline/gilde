{
  "schemaVersion": 1,
  "version": "0.2.5",
  "releasedAt": "2026-11-10T18:04:07.437089Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://psh.now/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <psh_agent_",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <psh_agent_... key>. Create one with `psh status` or at https://psh.now/app. `x-psh-key: <key>` is accepted too."
    }
  ]
}
