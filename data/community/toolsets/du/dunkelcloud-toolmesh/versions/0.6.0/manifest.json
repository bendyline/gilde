{
  "schemaVersion": 1,
  "version": "0.6.0",
  "releasedAt": "2026-11-10T19:11:46.819227Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{host}:8123/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token: ToolMesh API key or OAuth access token",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer token: ToolMesh API key or OAuth access token. ToolMesh rejects every request without credentials."
    }
  ]
}
