{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-09-30T20:35:53.890104Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://needtofind.app/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token. Create a free account at needtofind.app, then make a token on your profile page and enter it as: Bearer YOUR_TOKEN"
    }
  ]
}
