  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.getautomata.app/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Connector token minted for one connection at mcp",
