{
  "schemaVersion": 1,
  "version": "1.0.2",
  "releasedAt": "2026-11-09T09:03:28.591502Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.jobzero.app/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer API token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer API token. Create one under Agents at https://www.jobzero.app/agents",
      "default": "Bearer {token}"
    }
  ]
}
