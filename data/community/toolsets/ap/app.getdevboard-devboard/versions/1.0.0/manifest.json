{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-10T20:24:31.547859Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.getdevboard.app/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <token>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <token>. Make the token in the devBoard Mac app under Settings → Developer."
    }
  ]
}
