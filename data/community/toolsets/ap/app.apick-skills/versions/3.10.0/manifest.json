{
  "schemaVersion": 1,
  "version": "3.10.0",
  "releasedAt": "2026-10-04T11:50:25.74418Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://apick.app/mcp/skills",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <APICK license key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <APICK license key>. Get a key at https://apick.app. Running a Skill requires an account with at least one payment."
    }
  ]
}
