{
  "schemaVersion": 1,
  "version": "1.1.0",
  "releasedAt": "2026-09-29T22:41:50.940625Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://hunchsheet.app/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token: \"Bearer hunch_<40 hex characters>\"",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token: \"Bearer hunch_<40 hex characters>\". Get a free key (100 rows) at https://hunchsheet.app."
    }
  ]
}
