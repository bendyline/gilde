{
  "schemaVersion": 1,
  "version": "0.1.17",
  "releasedAt": "2026-06-10T17:20:11.519612Z",
  "runtime": {
    "kind": "npm-package",
    "package": "ews-meeting-mcp",
    "version": "0.1.17",
    "sha256": "b81774d8bfa9456c57a80ece5e21e8cb40b5c2419f4582ba4a9fd0baffad3124",
    "entry": "bin/ews-meeting-agent.js",
    "args": [],
    "envHints": [
      "EWS_ENDPOINT",
      "EWS_EMAIL",
      "EWS_USERNAME",
      "EWS_PASSWORD",
      "EWS_PASSWORD_KEYCHAIN_SERVICE",
      "EWS_PASSWORD_KEYCHAIN_ACCOUNT",
      "EWS_AUTH_TYPE",
      "EWS_TIMEZONE"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "EWS_ENDPOINT",
      "envVar": "EWS_ENDPOINT",
      "label": "Exchange EWS endpoint, for example https://mail",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Exchange EWS endpoint, for example https://mail.company.com/EWS/Exchange.asmx"
    },
    {
      "id": "EWS_EMAIL",
      "envVar": "EWS_EMAIL",
      "label": "Mailbox email address used as the meeting organizer",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Mailbox email address used as the meeting organizer."
    },
    {
      "id": "EWS_USERNAME",
      "envVar": "EWS_USERNAME",
      "label": "Exchange login username, often DOMAIN\\username for NTLM",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Exchange login username, often DOMAIN\\username for NTLM."
    },
    {
      "id": "EWS_PASSWORD",
      "envVar": "EWS_PASSWORD",
      "label": "Exchange password",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Exchange password. Prefer macOS Keychain variables when possible."
    },
    {
      "id": "EWS_PASSWORD_KEYCHAIN_SERVICE",
      "envVar": "EWS_PASSWORD_KEYCHAIN_SERVICE",
      "label": "Optional macOS Keychain service name for reading the password locally",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional macOS Keychain service name for reading the password locally."
    },
    {
      "id": "EWS_PASSWORD_KEYCHAIN_ACCOUNT",
      "envVar": "EWS_PASSWORD_KEYCHAIN_ACCOUNT",
      "label": "Optional macOS Keychain account",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional macOS Keychain account. Defaults to EWS_USERNAME when omitted."
    },
    {
      "id": "EWS_AUTH_TYPE",
      "envVar": "EWS_AUTH_TYPE",
      "label": "Exchange auth type",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Exchange auth type. Usually NTLM for on-prem Exchange.",
      "default": "NTLM"
    },
    {
      "id": "EWS_TIMEZONE",
      "envVar": "EWS_TIMEZONE",
      "label": "IANA timezone for calendar operations",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "IANA timezone for calendar operations.",
      "default": "Asia/Taipei"
    }
  ]
}
