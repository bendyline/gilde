{
  "schemaVersion": 1,
  "version": "1.1.0",
  "releasedAt": "2026-10-17T06:51:04.16135Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://appie.run/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token with your Appie",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token with your Appie.run project API key, e.g. 'Bearer YOUR_APPIE_API_KEY'"
    }
  ]
}
