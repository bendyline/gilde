{
  "schemaVersion": 1,
  "version": "1.1.2",
  "releasedAt": "2026-09-07T17:04:13.632448Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.solucortex.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization",
      "X-Solucortex-Project"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <your SoluCortex project API key (scx_",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <your SoluCortex project API key (scx_...)>. Get one at https://solucortex.ai."
    },
    {
      "id": "X-Solucortex-Project",
      "envVar": "X-Solucortex-Project",
      "label": "Default project UUID",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Default project UUID. Optional: the backend infers it from the API key."
    }
  ]
}
