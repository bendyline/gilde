{
  "schemaVersion": 1,
  "version": "0.1.1",
  "releasedAt": "2026-07-21T18:13:57.053394Z",
  "runtime": {
    "kind": "npm-package",
    "package": "arcbounty-mcp",
    "version": "0.1.1",
    "sha256": "4feb0a9f7fe4fae63d94c5677df2b141a3efc797670c567ad5b3ff6d8609f3c5",
    "entry": "dist/index.js",
    "args": [],
    "envHints": [
      "BOUNTY_ADAPTER_ADDRESS",
      "ARC_RPC_URL",
      "AGENT_PRIVATE_KEY",
      "CIRCLE_API_KEY",
      "ENTITY_SECRET",
      "CIRCLE_WALLET_ID",
      "CIRCLE_WALLET_ADDRESS"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "BOUNTY_ADAPTER_ADDRESS",
      "envVar": "BOUNTY_ADAPTER_ADDRESS",
      "label": "BountyAdapter contract address (required either way)",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "BountyAdapter contract address (required either way). Canonical address: contracts/DEPLOYMENTS.md in the repo."
    },
    {
      "id": "ARC_RPC_URL",
      "envVar": "ARC_RPC_URL",
      "label": "Arc Testnet RPC URL",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Arc Testnet RPC URL. Defaults to the public endpoint if unset."
    },
    {
      "id": "AGENT_PRIVATE_KEY",
      "envVar": "AGENT_PRIVATE_KEY",
      "label": "Raw private key of the agent wallet",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Raw private key of the agent wallet. Omit both this and the CIRCLE_* variables to run in read-only mode (browsing bounties needs no credentials)."
    },
    {
      "id": "CIRCLE_API_KEY",
      "envVar": "CIRCLE_API_KEY",
      "label": "Circle Developer-Controlled Wallet API key — alternative to AGENT_PRIVATE_KEY, no raw key in this process",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Circle Developer-Controlled Wallet API key — alternative to AGENT_PRIVATE_KEY, no raw key in this process."
    },
    {
      "id": "ENTITY_SECRET",
      "envVar": "ENTITY_SECRET",
      "label": "Circle Developer-Controlled Wallet entity secret",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Circle Developer-Controlled Wallet entity secret."
    },
    {
      "id": "CIRCLE_WALLET_ID",
      "envVar": "CIRCLE_WALLET_ID",
      "label": "Circle Developer-Controlled Wallet ID",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Circle Developer-Controlled Wallet ID."
    },
    {
      "id": "CIRCLE_WALLET_ADDRESS",
      "envVar": "CIRCLE_WALLET_ADDRESS",
      "label": "Circle Developer-Controlled Wallet address",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Circle Developer-Controlled Wallet address."
    }
  ]
