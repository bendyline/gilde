{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-08-11T11:10:45.88799Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{host}/mcp-health",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "MCP authentication token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "MCP authentication token. Set MCP_TOKEN in .env, generate with: openssl rand -hex 32. Include 'Bearer ' prefix."
    }
  ]
}
