{
  "schemaVersion": 1,
  "version": "0.1.1",
  "releasedAt": "2026-11-01T21:44:37.831879Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://spotify-proxy.checkleaked.cc/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer followed by your API key from https://spotify",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer followed by your API key from https://spotify.checkleaked.cc/pricing (a free trial key works)."
    }
  ]
}
