{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-11-10T17:53:39.448056Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.kreatix.cc/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your Kreatix agent key as a Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your Kreatix agent key as a Bearer token. Create one at https://kreatix.cc/settings/agent",
      "default": "Bearer {kreatix_key}"
    }
  ]
}
