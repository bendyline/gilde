{
  "schemaVersion": 1,
  "version": "0.12.1",
  "releasedAt": "2026-11-14T16:09:09.174511Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{dove_host}/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Client token from `dove clients create`",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Client token from `dove clients create`. Leave empty to sign in through Dove's OAuth approval page instead.",
      "default": "Bearer {dove_token}"
    }
  ]
}
