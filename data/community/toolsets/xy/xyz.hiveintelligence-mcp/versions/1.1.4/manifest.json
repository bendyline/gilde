  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.hiveintelligence.xyz/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Hive API key as a Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Hive API key as a Bearer token.",
      "placeholder": "Bearer hive_your_api_key"
    }
  ]
}
