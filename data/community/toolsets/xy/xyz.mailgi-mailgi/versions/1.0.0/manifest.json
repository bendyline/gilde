  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.mailgi.xyz/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <agent API key>",
      "type": "string",
