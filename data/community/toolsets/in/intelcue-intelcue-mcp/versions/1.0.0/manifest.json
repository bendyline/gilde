{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-06-30T21:30:55.820806Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.intelcue.ai/v1/mcp/sse",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "x-api-key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-api-key",
      "envVar": "x-api-key",
