{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-26T13:38:17.918323Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://hirelog.dev/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <key> from https://hirelog",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer <key> from https://hirelog.dev/keys (needed for writes; reads work without it)"
    }
  ]
}
