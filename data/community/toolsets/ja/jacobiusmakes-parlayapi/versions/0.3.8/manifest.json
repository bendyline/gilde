  "runtime": {
    "kind": "http-mcp",
    "url": "https://parlay-api.com/mcp/http",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <your ParlayAPI key>",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer <your ParlayAPI key>. Optional for public discovery and pricing; use your own key for account data and full odds access."
    }
  ]
