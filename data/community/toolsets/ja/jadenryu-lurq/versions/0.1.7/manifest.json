{
  "schemaVersion": 1,
  "version": "0.1.7",
  "releasedAt": "2026-09-13T22:09:00.494421Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.lurq.run/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <your lurq API key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <your lurq API key>. Free keys at https://www.lurq.run/dashboard/keys"
    }
  ]
}
