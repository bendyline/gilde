      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer token for M2M authentication. Mutually exclusive with REPORTIA_COOKIE; either can be paired with REPORTIA_EMAIL+REPORTIA_PASSWORD (session login) for cookie fallback."
    },
    {
      "id": "REPORTIA_COOKIE",
