{
  "schemaVersion": 1,
  "version": "0.54.0",
  "releasedAt": "2026-09-14T19:53:00.33069Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@buildinternet/uploads",
    "version": "0.54.0",
    "sha256": "be7cee35f24804b898e96e06e4e538ade1f1533d25524e09864fe0176ef1d462",
    "entry": "bin/uploads.js",
    "args": [
      "mcp"
    ],
    "envHints": [
      "UPLOADS_TOKEN",
      "UPLOADS_WORKSPACE",
      "UPLOADS_API_URL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "UPLOADS_TOKEN",
      "envVar": "UPLOADS_TOKEN",
      "label": "Workspace bearer token (up_<workspace>_…)",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Workspace bearer token (up_<workspace>_…). Mint with uploads login."
    },
    {
      "id": "UPLOADS_WORKSPACE",
      "envVar": "UPLOADS_WORKSPACE",
      "label": "Workspace name",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Workspace name. Inferred from the token when omitted."
    },
    {
      "id": "UPLOADS_API_URL",
      "envVar": "UPLOADS_API_URL",
      "label": "API origin",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "API origin. Defaults to https://api.uploads.sh.",
      "default": "https://api.uploads.sh"
    },
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer workspace token (up_<workspace>_…) or OAuth access token",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer workspace token (up_<workspace>_…) or OAuth access token. Omit this header to use the OAuth browser flow."
    }
  ]
}
