{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-11-04T23:51:34.879877Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{sandbox_host}/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "A scoped bearer token issued by your own Headmesh sandbox",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "A scoped bearer token issued by your own Headmesh sandbox",
      "default": "Bearer {sandbox_token}"
    }
  ]
}
