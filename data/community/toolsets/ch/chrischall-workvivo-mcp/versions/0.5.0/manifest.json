      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Where linked documents are saved (default ~/Downloads/workvivo-mcp)."
    },
    {
      "id": "WORKVIVO_MAX_DOWNLOAD_MB",
      "envVar": "WORKVIVO_MAX_DOWNLOAD_MB",
