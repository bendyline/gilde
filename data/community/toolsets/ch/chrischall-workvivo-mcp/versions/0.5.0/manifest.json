      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Documents larger than this are skipped, not downloaded (default 50)."
    },
    {
      "id": "WORKVIVO_SKIP_FILE_TYPES",
      "envVar": "WORKVIVO_SKIP_FILE_TYPES",
      "label": "Comma-separated extensions or MIME types never downloaded, e",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Comma-separated extensions or MIME types never downloaded, e.g. mp4,.mov,video/* (default video/*,audio/*; none = skip nothing)."
