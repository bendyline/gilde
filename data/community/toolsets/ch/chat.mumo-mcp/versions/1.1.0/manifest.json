{
  "schemaVersion": 1,
  "version": "1.1.0",
  "releasedAt": "2026-09-08T19:12:05.384677Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mumo.chat/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "mumo platform API key as a bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "mumo platform API key as a bearer token. Create one at https://mumo.chat/settings/api-keys (keys begin with mmo_live_).",
      "default": "Bearer {MUMO_API_KEY}"
    }
  ]
}
