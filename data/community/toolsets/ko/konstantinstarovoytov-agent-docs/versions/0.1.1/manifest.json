{
  "schemaVersion": 1,
  "version": "0.1.1",
  "releasedAt": "2026-10-15T08:28:03.880144Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://agent-docs-mcp.onrender.com/mcp/",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "X-Cohere-Api-Key",
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-Cohere-Api-Key",
      "envVar": "X-Cohere-Api-Key",
      "label": "Your own Cohere API key (free trial at dashboard",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Your own Cohere API key (free trial at dashboard.cohere.com). Provide this or Authorization."
    },
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token from the owner",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer token from the owner. Provide this or X-Cohere-Api-Key.",
      "default": "Bearer {token}"
    }
  ]
}
