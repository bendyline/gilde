{
  "schemaVersion": 1,
  "version": "0.114.0",
  "releasedAt": "2026-11-13T02:37:40.385528Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://agent-bom-mcp.up.railway.app/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Without it, only the read-only lookup tools (check, intel_lookup) answer. A deployment bearer token unlocks the rest."
    }
  ]
}
