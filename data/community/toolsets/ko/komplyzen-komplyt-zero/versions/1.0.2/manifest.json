{
  "schemaVersion": 1,
  "version": "1.0.2",
  "releasedAt": "2026-10-22T19:23:41.465286Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@komplyzen/komplyt-zero",
    "version": "1.0.2",
    "sha256": "537ba8c485fd619a18736da0c7e662a5b758046c0bba386bd0285011b2f626e1",
    "entry": "dist/bin/kg.js",
    "args": [
      "mcp"
    ],
    "envHints": [
      "KG_AUTH_MODE",
      "KG_DB_URL",
      "KG_DB_USER",
      "KG_DB_PASS",
      "KG_JWT_SECRET",
      "EMBEDDING_PROVIDER",
      "EMBEDDING_BASE_URL",
      "EMBEDDING_API_KEY"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "KG_AUTH_MODE",
      "envVar": "KG_AUTH_MODE",
      "label": "Self-hosted use: one fixed local user, no login",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Self-hosted use: one fixed local user, no login.",
      "default": "local"
    },
    {
      "id": "KG_DB_URL",
      "envVar": "KG_DB_URL",
      "label": "SurrealDB WebSocket URL, e",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "SurrealDB WebSocket URL, e.g. ws://127.0.0.1:8000. See docs/self-hosting.md for a compose file that starts SurrealDB."
    },
    {
      "id": "KG_DB_USER",
      "envVar": "KG_DB_USER",
      "label": "SurrealDB username",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "SurrealDB username."
    },
    {
      "id": "KG_DB_PASS",
      "envVar": "KG_DB_PASS",
      "label": "SurrealDB password",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "SurrealDB password."
    },
    {
      "id": "KG_JWT_SECRET",
      "envVar": "KG_JWT_SECRET",
      "label": "Server secret for the kg_server SurrealDB signin, at least 32 characters",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Server secret for the kg_server SurrealDB signin, at least 32 characters."
    },
    {
      "id": "EMBEDDING_PROVIDER",
      "envVar": "EMBEDDING_PROVIDER",
      "label": "cohere or ollama",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "cohere or ollama. One per install.",
      "default": "ollama",
      "options": [
        "ollama",
        "cohere"
      ]
    },
    {
      "id": "EMBEDDING_BASE_URL",
      "envVar": "EMBEDDING_BASE_URL",
      "label": "Ollama base URL, e",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Ollama base URL, e.g. http://127.0.0.1:11434 (required for ollama)."
    },
    {
      "id": "EMBEDDING_API_KEY",
      "envVar": "EMBEDDING_API_KEY",
      "label": "API key when the provider needs one (cohere)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "API key when the provider needs one (cohere)."
    }
  ]
}
