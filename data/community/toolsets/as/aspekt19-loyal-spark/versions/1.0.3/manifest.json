{
  "schemaVersion": 1,
  "version": "1.0.3",
  "releasedAt": "2026-08-31T19:59:32.432167Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.loyalspark.online/loyalty-mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "x-api-key",
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-api-key",
      "envVar": "x-api-key",
      "label": "Merchant agent API key (lsk_",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Merchant agent API key (lsk_...). Get at loyalspark.online/for-agents or SIWE."
    },
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Alternative auth: Bearer lsk_",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Alternative auth: Bearer lsk_... (same key as x-api-key).",
      "placeholder": "Bearer lsk_..."
    }
  ]
}
