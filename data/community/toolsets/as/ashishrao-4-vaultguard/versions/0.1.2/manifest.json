{
  "schemaVersion": 1,
  "version": "0.1.2",
  "releasedAt": "2026-09-18T16:07:00.645281Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@ashishrao-4/vaultguard",
    "version": "0.1.2",
    "sha256": "5f3a6d0edf3c7fd6ae50aa868dfdba7ba967d6ef5b0ded73900e39e760b74512",
    "entry": "bin/vaultguard.mjs",
    "args": [
      "mcp",
      "start"
    ],
    "envHints": [
      "VAULTGUARD_PASSPHRASE",
      "VAULTGUARD_VAULT_PATH",
      "VAULTGUARD_HOME",
      "VAULTGUARD_ALLOW_GET_SECRET"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "VAULTGUARD_PASSPHRASE",
      "envVar": "VAULTGUARD_PASSPHRASE",
      "label": "Passphrase that decrypts the encrypted secret blocks in your Obsidian vault",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Passphrase that decrypts the encrypted secret blocks in your Obsidian vault."
    },
    {
      "id": "VAULTGUARD_VAULT_PATH",
      "envVar": "VAULTGUARD_VAULT_PATH",
      "label": "Path to your Obsidian vault (overrides the one in ~/",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Path to your Obsidian vault (overrides the one in ~/.vaultguard/config.json)."
    },
    {
      "id": "VAULTGUARD_HOME",
      "envVar": "VAULTGUARD_HOME",
      "label": "Config directory (defaults to ~/",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Config directory (defaults to ~/.vaultguard)."
    },
    {
      "id": "VAULTGUARD_ALLOW_GET_SECRET",
      "envVar": "VAULTGUARD_ALLOW_GET_SECRET",
      "label": "Set to 1 to enable get_secret (default: disabled so values never reach the agent)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Set to 1 to enable get_secret (default: disabled so values never reach the agent)."
    }
  ]
}
