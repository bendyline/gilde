    {
      "id": "VK_ADS_TOKEN",
      "envVar": "VK_ADS_TOKEN",
      "label": "VK Ads OAuth2 access token (Bearer) — full account access",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "VK Ads OAuth2 access token (Bearer) — full account access. Treat it as a secret."
    },
    {
      "id": "VK_ADS_LANG",
      "envVar": "VK_ADS_LANG",
      "label": "Language for API responses (Accept-Language header), e",
