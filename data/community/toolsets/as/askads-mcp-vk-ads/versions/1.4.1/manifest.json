      "default": "60000"
    },
    {
      "id": "VK_ADS_MAX_RETRIES",
      "envVar": "VK_ADS_MAX_RETRIES",
      "label": "Max retries for transient errors (429 rate limit, 5xx on GET, network errors on GET)",
