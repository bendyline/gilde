      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Language for API responses (Accept-Language header), e.g. ru, en.",
      "default": "ru"
    },
    {
      "id": "VK_ADS_TIMEOUT_MS",
      "envVar": "VK_ADS_TIMEOUT_MS",
      "label": "Per-request timeout in milliseconds",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
