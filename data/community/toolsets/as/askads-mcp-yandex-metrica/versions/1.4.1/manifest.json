  "tools": [],
  "config": [
    {
      "id": "YANDEX_METRIKA_TOKEN",
      "envVar": "YANDEX_METRIKA_TOKEN",
      "label": "Yandex Metrica OAuth token (scope metrika:read) — read access to analytics data",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Yandex Metrica OAuth token (scope metrika:read) — read access to analytics data. Treat it as a secret. Optional: without it the server starts anyway and connects through the in-chat login (start_login / finish_login)."
    },
    {
      "id": "YANDEX_METRIKA_OAUTH_CLIENT_ID",
      "envVar": "YANDEX_METRIKA_OAUTH_CLIENT_ID",
      "label": "ClientID of your own Yandex OAuth app for the in-chat login",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "ClientID of your own Yandex OAuth app for the in-chat login. Defaults to the Ask Ads app scoped to metrika:read."
    },
    {
      "id": "YANDEX_METRIKA_COUNTER_ID",
      "envVar": "YANDEX_METRIKA_COUNTER_ID",
      "label": "Default Metrica counter id, used when a tool call omits counterId",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Default Metrica counter id, used when a tool call omits counterId."
    },
    {
      "id": "YANDEX_METRIKA_LANG",
      "envVar": "YANDEX_METRIKA_LANG",
      "label": "Language for API responses (ru, en,",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Language for API responses (ru, en, ...).",
      "default": "ru"
    },
    {
      "id": "YANDEX_METRIKA_API_BASE",
      "envVar": "YANDEX_METRIKA_API_BASE",
      "label": "API root host",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "API root host. Override only for a proxy or a non-default endpoint.",
      "default": "https://api-metrika.yandex.net"
    },
    {
      "id": "YANDEX_METRIKA_TIMEOUT_MS",
      "envVar": "YANDEX_METRIKA_TIMEOUT_MS",
      "label": "Per-request timeout in milliseconds",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Per-request timeout in milliseconds.",
      "default": "60000"
    },
    {
      "id": "YANDEX_METRIKA_MAX_RETRIES",
      "envVar": "YANDEX_METRIKA_MAX_RETRIES",
      "label": "Max retries for transient errors (429 rate limit, 5xx on reads)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Max retries for transient errors (429 rate limit, 5xx on reads).",
      "default": "3"
    }
  ]
