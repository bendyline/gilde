  "runtime": {
    "kind": "http-mcp",
    "url": "https://gen.pollinations.ai/mcp/exa",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Pollinations API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Pollinations API key. Get one at https://enter.pollinations.ai/keys.",
      "default": "Bearer {api_key}"
    }
  ]
