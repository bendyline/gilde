{
  "schemaVersion": 1,
  "version": "1.1.1",
  "releasedAt": "2026-10-06T14:23:31.784398Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.apify.com/?tools=automationnation/data-tools-mcp-server",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your Apify API token, sent as 'Bearer <token>'",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your Apify API token, sent as 'Bearer <token>'. Get it at https://console.apify.com/settings/integrations (free account).",
      "default": "Bearer {apify_token}"
    }
  ]
}
