{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-06-23T12:10:05.637497Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.rendley.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Provide your Rendley API key, or skip it if your client supports OAuth",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Provide your Rendley API key, or skip it if your client supports OAuth.",
      "default": "Bearer {rendley_api_key}"
    }
  ]
}
