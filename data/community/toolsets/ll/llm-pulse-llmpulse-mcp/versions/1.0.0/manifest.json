{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-07-06T08:25:08.15078Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.llmpulse.ai/api/v1/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token from an LLM Pulse API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token from an LLM Pulse API key. API keys are available on Scale plans and above.",
      "placeholder": "Bearer llmpulse_your_key_here"
    }
  ]
}
