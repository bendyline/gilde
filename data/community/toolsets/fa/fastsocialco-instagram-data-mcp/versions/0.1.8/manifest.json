      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Without it your client signs you in with OAuth. With it, your Instagram Data API key (https://fastsocial.co/instagram-api?ref=mcp-registry)."
    }
  ]
