  "runtime": {
    "kind": "http-mcp",
    "url": "https://data.fastsocial.co/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-API-Key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-API-Key",
      "envVar": "X-API-Key",
