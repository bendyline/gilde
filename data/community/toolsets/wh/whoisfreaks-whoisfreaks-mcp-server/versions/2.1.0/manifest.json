{
  "schemaVersion": 1,
  "version": "2.1.0",
  "releasedAt": "2026-11-13T17:55:28.871148Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.whoisfreaks.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your WhoisFreaks API key as a bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your WhoisFreaks API key as a bearer token. Get one free at https://billing.whoisfreaks.com/signup",
      "default": "Bearer {api_key}"
    }
  ]
}
