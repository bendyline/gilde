{
  "schemaVersion": 1,
  "version": "0.7.3",
  "releasedAt": "2026-11-13T16:44:47.992037Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@jclvsh/xmark",
    "version": "0.7.3",
    "sha256": "5e9aed0950bf2e21c60ac4bd29a2ee826f4169c3fe3898f01914dfef3c2d3bcd",
    "entry": "dist/cli.js",
    "args": [
      "xmark-mcp"
    ],
    "envHints": [
      "XMARK_API_KEY",
      "XMARK_API_URL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "XMARK_API_KEY",
      "envVar": "XMARK_API_KEY",
      "label": "Your xmark API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your xmark API key."
    },
    {
      "id": "XMARK_API_URL",
      "envVar": "XMARK_API_URL",
      "label": "Override the API host",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Override the API host.",
      "default": "https://api.xmark.dev"
    },
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "xmark API key, sent as a Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "xmark API key, sent as a Bearer token. Its scopes apply.",
      "default": "Bearer {api_key}"
    }
  ]
}
