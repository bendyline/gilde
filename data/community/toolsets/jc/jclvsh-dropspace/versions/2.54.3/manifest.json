  "tools": [],
  "config": [
    {
      "id": "DROPSPACE_API_KEY",
      "envVar": "DROPSPACE_API_KEY",
      "label": "Your Dropspace API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your Dropspace API key."
    },
    {
      "id": "DROPSPACE_API_URL",
      "envVar": "DROPSPACE_API_URL",
      "label": "Override the API host",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Override the API host.",
      "default": "https://api.dropspace.dev"
    },
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Dropspace API key, sent as a Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Dropspace API key, sent as a Bearer token. Its scopes apply.",
      "default": "Bearer {api_key}"
    }
