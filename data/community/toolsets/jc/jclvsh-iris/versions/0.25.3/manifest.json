{
  "schemaVersion": 1,
  "version": "0.25.3",
  "releasedAt": "2026-11-13T16:45:03.942344Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@jclvsh/iris",
    "version": "0.25.3",
    "sha256": "14e4390b84da513055015ee51858b91452fd4a9d0427fa9348cfdfdd313e6c26",
    "entry": "dist/cli.js",
    "args": [
      "iris-mcp"
    ],
    "envHints": [
      "IRIS_API_KEY",
      "IRIS_API_URL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "IRIS_API_KEY",
      "envVar": "IRIS_API_KEY",
      "label": "Your Iris API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your Iris API key."
    },
    {
      "id": "IRIS_API_URL",
      "envVar": "IRIS_API_URL",
      "label": "Override the API host",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Override the API host.",
      "default": "https://api.iris-ai.dev"
    },
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Iris API key, sent as a Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Iris API key, sent as a Bearer token. Its scopes apply.",
      "default": "Bearer {api_key}"
    }
  ]
}
