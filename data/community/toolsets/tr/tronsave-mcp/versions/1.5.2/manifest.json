{
  "schemaVersion": 1,
  "version": "1.5.2",
  "releasedAt": "2026-11-13T11:37:39.829303Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.tronsave.io/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. `ApiKey <your TronSave API key>` unlocks internal-balance tools. Without it, public tools work and the agent can log in with `tronsave_login`."
    }
  ]
}
