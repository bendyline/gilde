{
  "schemaVersion": 1,
  "version": "0.1.2",
  "releasedAt": "2026-04-18T07:31:54.385957Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.pinelabs.com/mcp",
    "authHint": "none",
    "envHints": [
      "X-Client-Id",
      "X-Client-Secret"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-Client-Id",
      "envVar": "X-Client-Id",
      "label": "Pine Labs Client ID from your merchant dashboard",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Pine Labs Client ID from your merchant dashboard"
    },
    {
      "id": "X-Client-Secret",
      "envVar": "X-Client-Secret",
      "label": "Pine Labs Client Secret from your merchant dashboard",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Pine Labs Client Secret from your merchant dashboard"
    }
  ]
}
