{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-10-23T16:52:04.968298Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.mlpvector.club/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your MLP Vector Club API key, created in the API keys section of your account page",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Your MLP Vector Club API key, created in the API keys section of your account page",
      "default": "Bearer {api_key}"
    }
  ]
}
