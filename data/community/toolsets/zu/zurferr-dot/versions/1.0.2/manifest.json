{
  "schemaVersion": 1,
  "version": "1.0.2",
  "releasedAt": "2026-10-17T16:13:23.689076Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://app.getdot.ai/ai/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-API-KEY"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-API-KEY",
      "envVar": "X-API-KEY",
      "label": "Dot MCP token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Dot MCP token. In Dot: Profile > Use Dot elsewhere > MCP > Client can't do OAuth? Use an API token > Generate token."
    }
  ]
}
