{
  "schemaVersion": 1,
  "version": "1.1.1",
  "releasedAt": "2026-11-14T02:52:12.547183Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.perigon.io/v1/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "OAuth access token from Perigon sign-in (recommended) or a Perigon API key as Bearer token",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "OAuth access token from Perigon sign-in (recommended) or a Perigon API key as Bearer token",
      "default": "Bearer {token}"
    }
  ]
}
