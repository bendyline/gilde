{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-09-24T16:35:09.93867Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.perigon.io/v1/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Perigon API key, sent as a Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Perigon API key, sent as a Bearer token",
      "default": "Bearer {api_key}"
    }
  ]
}
