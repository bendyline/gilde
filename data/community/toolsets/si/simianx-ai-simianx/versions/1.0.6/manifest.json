{
  "schemaVersion": 1,
  "version": "1.0.6",
  "releasedAt": "2026-10-23T06:43:53.462022Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://service.simianx.ai/v1/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your SimianX API key as a bearer token (My Account → API keys on simianx",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your SimianX API key as a bearer token (My Account → API keys on simianx.ai)",
      "default": "Bearer {api_key}"
    }
  ]
}
