  "tools": [],
  "config": [
    {
      "id": "RAYWAKE_API_KEY",
      "envVar": "RAYWAKE_API_KEY",
      "label": "Raywake API key from https://raywake",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Raywake API key from https://raywake.si/api-keys"
    },
    {
      "id": "RAYWAKE_API_BASE",
      "envVar": "RAYWAKE_API_BASE",
      "label": "Optional API base URL override",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional API base URL override",
      "default": "https://api.raywake.com"
    },
    {
      "id": "RAYWAKE_UPLOAD_ROOTS",
      "envVar": "RAYWAKE_UPLOAD_ROOTS",
      "label": "Optional folders upload_file may read, separated by ':' (';' on Windows)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional folders upload_file may read, separated by ':' (';' on Windows). Replaces the default: the home folder and the working folder. Hidden folders are never read."
    }
  ]
