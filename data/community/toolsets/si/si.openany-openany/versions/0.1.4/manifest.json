{
  "schemaVersion": 1,
  "version": "0.1.4",
  "releasedAt": "2026-11-14T04:27:59.569966Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.openany.si",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "OpenAny API key as Bearer token",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "OpenAny API key as Bearer token. Optional for browsing; required for run_api.",
      "default": "Bearer {OPENANY_API_KEY}"
    }
  ]
}
