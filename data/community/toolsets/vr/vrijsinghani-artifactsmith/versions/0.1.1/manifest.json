{
  "schemaVersion": 1,
  "version": "0.1.1",
  "releasedAt": "2026-10-17T08:53:02.329247Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://artifactsmith.neuralami.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token from https://artifactsmith",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token from https://artifactsmith.neuralami.ai/try, or from your own install (artifactsmith token add).",
      "default": "Bearer {token}"
    }
  ]
}
