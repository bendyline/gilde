{
  "schemaVersion": 1,
  "version": "2.0.0",
  "releasedAt": "2026-11-04T16:50:15.713372Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.youtubetranscript.dev",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "API key in Bearer format: Bearer <key> (from youtubetranscript",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "API key in Bearer format: Bearer <key> (from youtubetranscript.dev). OAuth clients can omit this and sign in instead."
    }
  ]
}
