      "required": false,
      "multiline": false,
      "description": "GraphQL endpoint override (defaults to https://hashlock.markets/api/graphql).",
      "default": "https://hashlock.markets/api/graphql"
    },
    {
      "id": "Authorization",
      "envVar": "Authorization",
