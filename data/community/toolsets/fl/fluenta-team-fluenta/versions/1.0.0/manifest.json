{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-09-12T14:31:43.51675Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://fluenta.space/backend/api/v1/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <Fluenta API key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <Fluenta API key>. Create one under Settings > API keys at https://fluenta.space/app/settings/api-keys"
    }
  ]
}
