{
  "schemaVersion": 1,
  "version": "0.2.0",
  "releasedAt": "2026-11-10T17:52:17.450792Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://agentring.io/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your agentring API key, from the dashboard at https://agentring",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your agentring API key, from the dashboard at https://agentring.io after you pair your phone.",
      "default": "Bearer {api_key}"
    }
  ]
}
