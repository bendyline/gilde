  "tools": [],
  "config": [
    {
      "id": "VRCHAT_MCP_CONFIG_FILE",
      "envVar": "VRCHAT_MCP_CONFIG_FILE",
      "label": "Path to a JSON config file for settings not supplied through environment variables",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Path to a JSON config file for settings not supplied through environment variables."
    },
    {
      "id": "VRCHAT_MCP_USER_AGENT",
      "envVar": "VRCHAT_MCP_USER_AGENT",
      "label": "Descriptive User-Agent for VRChat API requests",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Descriptive User-Agent for VRChat API requests."
    },
    {
      "id": "VRCHAT_MCP_LOG_LEVEL",
      "envVar": "VRCHAT_MCP_LOG_LEVEL",
      "label": "Log level for stderr diagnostics",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Log level for stderr diagnostics.",
      "default": "info",
      "options": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    {
      "id": "VRCHAT_MCP_COOKIE_STORE",
      "envVar": "VRCHAT_MCP_COOKIE_STORE",
      "label": "Cookie storage backend for VRChat authentication",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Cookie storage backend for VRChat authentication. The keychain mode falls back to file storage if the OS keychain is unavailable.",
      "default": "keychain",
      "options": [
        "memory",
        "file",
        "keychain"
      ]
    },
    {
      "id": "VRCHAT_MCP_COOKIE_FILE",
      "envVar": "VRCHAT_MCP_COOKIE_FILE",
      "label": "Cookie file path used when VRCHAT_MCP_COOKIE_STORE is file",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Cookie file path used when VRCHAT_MCP_COOKIE_STORE is file."
    },
    {
      "id": "VRCHAT_MCP_ALLOW_WRITES",
      "envVar": "VRCHAT_MCP_ALLOW_WRITES",
      "label": "Allow non-GET VRChat API write operations",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Allow non-GET VRChat API write operations. Defaults to true for local full-capability use; set to false for read-only mode.",
      "default": "true"
