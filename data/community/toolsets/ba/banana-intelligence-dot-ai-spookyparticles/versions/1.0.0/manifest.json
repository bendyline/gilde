{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-11-15T23:01:38.35003Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://spookyparticles.com/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer API key made at https://spookyparticles",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer API key made at https://spookyparticles.com/app/connections. A read key runs read tools; a write key adds write tools.",
      "default": "Bearer {api_key}"
    }
  ]
}
