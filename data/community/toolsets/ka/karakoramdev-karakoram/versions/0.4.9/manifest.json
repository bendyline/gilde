{
  "schemaVersion": 1,
  "version": "0.4.9",
  "releasedAt": "2026-11-12T14:48:10.113485Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{control_plane_host}/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Karakoram API token; `karactl mcp config` mints a restricted, read-only one",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Karakoram API token; `karactl mcp config` mints a restricted, read-only one",
      "default": "Bearer {api_token}"
    }
  ]
}
