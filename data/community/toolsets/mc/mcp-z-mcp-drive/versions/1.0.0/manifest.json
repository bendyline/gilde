{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2025-12-29T08:28:40.506179Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@mcp-z/mcp-drive",
    "version": "1.0.0",
    "sha256": "dd9cda272d813835424615ba1c45a8fcfd907765935fde5b763b74962ef58d00",
    "entry": "bin/server.js",
    "args": [
      "--auth",
      "--headless",
      "--redirect-uri",
      "--service-account-key-file",
      "--storage-dir",
      "--base-url",
      "--log-level"
    ],
    "envHints": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "GOOGLE_SERVICE_ACCOUNT_KEY_FILE",
      "AUTH_MODE",
      "HEADLESS",
      "REDIRECT_URI",
      "STORAGE_DIR",
      "PORT",
      "BASE_URL",
      "LOG_LEVEL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "GOOGLE_CLIENT_ID",
      "envVar": "GOOGLE_CLIENT_ID",
      "label": "Google OAuth client ID (required for OAuth authentication modes)",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Google OAuth client ID (required for OAuth authentication modes)",
      "placeholder": "123456789-abcdefghijk.apps.googleusercontent.com"
    },
    {
      "id": "GOOGLE_CLIENT_SECRET",
      "envVar": "GOOGLE_CLIENT_SECRET",
      "label": "Google OAuth client secret (optional for public clients)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Google OAuth client secret (optional for public clients)",
      "placeholder": "GOCSPX-abcdefghijklmnop"
    },
    {
      "id": "GOOGLE_SERVICE_ACCOUNT_KEY_FILE",
      "envVar": "GOOGLE_SERVICE_ACCOUNT_KEY_FILE",
      "label": "Path to service account JSON key file (required for service-account auth mode)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Path to service account JSON key file (required for service-account auth mode)",
      "placeholder": "/path/to/service-account-key.json"
    },
    {
      "id": "AUTH_MODE",
      "envVar": "AUTH_MODE",
      "label": "Authentication mode",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Authentication mode",
      "default": "loopback-oauth",
      "placeholder": "loopback-oauth",
      "options": ["loopback-oauth", "service-account"]
    },
    {
      "id": "HEADLESS",
      "envVar": "HEADLESS",
      "label": "Disable browser auto-open, return auth URL instead (true/false)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Disable browser auto-open, return auth URL instead (true/false)",
      "default": "false",
      "placeholder": "false"
    },
    {
      "id": "REDIRECT_URI",
      "envVar": "REDIRECT_URI",
      "label": "OAuth redirect URI (optional, default: ephemeral loopback)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "OAuth redirect URI (optional, default: ephemeral loopback)",
      "placeholder": "http://localhost:{PORT}/oauth/callback"
    },
    {
      "id": "STORAGE_DIR",
      "envVar": "STORAGE_DIR",
      "label": "Directory for storing exported files",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Directory for storing exported files",
      "default": "~/.mcp-z/mcp-drive/files",
      "placeholder": "~/.mcp-z/mcp-drive/files"
    },
    {
      "id": "PORT",
      "envVar": "PORT",
      "label": "HTTP server port (overrides --port)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "HTTP server port (overrides --port)",
      "placeholder": "3000"
    },
    {
      "id": "BASE_URL",
      "envVar": "BASE_URL",
      "label": "Base URL for HTTP file serving (optional, used for HTTP transport)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Base URL for HTTP file serving (optional, used for HTTP transport)",
      "placeholder": "http://localhost:{PORT}"
    },
    {
      "id": "LOG_LEVEL",
      "envVar": "LOG_LEVEL",
      "label": "Logging level",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Logging level",
      "default": "info",
      "placeholder": "info",
      "options": ["debug", "info", "warn", "error"]
    }
  ]
}
