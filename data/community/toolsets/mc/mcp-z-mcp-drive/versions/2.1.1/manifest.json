{
  "schemaVersion": 1,
  "version": "2.1.1",
  "releasedAt": "2026-09-06T16:09:51.717874Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@mcp-z/mcp-drive",
    "version": "2.1.1",
    "sha256": "7087e8c3b54cb36efee0da23852dc9ee3a0ff2cd823e25eee0272d9540561001",
    "entry": "bin/server.js",
    "args": [
      "--auth",
      "--headless",
      "--redirect-uri",
      "--service-account-key-file",
      "--resource-store-uri",
      "--base-url",
      "--log-level"
    ],
    "envHints": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "GOOGLE_SERVICE_ACCOUNT_KEY_FILE",
      "AUTH_MODE",
      "HEADLESS",
      "REDIRECT_URI",
      "RESOURCE_STORE_URI",
      "PORT",
      "BASE_URL",
      "LOG_LEVEL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "GOOGLE_CLIENT_ID",
      "envVar": "GOOGLE_CLIENT_ID",
      "label": "Google OAuth client ID (required for OAuth authentication modes)",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Google OAuth client ID (required for OAuth authentication modes)",
      "placeholder": "123456789-abcdefghijk.apps.googleusercontent.com"
    },
    {
      "id": "GOOGLE_CLIENT_SECRET",
      "envVar": "GOOGLE_CLIENT_SECRET",
      "label": "Google OAuth client secret (optional for public clients)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Google OAuth client secret (optional for public clients)",
      "placeholder": "GOCSPX-abcdefghijklmnop"
    },
    {
      "id": "GOOGLE_SERVICE_ACCOUNT_KEY_FILE",
      "envVar": "GOOGLE_SERVICE_ACCOUNT_KEY_FILE",
      "label": "Path to service account JSON key file (required for service-account auth mode)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Path to service account JSON key file (required for service-account auth mode)",
      "placeholder": "/path/to/service-account-key.json"
    },
    {
      "id": "AUTH_MODE",
      "envVar": "AUTH_MODE",
      "label": "Authentication mode",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Authentication mode",
      "default": "loopback-oauth",
      "placeholder": "loopback-oauth",
      "options": [
        "loopback-oauth",
        "service-account"
      ]
    },
    {
      "id": "HEADLESS",
      "envVar": "HEADLESS",
      "label": "Disable browser auto-open, return auth URL instead (true/false)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Disable browser auto-open, return auth URL instead (true/false)",
      "default": "false",
      "placeholder": "false"
    },
    {
      "id": "REDIRECT_URI",
      "envVar": "REDIRECT_URI",
      "label": "OAuth redirect URI (optional, default: ephemeral loopback)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "OAuth redirect URI (optional, default: ephemeral loopback)",
      "placeholder": "http://localhost:{PORT}/oauth/callback"
    },
    {
      "id": "RESOURCE_STORE_URI",
      "envVar": "RESOURCE_STORE_URI",
      "label": "Resource store URI for exported files (file://)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Resource store URI for exported files (file://)",
      "default": "file://~/.mcp-z/mcp-drive/files",
      "placeholder": "file://~/.mcp-z/mcp-drive/files"
    },
    {
      "id": "PORT",
      "envVar": "PORT",
      "label": "HTTP server port (overrides --port)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "HTTP server port (overrides --port)",
      "placeholder": "3000"
    },
    {
      "id": "BASE_URL",
      "envVar": "BASE_URL",
      "label": "Base URL for HTTP transport (used for OAuth/DCR endpoints and file links)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Base URL for HTTP transport (used for OAuth/DCR endpoints and file links)",
      "placeholder": "http://localhost:{PORT}"
    },
    {
      "id": "LOG_LEVEL",
      "envVar": "LOG_LEVEL",
      "label": "Logging level",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Logging level",
      "default": "info",
      "placeholder": "info",
      "options": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    }
  ]
}
