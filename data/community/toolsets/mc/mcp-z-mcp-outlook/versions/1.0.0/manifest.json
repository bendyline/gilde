{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2025-12-29T08:30:21.210175Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@mcp-z/mcp-outlook",
    "version": "1.0.0",
    "sha256": "36d152e364f3855d1dc6a917cc0b23211727e38c42cc42891205b7948dfa5bae",
    "entry": "bin/server.js",
    "args": [
      "--auth",
      "--tenant-id",
      "--headless",
      "--redirect-uri",
      "--storage-dir",
      "--base-url",
      "--log-level"
    ],
    "envHints": [
      "MS_CLIENT_ID",
      "MS_TENANT_ID",
      "MS_CLIENT_SECRET",
      "AUTH_MODE",
      "HEADLESS",
      "REDIRECT_URI",
      "STORAGE_DIR",
      "PORT",
      "BASE_URL",
      "LOG_LEVEL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "MS_CLIENT_ID",
      "envVar": "MS_CLIENT_ID",
      "label": "Microsoft OAuth client ID (required for OAuth authentication modes)",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Microsoft OAuth client ID (required for OAuth authentication modes)",
      "placeholder": "12345678-abcd-1234-abcd-123456789abc"
    },
    {
      "id": "MS_TENANT_ID",
      "envVar": "MS_TENANT_ID",
      "label": "Microsoft tenant ID (required for OAuth authentication)",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Microsoft tenant ID (required for OAuth authentication)",
      "placeholder": "common"
    },
    {
      "id": "MS_CLIENT_SECRET",
      "envVar": "MS_CLIENT_SECRET",
      "label": "Microsoft OAuth client secret (optional for public clients)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Microsoft OAuth client secret (optional for public clients)",
      "placeholder": "abc~123DEF.456ghi-789JKL_012mno"
    },
    {
      "id": "AUTH_MODE",
      "envVar": "AUTH_MODE",
      "label": "Authentication mode",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Authentication mode",
      "default": "loopback-oauth",
      "placeholder": "loopback-oauth",
      "options": ["loopback-oauth", "device-code"]
    },
    {
      "id": "HEADLESS",
      "envVar": "HEADLESS",
      "label": "Disable browser auto-open, return auth URL instead (true/false)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Disable browser auto-open, return auth URL instead (true/false)",
      "default": "false",
      "placeholder": "false"
    },
    {
      "id": "REDIRECT_URI",
      "envVar": "REDIRECT_URI",
      "label": "OAuth redirect URI (optional, default: ephemeral loopback)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "OAuth redirect URI (optional, default: ephemeral loopback)",
      "placeholder": "http://localhost:{PORT}/oauth/callback"
    },
    {
      "id": "STORAGE_DIR",
      "envVar": "STORAGE_DIR",
      "label": "Directory for storing CSV export files",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Directory for storing CSV export files",
      "default": "~/.mcp-z/mcp-outlook/files",
      "placeholder": "~/.mcp-z/mcp-outlook/files"
    },
    {
      "id": "PORT",
      "envVar": "PORT",
      "label": "HTTP server port (overrides --port)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "HTTP server port (overrides --port)",
      "placeholder": "3000"
    },
    {
      "id": "BASE_URL",
      "envVar": "BASE_URL",
      "label": "Base URL for HTTP file serving (optional, used for HTTP transport)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Base URL for HTTP file serving (optional, used for HTTP transport)",
      "placeholder": "http://localhost:{PORT}"
    },
    {
      "id": "LOG_LEVEL",
      "envVar": "LOG_LEVEL",
      "label": "Logging level",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Logging level",
      "default": "info",
      "placeholder": "info",
      "options": ["debug", "info", "warn", "error"]
    }
  ]
}
