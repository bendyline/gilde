{
  "schemaVersion": 1,
  "version": "1.0.13",
  "releasedAt": "2026-01-10T14:22:19.253826Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@mcp-z/mcp-outlook",
    "version": "1.0.13",
    "sha256": "2b09c30c72642837c038f9b4e3f60394a7b9a9938a3adbebcaa6b3d1ab49ce3b",
    "entry": "bin/server.js",
    "args": [
      "--auth",
      "--tenant-id",
      "--headless",
      "--redirect-uri",
      "--resource-store-uri",
      "--base-url",
      "--log-level"
    ],
    "envHints": [
      "MS_CLIENT_ID",
      "MS_TENANT_ID",
      "MS_CLIENT_SECRET",
      "AUTH_MODE",
      "HEADLESS",
      "REDIRECT_URI",
      "RESOURCE_STORE_URI",
      "PORT",
      "BASE_URL",
      "LOG_LEVEL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "MS_CLIENT_ID",
      "envVar": "MS_CLIENT_ID",
      "label": "Microsoft OAuth client ID (required for OAuth authentication modes)",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Microsoft OAuth client ID (required for OAuth authentication modes)",
      "placeholder": "12345678-abcd-1234-abcd-123456789abc"
    },
    {
      "id": "MS_TENANT_ID",
      "envVar": "MS_TENANT_ID",
      "label": "Microsoft tenant ID (required for OAuth authentication)",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Microsoft tenant ID (required for OAuth authentication)",
      "placeholder": "common"
    },
    {
      "id": "MS_CLIENT_SECRET",
      "envVar": "MS_CLIENT_SECRET",
      "label": "Microsoft OAuth client secret (optional for public clients)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Microsoft OAuth client secret (optional for public clients)",
      "placeholder": "abc~123DEF.456ghi-789JKL_012mno"
    },
    {
      "id": "AUTH_MODE",
      "envVar": "AUTH_MODE",
      "label": "Authentication mode",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Authentication mode",
      "default": "loopback-oauth",
      "placeholder": "loopback-oauth",
      "options": ["loopback-oauth", "device-code"]
    },
    {
      "id": "HEADLESS",
      "envVar": "HEADLESS",
      "label": "Disable browser auto-open, return auth URL instead (true/false)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Disable browser auto-open, return auth URL instead (true/false)",
      "default": "false",
      "placeholder": "false"
    },
    {
      "id": "REDIRECT_URI",
      "envVar": "REDIRECT_URI",
      "label": "OAuth redirect URI (optional, default: ephemeral loopback)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "OAuth redirect URI (optional, default: ephemeral loopback)",
      "placeholder": "http://localhost:{PORT}/oauth/callback"
    },
    {
      "id": "RESOURCE_STORE_URI",
      "envVar": "RESOURCE_STORE_URI",
      "label": "Resource store URI for CSV export files (file://)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Resource store URI for CSV export files (file://)",
      "default": "file://~/.mcp-z/mcp-outlook/files",
      "placeholder": "file://~/.mcp-z/mcp-outlook/files"
    },
    {
      "id": "PORT",
      "envVar": "PORT",
      "label": "HTTP server port (overrides --port)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "HTTP server port (overrides --port)",
      "placeholder": "3000"
    },
    {
      "id": "BASE_URL",
      "envVar": "BASE_URL",
      "label": "Base URL for HTTP transport (used for OAuth/DCR endpoints and file links)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Base URL for HTTP transport (used for OAuth/DCR endpoints and file links)",
      "placeholder": "http://localhost:{PORT}"
    },
    {
      "id": "LOG_LEVEL",
      "envVar": "LOG_LEVEL",
      "label": "Logging level",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Logging level",
      "default": "info",
      "placeholder": "info",
      "options": ["debug", "info", "warn", "error"]
    }
  ]
}
