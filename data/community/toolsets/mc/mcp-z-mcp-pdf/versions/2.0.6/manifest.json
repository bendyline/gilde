{
  "schemaVersion": 1,
  "version": "2.0.6",
  "releasedAt": "2026-01-10T14:22:18.445302Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@mcp-z/mcp-pdf",
    "version": "2.0.6",
    "sha256": "3db2588466c1eb21e2c255eeb966549d2cdaafa8a3020413c64a197a100c93c6",
    "entry": "bin/server.js",
    "args": ["--resource-store-uri", "--base-url", "--log-level"],
    "envHints": ["RESOURCE_STORE_URI", "PORT", "BASE_URL", "LOG_LEVEL"]
  },
  "tools": [],
  "config": [
    {
      "id": "RESOURCE_STORE_URI",
      "envVar": "RESOURCE_STORE_URI",
      "label": "Resource store URI for generated PDF files (file://)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Resource store URI for generated PDF files (file://)",
      "default": "file://~/.mcp-z/mcp-pdf/files",
      "placeholder": "file://~/.mcp-z/mcp-pdf/files"
    },
    {
      "id": "PORT",
      "envVar": "PORT",
      "label": "HTTP server port (overrides --port)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "HTTP server port (overrides --port)",
      "placeholder": "3000"
    },
    {
      "id": "BASE_URL",
      "envVar": "BASE_URL",
      "label": "Base URL for HTTP transport (used for file links)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Base URL for HTTP transport (used for file links)",
      "placeholder": "http://localhost:{PORT}"
    },
    {
      "id": "LOG_LEVEL",
      "envVar": "LOG_LEVEL",
      "label": "Logging level",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Logging level",
      "default": "info",
      "placeholder": "info",
      "options": ["debug", "info", "warn", "error"]
    }
  ]
}
