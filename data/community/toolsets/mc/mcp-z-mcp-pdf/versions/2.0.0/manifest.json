{
  "schemaVersion": 1,
  "version": "2.0.0",
  "releasedAt": "2025-12-29T06:44:42.91348Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@mcp-z/mcp-pdf",
    "version": "2.0.0",
    "sha256": "de5d9a53715c01ba35f768f2c57c2e4251f1153240bec3968da449e90878e6a9",
    "entry": "bin/server.js",
    "args": [
      "--storage-dir",
      "--base-url",
      "--log-level"
    ],
    "envHints": [
      "STORAGE_DIR",
      "PORT",
      "BASE_URL",
      "LOG_LEVEL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "STORAGE_DIR",
      "envVar": "STORAGE_DIR",
      "label": "Directory for storing generated PDF files",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Directory for storing generated PDF files",
      "default": "~/.mcp-z/mcp-pdf/files",
      "placeholder": "~/.mcp-pdf"
    },
    {
      "id": "PORT",
      "envVar": "PORT",
      "label": "HTTP server port (overrides --port)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "HTTP server port (overrides --port)",
      "placeholder": "3000"
    },
    {
      "id": "BASE_URL",
      "envVar": "BASE_URL",
      "label": "Base URL for file serving (optional, used for HTTP transport)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Base URL for file serving (optional, used for HTTP transport)",
      "placeholder": "http://localhost:{PORT}"
    },
    {
      "id": "LOG_LEVEL",
      "envVar": "LOG_LEVEL",
      "label": "Logging level",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Logging level",
      "default": "info",
      "placeholder": "info",
      "options": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    }
  ]
}
