{
  "schemaVersion": 1,
  "version": "3.2.1",
  "releasedAt": "2026-09-13T00:15:19.642859Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@mcp-z/mcp-pdf",
    "version": "3.2.1",
    "sha256": "c803e040e4ee0e04b7f293dda8781b789099a9bc108914f50d2e4d95c44b0fae",
    "entry": "bin/server.js",
    "args": [
      "--resource-store-uri",
      "--base-url",
      "--log-level"
    ],
    "envHints": [
      "RESOURCE_STORE_URI",
      "PORT",
      "BASE_URL",
      "LOG_LEVEL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "RESOURCE_STORE_URI",
      "envVar": "RESOURCE_STORE_URI",
      "label": "Resource store URI for generated PDF files (file://)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Resource store URI for generated PDF files (file://)",
      "default": "file://~/.mcp-z/mcp-pdf/files",
      "placeholder": "file://~/.mcp-z/mcp-pdf/files"
    },
    {
      "id": "PORT",
      "envVar": "PORT",
      "label": "HTTP server port (overrides --port)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "HTTP server port (overrides --port)",
      "placeholder": "3000"
    },
    {
      "id": "BASE_URL",
      "envVar": "BASE_URL",
      "label": "Base URL for HTTP transport (used for file links)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Base URL for HTTP transport (used for file links)",
      "placeholder": "http://localhost:{PORT}"
    },
    {
      "id": "LOG_LEVEL",
      "envVar": "LOG_LEVEL",
      "label": "Logging level",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Logging level",
      "default": "info",
      "placeholder": "info",
      "options": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    }
  ]
}
