    "entry": "bin/mcp-abap-adt.js",
    "args": [],
    "envHints": [
      "SAP_URL",
      "SAP_AUTH_TYPE",
      "SAP_SYSTEM_TYPE",
      "SAP_CLIENT",
      "SAP_JWT_TOKEN",
      "SAP_USERNAME",
      "SAP_PASSWORD",
      "SAP_LANGUAGE",
      "SAP_MASTER_SYSTEM",
      "SAP_RESPONSIBLE"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "SAP_URL",
      "envVar": "SAP_URL",
      "label": "Base URL of the ABAP system (e",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Base URL of the ABAP system (e.g. https://my-system.example.com or a BTP ABAP service URL). Required to connect; without it the server starts in tool-inspection-only mode.",
      "placeholder": "https://your-abap-system.example.com"
    },
    {
      "id": "SAP_AUTH_TYPE",
      "envVar": "SAP_AUTH_TYPE",
      "label": "Authentication method: 'xsuaa' for JWT/OAuth2 (BTP ABAP Cloud) or 'basic' for username/password (on-prem)",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Authentication method: 'xsuaa' for JWT/OAuth2 (BTP ABAP Cloud) or 'basic' for username/password (on-prem).",
      "default": "xsuaa",
      "options": [
        "xsuaa",
        "basic"
      ]
    },
    {
      "id": "SAP_SYSTEM_TYPE",
      "envVar": "SAP_SYSTEM_TYPE",
      "label": "System type, controls which tools are available (e",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "System type, controls which tools are available (e.g. Programs are onprem-only).",
      "default": "cloud",
      "options": [
        "cloud",
        "onprem",
        "legacy"
      ]
    },
    {
      "id": "SAP_CLIENT",
      "envVar": "SAP_CLIENT",
      "label": "ABAP client/mandant number (e",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "ABAP client/mandant number (e.g. 100). Optional for BTP ABAP Cloud.",
      "placeholder": "100"
    },
    {
      "id": "SAP_JWT_TOKEN",
      "envVar": "SAP_JWT_TOKEN",
      "label": "JWT bearer token for SAP_AUTH_TYPE=xsuaa",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "JWT bearer token for SAP_AUTH_TYPE=xsuaa. Provide this (or the SAP_UAA_* refresh-token set) for JWT auth."
    },
    {
      "id": "SAP_USERNAME",
      "envVar": "SAP_USERNAME",
      "label": "Username for SAP_AUTH_TYPE=basic (on-prem)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Username for SAP_AUTH_TYPE=basic (on-prem)."
    },
    {
      "id": "SAP_PASSWORD",
      "envVar": "SAP_PASSWORD",
      "label": "Password for SAP_AUTH_TYPE=basic (on-prem)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Password for SAP_AUTH_TYPE=basic (on-prem)."
    },
    {
      "id": "SAP_LANGUAGE",
      "envVar": "SAP_LANGUAGE",
      "label": "Logon language (ISO code, e",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Logon language (ISO code, e.g. 'en', 'de').",
      "default": "en"
    },
    {
      "id": "SAP_MASTER_SYSTEM",
      "envVar": "SAP_MASTER_SYSTEM",
      "label": "System context for on-prem create/update operations (e",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "System context for on-prem create/update operations (e.g. DEV)."
