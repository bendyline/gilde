{
  "schemaVersion": 1,
  "version": "1.4.1",
  "releasedAt": "2026-09-05T18:52:07.726139Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.flashodds.live/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your Flash Props API key, as a Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your Flash Props API key, as a Bearer token.",
      "default": "Bearer {api_key}"
    }
  ]
}
