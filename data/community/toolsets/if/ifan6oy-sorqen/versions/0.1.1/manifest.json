{
  "schemaVersion": 1,
  "version": "0.1.1",
  "releasedAt": "2026-09-03T06:02:03.424977Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://sorqen.flashodds.live/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your Sorqen API key, as a Bearer token",
