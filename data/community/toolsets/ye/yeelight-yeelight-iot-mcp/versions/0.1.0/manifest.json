    "url": "https://api.yeelight.com/apis/mcp_server/v1/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization",
      "Yeelight-Region",
      "House-Id"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Yeelight cloud Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Yeelight cloud Bearer token."
    },
    {
      "id": "Yeelight-Region",
      "envVar": "Yeelight-Region",
      "label": "Optional Yeelight region: cn, sg, us, eu, or dev",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional Yeelight region: cn, sg, us, eu, or dev."
    },
    {
      "id": "House-Id",
      "envVar": "House-Id",
      "label": "Optional Pro home identifier for request-scoped selection",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional Pro home identifier for request-scoped selection."
    }
  ]
