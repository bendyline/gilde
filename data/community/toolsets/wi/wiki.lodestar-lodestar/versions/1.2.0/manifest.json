{
  "schemaVersion": 1,
  "version": "1.2.0",
  "releasedAt": "2026-11-13T21:24:57.933964Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.lodestar.wiki/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <your lod_ key>",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer <your lod_ key>. No key yet? Connect without it, call the sign_up tool (free, one call), and pass the key as the api_key argument."
    }
  ]
}
