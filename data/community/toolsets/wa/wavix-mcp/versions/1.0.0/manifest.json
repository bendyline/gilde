{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-05-25T05:59:05.51111Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.wavix.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token containing the user's Wavix API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token containing the user's Wavix API key. Obtain one at https://wavix.com under Administration → API keys."
    }
  ]
}
