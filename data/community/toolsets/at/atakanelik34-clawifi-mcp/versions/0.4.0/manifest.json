{
  "schemaVersion": 1,
  "version": "0.4.0",
  "releasedAt": "2026-10-22T07:36:22.877644Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.clawifi.dev/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token with your Clawifi API key",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer token with your Clawifi API key. Optional: without it only search_free, fetch_url, scrape_url and map_site work, at 12/min and 50/day per address.",
      "default": "Bearer {clawifi_api_key}"
    }
  ]
}
