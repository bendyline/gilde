{
  "schemaVersion": 1,
  "version": "1.5.0",
  "releasedAt": "2026-11-09T21:07:13.159505Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://siwai.app/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer siwai_",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer siwai_... API key from SIWAI Account settings > API keys. Optional for clients that complete MCP OAuth."
    }
  ]
}
