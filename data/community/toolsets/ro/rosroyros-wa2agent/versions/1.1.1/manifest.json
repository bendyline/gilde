{
  "schemaVersion": 1,
  "version": "1.1.1",
  "releasedAt": "2026-10-26T08:45:21.014995Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://vault-{vault_id}.wa2agent.link/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <agent access key from your vault page>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <agent access key from your vault page>"
    }
  ]
}
