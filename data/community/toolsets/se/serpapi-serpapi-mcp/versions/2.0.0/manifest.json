{
  "schemaVersion": 1,
  "version": "2.0.0",
  "releasedAt": "2026-09-22T04:55:30.305312Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.serpapi.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token authentication using your SerpApi API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token authentication using your SerpApi API key.",
      "default": "Bearer {SERPAPI_API_KEY}"
    }
  ]
}
