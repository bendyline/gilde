{
  "schemaVersion": 1,
  "version": "0.5.4",
  "releasedAt": "2026-10-14T05:23:37.842508Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.iliad.trustfabric.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <your-api-key>",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer <your-api-key>. Free tier available. Get key: POST /v1/accounts"
    }
  ]
}
