{
  "schemaVersion": 1,
  "version": "0.3.0",
  "releasedAt": "2026-11-12T13:02:37.268145Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.landed.jobs/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional: a landed API token as \"Bearer <token>\" for clients without OAuth sign-in",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional: a landed API token as \"Bearer <token>\" for clients without OAuth sign-in. Create one in landed Settings.",
      "placeholder": "Bearer lnd_live_..."
    }
  ]
