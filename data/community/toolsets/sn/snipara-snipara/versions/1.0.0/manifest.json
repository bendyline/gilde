{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-07-21T08:39:32.279682Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.snipara.com/mcp/{project_slug}",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-API-Key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-API-Key",
      "envVar": "X-API-Key",
      "label": "A Snipara API key with access to the selected project",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "A Snipara API key with access to the selected project."
    }
  ]
}
