{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-10-16T21:41:10.788271Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.printfriendly.com",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your PrintFriendly API key, sent as a Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your PrintFriendly API key, sent as a Bearer token. Get a free key (100 documents a month) at https://www.printfriendly.com/me/api-key",
      "default": "Bearer {PRINTFRIENDLY_API_KEY}"
    }
  ]
}
