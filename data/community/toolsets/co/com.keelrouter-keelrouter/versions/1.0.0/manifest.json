{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-11-13T16:20:20.632499Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.keelrouter.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <your key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <your key>. Create a key at https://keelrouter.com/console/keys",
      "default": "Bearer {api_key}"
    }
  ]
}
