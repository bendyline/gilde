{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-11-14T11:07:27.322177Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.gitranks.com/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-GitRanks-Token"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-GitRanks-Token",
      "envVar": "X-GitRanks-Token",
      "label": "Optional: a personal token from gitranks",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional: a personal token from gitranks.com → Contribute → Settings, for a client without sign-in. Clients with OAuth sign in through gitranks.com instead.",
      "default": "{gitranks_token}"
    }
  ]
}
