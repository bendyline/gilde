{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-10-28T05:27:14.200555Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.scrapercompany.com/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "x-api-key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-api-key",
      "envVar": "x-api-key",
      "label": "Optional ScraperCompany API key (starts with sk_)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional ScraperCompany API key (starts with sk_). Leave it out to sign in with OAuth in the browser."
    }
  ]
}
