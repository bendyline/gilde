{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-09-28T07:49:52.065655Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://arkrel.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your Arkrel API key, sent as \"Bearer <key>\"",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your Arkrel API key, sent as \"Bearer <key>\". Create one at arkrel.com on the API keys page."
    }
  ]
}
