  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.wassenger.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your Wassenger API key as 'Bearer <key>'",
