{
  "schemaVersion": 1,
  "version": "0.1.2",
  "releasedAt": "2026-10-26T07:39:55.286854Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.meteosource.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token carrying your Meteosource API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token carrying your Meteosource API key. The plan the key is on decides which tools are available.",
      "default": "Bearer {api_key}"
    }
  ]
}
