{
  "schemaVersion": 1,
  "version": "1.10.10",
  "releasedAt": "2026-08-11T05:05:19.018701Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.chainstack.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Chainstack API key as a Bearer token",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Chainstack API key as a Bearer token. Optional — docs search, platform status, pricing, and contact tools work without it."
    }
  ]
}
