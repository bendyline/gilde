{
  "schemaVersion": 1,
  "version": "3.5.1",
  "releasedAt": "2026-10-24T12:20:47.282963Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://app.relvato.com/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Your Relvato API key as a Bearer token, from API access (app.relvato.com/api-access). Leave it out to sign in with OAuth instead.",
      "default": "Bearer {api_key}"
    }
  ]
}
