{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-06-26T14:53:04.283304Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.datalastic.com/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-Api-Key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-Api-Key",
      "envVar": "X-Api-Key",
      "label": "Your Datalastic API key",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Your Datalastic API key. Not required if authenticating via OAuth."
    }
  ]
}
