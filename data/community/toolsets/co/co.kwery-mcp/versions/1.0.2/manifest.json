{
  "schemaVersion": 1,
  "version": "1.0.2",
  "releasedAt": "2026-11-13T09:16:22.38734Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.kwery.co/mcp?ref=registry",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "x-api-key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-api-key",
      "envVar": "x-api-key",
      "label": "Your kwery API key (starts with kwy_live_)",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your kwery API key (starts with kwy_live_). Get one at https://kwery.co/signup"
    }
  ]
}
