{
  "schemaVersion": 1,
  "version": "1.1.4",
  "releasedAt": "2026-10-09T22:39:17.396818Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.reqbeat.com/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-API-Key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-API-Key",
      "envVar": "X-API-Key",
      "label": "Reqbeat plane API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Reqbeat plane API key. Required to call a tool: without it a call returns a signup link, not data."
    }
  ]
}
