{
  "schemaVersion": 1,
  "version": "1.4.0",
  "releasedAt": "2026-11-11T11:04:49.253512Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.activationking.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional personal ActivationKing API key (https://activationking",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional personal ActivationKing API key (https://activationking.com/dashboard/api-keys). Without it, clients sign in with OAuth.",
      "default": "Bearer {api_key}"
    }
  ]
}
