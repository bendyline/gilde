  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.upload-post.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Your Upload-Post API key as 'ApiKey <key>' (or 'Bearer <key>'). Omit to use the OAuth flow instead."
    }
  ]
