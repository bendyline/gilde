{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-22T06:24:37.413349Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.vramglass.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "API key from vramglass",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "API key from vramglass.com/account/mcp. Leave empty if your client signs in with OAuth.",
      "default": "Bearer {api_key}"
    }
  ]
}
