{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-07-29T05:26:12.46864Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.hyperping.io/v1/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token. Create a read_only or read_write API key under Project Settings, API Keys."
    }
  ]
}
