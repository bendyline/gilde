    "entry": "build/index.js",
    "args": [],
    "envHints": [
      "CATASTROGPS_API_KEY",
      "CATASTROGPS_TIMEOUT",
      "CATASTROGPS_API_URL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "CATASTROGPS_API_KEY",
      "envVar": "CATASTROGPS_API_KEY",
      "label": "Catastro GPS API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Catastro GPS API key. Free tier: 250 calls/month; failed lookups are free at https://www.catastrogps.es/developers"
    },
    {
      "id": "CATASTROGPS_TIMEOUT",
      "envVar": "CATASTROGPS_TIMEOUT",
      "label": "Request timeout in milliseconds (official cadastres can be slow)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Request timeout in milliseconds (official cadastres can be slow)",
      "default": "20000"
    },
    {
      "id": "CATASTROGPS_API_URL",
      "envVar": "CATASTROGPS_API_URL",
      "label": "API base URL",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "API base URL",
      "default": "https://api.parcelgps.com"
    },
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer followed by your Parcel GPS API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer followed by your Parcel GPS API key. Free tier: 250 calls/month at https://www.parcelgps.com/developers"
    }
  ]
