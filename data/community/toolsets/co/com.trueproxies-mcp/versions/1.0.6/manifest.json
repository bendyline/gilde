{
  "schemaVersion": 1,
  "version": "1.0.6",
  "releasedAt": "2026-11-07T09:18:58.309741Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.trueproxies.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "TrueProxies API key as 'Bearer tp_api_",
