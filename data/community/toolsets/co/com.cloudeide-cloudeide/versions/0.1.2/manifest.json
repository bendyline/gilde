{
  "schemaVersion": 1,
  "version": "0.1.2",
  "releasedAt": "2026-09-01T12:47:30.588598Z",
  "runtime": {
    "kind": "npm-package",
    "package": "cloudeide",
    "version": "0.1.2",
    "sha256": "aa850594f6347ada7ec33e1d001c5d1991f8ee537592abf5b01fb56ee7275d74",
    "entry": "dist/cli.mjs",
    "args": [
      "mcp"
    ],
    "envHints": [
      "CLOUDEIDE_TOKEN",
      "CLOUDEIDE_API_URL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "CLOUDEIDE_TOKEN",
      "envVar": "CLOUDEIDE_TOKEN",
      "label": "API token from Settings -> API tokens in the CloudeIDE dashboard",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "API token from Settings -> API tokens in the CloudeIDE dashboard. The server exits with a message if it is missing."
    },
    {
      "id": "CLOUDEIDE_API_URL",
      "envVar": "CLOUDEIDE_API_URL",
      "label": "Base URL of the CloudeIDE API",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Base URL of the CloudeIDE API. Only needed for a self-hosted server.",
      "default": "https://cloudeide.com"
    }
  ]
}
