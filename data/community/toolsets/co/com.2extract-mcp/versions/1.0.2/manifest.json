{
  "schemaVersion": 1,
  "version": "1.0.2",
  "releasedAt": "2026-10-21T11:22:36.995385Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.2extract.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "2extract API key as a bearer token",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "2extract API key as a bearer token",
      "default": "Bearer {api_key}"
    }
  ]
}
