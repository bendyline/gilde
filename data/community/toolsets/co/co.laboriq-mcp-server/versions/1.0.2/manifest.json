{
  "schemaVersion": 1,
  "version": "1.0.2",
  "releasedAt": "2026-09-24T02:12:07.259952Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.laboriq.co/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "x-api-key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-api-key",
      "envVar": "x-api-key",
      "label": "LaborIQ MCP API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "LaborIQ MCP API key. Free keys are issued by email at https://laboriq.co/mcp. Pro keys come from the LaborIQ portal."
    }
  ]
}
