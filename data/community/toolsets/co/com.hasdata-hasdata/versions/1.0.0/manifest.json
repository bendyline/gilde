{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-08-24T10:12:35.010882Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.hasdata.com/api/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "x-api-key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-api-key",
      "envVar": "x-api-key",
      "label": "HasData API key from app",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "HasData API key from app.hasdata.com. Free trial, no card."
    }
  ]
}
