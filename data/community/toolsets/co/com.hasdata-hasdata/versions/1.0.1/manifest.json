{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-09-25T06:13:27.434579Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.hasdata.com/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "x-api-key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-api-key",
      "envVar": "x-api-key",
      "label": "HasData API key from app",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "HasData API key from app.hasdata.com (optional when the client signs in with OAuth). Free trial, no card."
    }
  ]
}
