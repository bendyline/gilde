{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-09-29T19:32:58.095021Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://developer.unipile.com/mcp?branch={branch}",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-API-KEY"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-API-KEY",
      "envVar": "X-API-KEY",
      "label": "Unipile API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Unipile API key. v2: scoped Account API key from dashboardv2.unipile.com. v1: access token."
    }
  ]
}
