{
  "schemaVersion": 1,
  "version": "1.0.2",
  "releasedAt": "2026-11-09T01:40:05.614778Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://orafabric.com/api/dev/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer API key from the OraFabric developer console",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer API key from the OraFabric developer console.",
      "default": "Bearer {api_key}"
    }
  ]
}
