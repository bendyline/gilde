{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-05-18T16:20:51.71126Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.datadoe.com/mcp/v1",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "datadoe-mcp-key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "datadoe-mcp-key",
      "envVar": "datadoe-mcp-key",
      "label": "DataDoe MCP API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "DataDoe MCP API key. Create one at https://app.datadoe.com/integrations/mcp",
      "placeholder": "<YOUR_DATADOE_MCP_KEY>"
    }
  ]
}
