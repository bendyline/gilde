{
  "schemaVersion": 1,
  "version": "2.0.0",
  "releasedAt": "2026-09-23T13:41:45.352809Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.zettoai.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <Zetto API key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <Zetto API key>. Get a key without a browser: POST https://api.zettoai.com/api/auth/signup/start then /api/auth/signup/verify. X-API-Key: <key> also works.",
      "default": "Bearer {zetto_api_key}"
    }
  ]
}
