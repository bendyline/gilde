{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-10-29T17:26:35.928046Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.houseaiapp.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional personal API token from houseaiapp",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional personal API token from houseaiapp.com/app/connector. Leave it out to sign in with OAuth.",
      "default": "Bearer {token}"
    }
  ]
}
