{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-09-15T08:16:12.338151Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.parsestream.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "ParseStream brand API key, sent as a bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "ParseStream brand API key, sent as a bearer token. Mint one in ParseStream under Brand Settings, API Keys. A key is scoped to a single brand.",
      "default": "Bearer {api_key}"
    }
  ]
}
