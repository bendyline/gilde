{
  "schemaVersion": 1,
  "version": "1.1.0",
  "releasedAt": "2026-10-19T11:27:09.80395Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://www.findleademails.com/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Leave empty to sign in with OAuth. Or send your FindLeadEmails API key as a bearer token.",
      "default": "Bearer {api_key}"
    }
  ]
}
