{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-11-12T13:00:51.435301Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://primaverapp.com/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your Primavera API key as a Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your Primavera API key as a Bearer token. Keys are created at https://primaverapp.com/dashboard/api (Pro or Agency subscription).",
      "default": "Bearer {api_key}"
    }
  ]
}
