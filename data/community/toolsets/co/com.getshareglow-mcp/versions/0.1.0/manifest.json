{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-10-11T17:52:24.853386Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.getshareglow.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your Shareglow API key as a Bearer token (sk_live_",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your Shareglow API key as a Bearer token (sk_live_...), created in the Shareglow dashboard.",
      "default": "Bearer {api_key}"
    }
  ]
}
