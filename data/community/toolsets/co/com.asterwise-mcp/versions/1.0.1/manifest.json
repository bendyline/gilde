{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-09-04T17:29:45.80463Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.asterwise.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <Asterwise API key or OAuth access token>",
