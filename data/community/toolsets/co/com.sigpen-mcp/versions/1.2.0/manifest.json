{
  "schemaVersion": 1,
  "version": "1.2.0",
  "releasedAt": "2026-11-15T10:14:13.956966Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://www.sigpen.com/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. A SigPen API key, sent as a Bearer token. Without it, your client signs in to SigPen.",
      "default": "Bearer {api_key}"
    }
  ]
}
