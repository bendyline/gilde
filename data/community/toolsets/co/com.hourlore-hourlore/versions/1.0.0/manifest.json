{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-11-15T04:05:53.830291Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://hourlore.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer API key from https://hourlore",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer API key from https://hourlore.com/account",
      "default": "Bearer {api_key}"
    }
  ]
}
