{
  "schemaVersion": 1,
  "version": "0.14.2",
  "releasedAt": "2026-08-05T11:09:11.420402Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.apify.com/",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Apify API token for authentication with Apify platform services",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Apify API token for authentication with Apify platform services. For example 'Bearer <apify-api-token>'"
    }
  ]
}
