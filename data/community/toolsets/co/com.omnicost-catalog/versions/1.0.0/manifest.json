{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-29T15:54:23.623585Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://omnicost.com/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token with your Omnicost organization API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token with your Omnicost organization API key",
      "default": "Bearer {api_key}"
    }
  ]
}
