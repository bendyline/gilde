{
  "schemaVersion": 1,
  "version": "1.1.0",
  "releasedAt": "2026-11-01T21:38:58.866107Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://omnicost.com/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional Bearer API key",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional Bearer API key. Clients with MCP OAuth can sign in with an Omnicost account instead.",
      "default": "Bearer {api_key}"
    }
  ]
}
