{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-09-17T22:00:40.533254Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.boathousecloud.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer followed by your Boat House account key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer followed by your Boat House account key. Use the account page advanced MCP settings; never publish this value."
    }
  ]
}
