      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Bring-your-own-Twilio mode: account SID."
    },
    {
      "id": "TWILIO_AUTH_TOKEN",
      "envVar": "TWILIO_AUTH_TOKEN",
      "label": "Bring-your-own-Twilio mode: auth token",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bring-your-own-Twilio mode: auth token."
    },
    {
      "id": "TWILIO_PHONE_NUMBER",
      "envVar": "TWILIO_PHONE_NUMBER",
