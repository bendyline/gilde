{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-10-18T15:29:39.513937Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.fxsocket.com/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-API-Key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-API-Key",
      "envVar": "X-API-Key",
      "label": "FxSocket API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "FxSocket API key. A read-only key (fxs_ro_...) is enough: https://app.fxsocket.com/dashboard/api-key"
    }
  ]
}
