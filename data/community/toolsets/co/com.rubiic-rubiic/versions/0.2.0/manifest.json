{
  "schemaVersion": 1,
  "version": "0.2.0",
  "releasedAt": "2026-09-27T16:28:21.779058Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://rubiic.com/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional personal access token from https://rubiic",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional personal access token from https://rubiic.com/account. Clients that support MCP authorization can sign in instead.",
      "default": "Bearer {api_token}"
    }
  ]
}
