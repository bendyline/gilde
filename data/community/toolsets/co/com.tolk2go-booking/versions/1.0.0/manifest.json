{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-09-30T10:40:31.154834Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.tolk2go.com/api/v1/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <agent key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <agent key>. Log in once via POST https://api.tolk2go.com/api/v1/login, then issue a key via POST /api/v1/agent-access-keys. See the repository README."
    }
  ]
}
