{
  "schemaVersion": 1,
  "version": "1.1.0",
  "releasedAt": "2026-10-31T23:58:02.841052Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://advertiserleads.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Your AdvertiserLeads API key from Settings. Leave empty to sign in with OAuth instead, or to use the server anonymously with lower limits.",
      "default": "Bearer {api_key}"
    }
  ]
}
