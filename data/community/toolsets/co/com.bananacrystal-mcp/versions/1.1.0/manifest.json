{
  "schemaVersion": 1,
  "version": "1.1.0",
  "releasedAt": "2026-11-07T04:44:09.502608Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://agentic.bananacrystal.com/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "x-api-key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-api-key",
      "envVar": "x-api-key",
      "label": "API key from agents",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "API key from agents.bananacrystal.com/account. Sandbox keys start with bc_test_. Leave empty to sign in with OAuth instead."
    }
  ]
}
