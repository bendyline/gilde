{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-08-09T20:09:02.119641Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://memfleet.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <agent key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <agent key>. Mint a key for a Registered Agent from your Workspace's Console at memfleet.com; resolve it from an environment variable, never commit it."
    }
  ]
}
