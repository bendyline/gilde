{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-08-03T16:32:26.247289Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://markmesh.com/api/v1/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <API key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <API key>. Create one in MarkMesh under Developers → API keys. Use an mm_test_ key for sandbox or mm_live_ for a real portfolio."
    }
  ]
}
