{
  "schemaVersion": 1,
  "version": "1.8.0",
  "releasedAt": "2026-11-15T22:32:02.741794Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.ufcalendar.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <API key> from https://www",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer <API key> from https://www.ufcalendar.com/account/api (free plan, 100 requests/month, no card) — or leave empty to sign in with OAuth"
    }
  ]
}
