{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-25T10:58:42.997309Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://opengmb.synectus.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token from your OpenGMB account (Settings > API tokens)",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token from your OpenGMB account (Settings > API tokens)",
      "default": "Bearer {api_token}"
    }
  ]
}
