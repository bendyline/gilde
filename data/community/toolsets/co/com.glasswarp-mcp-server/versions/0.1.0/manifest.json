{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-07-25T16:15:31.367747Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.glasswarp.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer Glasswarp API key (gw_…)",
