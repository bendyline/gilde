{
  "schemaVersion": 1,
  "version": "1.14.0",
  "releasedAt": "2026-10-11T06:15:43.070842Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.agencyhandy.com/",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Leave unset to sign in with Agency Handy (OAuth 2.1). Or send Bearer followed by a workspace API key (Settings > Workspace Config > API Key)."
    }
  ]
}
