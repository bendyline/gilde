{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-10-27T15:35:07.619371Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.geonode.com/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-Api-Key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-Api-Key",
      "envVar": "X-Api-Key",
      "label": "Geonode API key",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Geonode API key. Optional: without it only extract is available, with anonymous limits."
    }
  ]
}
