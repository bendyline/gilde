{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-09-27T02:45:54.402079Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://rubiic.com/eve/agents/rubiic/eve/v1/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "A personal access token from https://rubiic",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "A personal access token from https://rubiic.com/account, sent as a bearer.",
      "default": "Bearer {api_token}"
    }
  ]
}
