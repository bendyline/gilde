{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-11-13T20:51:36.298668Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.ayinbox.com/v1/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Leave unset to sign in with OAuth in the browser. For an API key, send Bearer followed by the key (it starts with aybox_).",
      "default": "Bearer {api_key}"
    }
  ]
}
