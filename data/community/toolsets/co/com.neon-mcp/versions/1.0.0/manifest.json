{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-09-17T20:38:56.695242Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.neon.tech/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization",
      "x-read-only"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional Bearer token with a Neon API key",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional Bearer token with a Neon API key."
    },
    {
      "id": "x-read-only",
      "envVar": "x-read-only",
      "label": "Optional header to enable read-only mode for tool filtering",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional header to enable read-only mode for tool filtering.",
      "default": "false"
    }
  ]
}
