{
  "schemaVersion": 1,
  "version": "1.0.2",
  "releasedAt": "2026-11-05T20:44:30.461241Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://agents.dna.codes/o/{org}/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token from registration (sandbox) or the authorization server for this organization",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token from registration (sandbox) or the authorization server for this organization."
    }
  ]
}
