{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-18T08:07:13.860333Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.chatterapi.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <your ChatterAPI key>",
