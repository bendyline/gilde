  "tools": [],
  "config": [
    {
      "id": "MQ_API_KEY",
      "envVar": "MQ_API_KEY",
      "label": "MsgMesh API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "MsgMesh API key. Sign one (admin scope recommended) at https://msgmesh-panel.alderflux.com Keys page.",
      "placeholder": "mk_xxxxxxxx"
    },
    {
      "id": "MQ_CONTROL_PLANE_URL",
      "envVar": "MQ_CONTROL_PLANE_URL",
      "label": "Control-plane base URL",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Control-plane base URL. Leave unset to use the hosted MsgMesh service.",
      "default": "https://msgmesh-api.alderflux.com"
    },
    {
      "id": "MQ_GATEWAY_URL",
      "envVar": "MQ_GATEWAY_URL",
      "label": "Gateway (publish/consume) base URL",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Gateway (publish/consume) base URL. Leave unset to use the hosted MsgMesh service.",
      "default": "https://msgmesh-api.alderflux.com"
    },
    {
      "id": "MQ_REALTIME_URL",
      "envVar": "MQ_REALTIME_URL",
      "label": "Realtime (presence) base URL",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Realtime (presence) base URL. Leave unset to use the hosted MsgMesh service.",
      "default": "https://msgmesh-api.alderflux.com"
    }
