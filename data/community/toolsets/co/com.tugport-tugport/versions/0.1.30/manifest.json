{
  "schemaVersion": 1,
  "version": "0.1.30",
  "releasedAt": "2026-10-28T14:57:45.347915Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{panel_host}/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer API key from your Tugport panel; the agent gets exactly that key's roles and grants",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer API key from your Tugport panel; the agent gets exactly that key's roles and grants",
      "default": "Bearer {api_key}"
    }
  ]
}
