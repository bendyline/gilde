{
  "schemaVersion": 1,
  "version": "0.1.2",
  "releasedAt": "2026-07-17T05:08:53.592008Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.green-api.com/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-Instance-Id",
      "X-Api-Token"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-Instance-Id",
      "envVar": "X-Instance-Id",
      "label": "Green API instance ID",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Green API instance ID"
    },
    {
      "id": "X-Api-Token",
      "envVar": "X-Api-Token",
      "label": "Green API instance token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Green API instance token"
    }
  ]
}
