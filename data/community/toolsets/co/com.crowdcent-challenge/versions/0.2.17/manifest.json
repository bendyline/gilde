  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.crowdcent.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <your CrowdCent API key>, from crowdcent",
