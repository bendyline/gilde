{
  "schemaVersion": 1,
  "version": "0.1.12",
  "releasedAt": "2026-09-08T14:55:01.508055Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.ipinfo.io/",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your IPinfo API token as a bearer credential",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your IPinfo API token as a bearer credential. Get a free one at https://ipinfo.io/signup",
      "default": "Bearer {ipinfo_token}"
    }
  ]
}
