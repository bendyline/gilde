{
  "schemaVersion": 1,
  "version": "1.2.0",
  "releasedAt": "2026-06-23T09:12:33.501546Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.farofinance.app/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Faro API key as a Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Faro API key as a Bearer token. Get a key at https://farofinance.app (format: Bearer faro_live_…)"
    }
  ]
