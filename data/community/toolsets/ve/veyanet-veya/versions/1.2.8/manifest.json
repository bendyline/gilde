{
  "schemaVersion": 1,
  "version": "1.2.8",
  "releasedAt": "2026-10-21T12:13:18.595249Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.veyanet.tech/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer API key from app",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer API key from app.veyanet.tech (System → API Keys). Format: Bearer <key>",
      "default": "Bearer {veya_api_key}"
    }
  ]
}
