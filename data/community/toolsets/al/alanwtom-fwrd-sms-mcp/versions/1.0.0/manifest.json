{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-11-08T22:14:54.35501Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{worker_host}/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <MCP_TOKEN>, the secret you set on your Worker",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <MCP_TOKEN>, the secret you set on your Worker"
    }
  ]
}
