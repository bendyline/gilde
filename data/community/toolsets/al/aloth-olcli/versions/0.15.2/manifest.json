{
  "schemaVersion": 1,
  "version": "0.15.2",
  "releasedAt": "2026-10-26T12:02:31.690512Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@aloth/olcli",
    "version": "0.15.2",
    "sha256": "5a61b53504c6b6af60b3eb54a669a997fb0e0b01031e175ffd3bf72bf609b953",
    "entry": "dist/remote-helper.js",
    "args": [
      "olcli-mcp"
    ],
    "envHints": [
      "OVERLEAF_SESSION",
      "OVERLEAF_BASE_URL",
      "OVERLEAF_COOKIE_NAME"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "OVERLEAF_SESSION",
      "envVar": "OVERLEAF_SESSION",
      "label": "Overleaf session cookie value (overleaf_session2 on overleaf",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Overleaf session cookie value (overleaf_session2 on overleaf.com)"
    },
    {
      "id": "OVERLEAF_BASE_URL",
      "envVar": "OVERLEAF_BASE_URL",
      "label": "Base URL of a self-hosted Overleaf instance",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Base URL of a self-hosted Overleaf instance",
      "default": "https://www.overleaf.com"
    },
    {
      "id": "OVERLEAF_COOKIE_NAME",
      "envVar": "OVERLEAF_COOKIE_NAME",
      "label": "Session cookie name, for self-hosted instances that use overleaf",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Session cookie name, for self-hosted instances that use overleaf.sid",
      "default": "overleaf_session2"
    }
  ]
}
