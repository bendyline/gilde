      "id": "OPENSOLAR_API_TOKEN",
      "envVar": "OPENSOLAR_API_TOKEN",
      "label": "OpenSolar bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "OpenSolar bearer token"
    },
    {
      "id": "OPENSOLAR_ORG_ID",
      "envVar": "OPENSOLAR_ORG_ID",
      "label": "OpenSolar organisation ID",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "OpenSolar organisation ID",
      "placeholder": "12345"
    },
    {
      "id": "OPENSOLAR_PROFILE",
      "envVar": "OPENSOLAR_PROFILE",
