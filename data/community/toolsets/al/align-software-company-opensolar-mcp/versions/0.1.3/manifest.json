      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Comma-separated toolsets that replace the profile's tool selection",
      "placeholder": "projects,contacts,systems"
    },
    {
      "id": "OPENSOLAR_UPLOAD_ROOT",
      "envVar": "OPENSOLAR_UPLOAD_ROOT",
      "label": "Directory that create_private_file may read from; uploads stay disabled when unset",
