      "multiline": false,
      "description": "Tool profile: agent (curated default) or full (every registered tool)",
      "default": "agent",
      "options": [
        "agent",
        "full"
      ]
    },
    {
      "id": "OPENSOLAR_READ_ONLY",
      "envVar": "OPENSOLAR_READ_ONLY",
      "label": "Hide every tool that can change OpenSolar data",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Hide every tool that can change OpenSolar data",
      "default": "false"
    },
    {
      "id": "OPENSOLAR_PLAN",
      "envVar": "OPENSOLAR_PLAN",
      "label": "OpenSolar access plan; api_access hides tools that need Raw Data API Access",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "OpenSolar access plan; api_access hides tools that need Raw Data API Access",
      "options": [
        "api_access",
        "raw_data"
      ]
    },
    {
      "id": "OPENSOLAR_TOOLSETS",
      "envVar": "OPENSOLAR_TOOLSETS",
      "label": "Comma-separated toolsets that replace the profile's tool selection",
