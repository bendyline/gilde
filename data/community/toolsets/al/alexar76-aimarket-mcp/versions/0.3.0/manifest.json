{
  "schemaVersion": 1,
  "version": "0.3.0",
  "releasedAt": "2026-08-16T20:44:18.893109Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{aimarket_host}/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token matching AIMARKET_MCP_KEY when auth is enabled",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer token matching AIMARKET_MCP_KEY when auth is enabled"
    }
  ]
}
