{
  "schemaVersion": 1,
  "version": "0.2.24",
  "releasedAt": "2026-04-29T12:01:05.646512Z",
  "runtime": {
    "kind": "npm-package",
    "package": "suprsend",
    "version": "0.2.24",
    "sha256": "bdb83fb4137c777b2afe5f2daaea8b446a805cae42aa07cde99d31236ade42c3",
    "entry": "bin/suprsend.js",
    "args": ["start-mcp-server", "--workflows", "all"],
    "envHints": ["SUPRSEND_SERVICE_TOKEN", "SUPRSEND_BASE_URL", "SUPRSEND_MGMNT_URL"]
  },
  "tools": [],
  "config": [
    {
      "id": "SUPRSEND_SERVICE_TOKEN",
      "envVar": "SUPRSEND_SERVICE_TOKEN",
      "label": "SuprSend service token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "SuprSend service token. Create one in the SuprSend dashboard under Developers → API Keys."
    },
    {
      "id": "SUPRSEND_BASE_URL",
      "envVar": "SUPRSEND_BASE_URL",
      "label": "Base API URL",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Base API URL. Only set for BYOC / self-hosted SuprSend instances."
    },
    {
      "id": "SUPRSEND_MGMNT_URL",
      "envVar": "SUPRSEND_MGMNT_URL",
      "label": "Management API URL",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Management API URL. Only set for BYOC / self-hosted SuprSend instances."
    }
  ]
}
