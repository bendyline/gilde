{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-07-10T05:16:29.298653Z",
  "runtime": {
    "kind": "npm-package",
    "package": "suprsend",
    "version": "1.0.1",
    "sha256": "d5e165354764f807c2716f5d53d85992eea1c8b7fda517861e859512b4f9d9ea",
    "entry": "bin/suprsend.js",
    "args": [
      "start-mcp-server",
      "--workflows",
      "all"
    ],
    "envHints": [
      "SUPRSEND_SERVICE_TOKEN",
      "SUPRSEND_BASE_URL",
      "SUPRSEND_MGMNT_URL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "SUPRSEND_SERVICE_TOKEN",
      "envVar": "SUPRSEND_SERVICE_TOKEN",
      "label": "SuprSend service token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "SuprSend service token. Create one in the SuprSend dashboard under Developers → API Keys."
    },
    {
      "id": "SUPRSEND_BASE_URL",
      "envVar": "SUPRSEND_BASE_URL",
      "label": "Base API URL",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Base API URL. Only set for BYOC / self-hosted SuprSend instances."
    },
    {
      "id": "SUPRSEND_MGMNT_URL",
      "envVar": "SUPRSEND_MGMNT_URL",
      "label": "Management API URL",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Management API URL. Only set for BYOC / self-hosted SuprSend instances."
    }
  ]
}
