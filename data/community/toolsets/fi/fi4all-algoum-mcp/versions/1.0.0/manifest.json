{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-11T11:02:36.337759Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.algoum.de/v1/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your algoum API key as a bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your algoum API key as a bearer token. Create it in the dashboard of the algoum portal (https://algoum.de/).",
      "default": "Bearer {api_key}"
    }
  ]
}
