{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-28T07:07:24.981731Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.awaken.tax/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. ChatGPT, Claude, Cursor and Grok sign in with OAuth and need no header. Other clients: Bearer <portfolio ID>:<API key> from Awaken Settings > API Keys.",
      "placeholder": "Bearer <portfolioId>:<apiKey>"
    }
  ]
}
