{
  "schemaVersion": 1,
  "version": "1.0.3",
  "releasedAt": "2026-09-26T01:53:02.479063Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.turingcorp.net/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <Agent Pass>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <Agent Pass>. Obtain a pass at https://agent-pass.turingcorp.net (self-service signup, email verification, then top up). A pass is valid for 7 days and can be re-rolled.",
      "default": "Bearer {agent_pass}"
    }
  ]
}
