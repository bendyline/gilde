{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-05-20T20:38:46.785287Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.honeylabs.net/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <hlk_…> API key from https://honeylabs",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <hlk_…> API key from https://honeylabs.net/dashboard. OAuth 2.1 with PKCE is also supported (DCR endpoint at /oauth/register)."
    }
  ]
}
