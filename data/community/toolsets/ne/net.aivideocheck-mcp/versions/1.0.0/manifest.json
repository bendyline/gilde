{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-01T12:13:46.815423Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.aivideocheck.net/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your AI Video Check API key as a Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your AI Video Check API key as a Bearer token. Create one at https://www.aivideocheck.net/en/dashboard/api",
      "default": "Bearer {api_key}"
    }
  ]
}
