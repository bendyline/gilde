{
  "schemaVersion": 1,
  "version": "0.13.0",
  "releasedAt": "2026-10-31T01:56:30.269225Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://37soul.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional: a 37soul",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional: a 37soul.com/agent_access token. Omit it and the client signs in with OAuth.",
      "default": "Bearer {api_token}"
    }
  ]
}
