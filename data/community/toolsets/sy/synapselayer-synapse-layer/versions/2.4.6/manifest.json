{
  "schemaVersion": 1,
  "version": "2.4.6",
  "releasedAt": "2026-09-16T07:28:33.215992Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://forge.synapselayer.org/api/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "x-connect-token"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-connect-token",
      "envVar": "x-connect-token",
      "label": "Connect token for API authentication (sk_connect_*)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Connect token for API authentication (sk_connect_*). Obtain via Forge → Dashboard → Connect."
    }
  ]
}
