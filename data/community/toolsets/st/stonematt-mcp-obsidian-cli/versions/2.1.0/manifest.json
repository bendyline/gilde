    {
      "id": "OBSIDIAN_VAULT",
      "envVar": "OBSIDIAN_VAULT",
      "label": "Target vault name",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Target vault name. If unset or unknown, the server prompts the caller on first tool use, listing the vaults Obsidian knows about."
