{
  "schemaVersion": 1,
  "version": "2.1.0",
  "releasedAt": "2026-11-10T01:57:49.514656Z",
  "runtime": {
    "kind": "npm-package",
    "package": "framelens",
    "version": "2.1.0",
    "sha256": "5785ae0b7df697829d572e80e7425ee74b92a027b45c8e91fab0fdff2429df02",
    "entry": "dist/framelens.mjs",
    "args": [],
    "envHints": [
      "GEMINI_API_KEY",
      "GEMINI_MODEL_NAME",
      "FRAMELENS_WORKSPACE",
      "FRAMELENS_AUTO_INSTALL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "GEMINI_API_KEY",
      "envVar": "GEMINI_API_KEY",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Google Gemini API key, only for the Gemini YouTube tools; the local tools need no key."
    },
    {
      "id": "GEMINI_MODEL_NAME",
      "envVar": "GEMINI_MODEL_NAME",
      "label": "Optional",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional. Gemini model for the Gemini tools.",
      "default": "gemini-flash-lite-latest"
    },
    {
      "id": "FRAMELENS_WORKSPACE",
      "envVar": "FRAMELENS_WORKSPACE",
      "label": "Optional",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional. Folder for results; defaults to .framelens in the working folder (or ~/.framelens)."
    },
    {
      "id": "FRAMELENS_AUTO_INSTALL",
      "envVar": "FRAMELENS_AUTO_INSTALL",
      "label": "Optional",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional. Set to 0 to stop the automatic, hash-checked download of a missing ffmpeg or yt-dlp.",
      "options": [
        "0",
        "1"
      ]
    }
  ]
}
