{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-11-11T11:23:55.461769Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.mayar.id/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Mayar production API key from https://web",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Mayar production API key from https://web.mayar.id/api-keys (the Bearer prefix is optional)"
    }
  ]
}
