{
  "schemaVersion": 1,
  "version": "0.1.11",
  "releasedAt": "2026-11-05T13:34:22.033406Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@locli/cli",
    "version": "0.1.11",
    "sha256": "a0554dc0d9cd25de819cfee451c2371681d5822df94abb3b06bbf7962f2a5e77",
    "entry": "bin/locli.js",
    "args": [
      "mcp"
    ],
    "envHints": [
      "LOCLI_TOKEN",
      "LOCLI_CONFIG",
      "LOCLI_API_URL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "LOCLI_TOKEN",
      "envVar": "LOCLI_TOKEN",
      "label": "locli API token (CI)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "locli API token (CI). Locally, run `npx @locli/cli login` instead."
    },
    {
      "id": "LOCLI_CONFIG",
      "envVar": "LOCLI_CONFIG",
      "label": "Path to locli",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Path to locli.json (default: nearest locli.json from the working directory)."
    },
    {
      "id": "LOCLI_API_URL",
      "envVar": "LOCLI_API_URL",
      "label": "locli server (default: https://locli",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "locli server (default: https://locli.dev)."
    }
  ]
}
