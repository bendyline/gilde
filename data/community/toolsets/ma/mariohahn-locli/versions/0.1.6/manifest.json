{
  "schemaVersion": 1,
  "version": "0.1.6",
  "releasedAt": "2026-10-31T08:09:24.548595Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@locli/cli",
    "version": "0.1.6",
    "sha256": "e45432b34b8cb3aa1bf0337532852d873e4b439af41529fab550634a2c96fd6a",
    "entry": "bin/locli.js",
    "args": [
      "mcp"
    ],
    "envHints": [
      "LOCLI_TOKEN",
      "LOCLI_CONFIG",
      "LOCLI_API_URL"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "LOCLI_TOKEN",
      "envVar": "LOCLI_TOKEN",
      "label": "locli API token (CI)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "locli API token (CI). Locally, run `npx @locli/cli login` instead."
    },
    {
      "id": "LOCLI_CONFIG",
      "envVar": "LOCLI_CONFIG",
      "label": "Path to locli",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Path to locli.json (default: nearest locli.json from the working directory)."
    },
    {
      "id": "LOCLI_API_URL",
      "envVar": "LOCLI_API_URL",
      "label": "locli server (default: https://locli",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "locli server (default: https://locli.dev)."
    }
  ]
}
