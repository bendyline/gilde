  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.mailercloud.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "OAuth 2",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "OAuth 2.1 bearer token (or a Mailercloud API key sent as 'Bearer <key>')."
    }
  ]
