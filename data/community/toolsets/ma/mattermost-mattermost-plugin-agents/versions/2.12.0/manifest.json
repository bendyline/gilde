{
  "schemaVersion": 1,
  "version": "2.12.0",
  "releasedAt": "2026-11-03T18:30:33.281543Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{mattermost_host}/plugins/mattermost-ai/mcp-server/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. OAuth 2.0 with dynamic client registration is the default and needs no header. To use a Mattermost Personal Access Token instead, set this to Bearer followed by the token.",
      "default": "Bearer {personal_access_token}"
    }
  ]
}
