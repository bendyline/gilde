      "placeholder": "https://chatcrystal.example.com"
    },
    {
      "id": "CHATCRYSTAL_API_TOKEN",
      "envVar": "CHATCRYSTAL_API_TOKEN",
      "label": "Optional token for a protected ChatCrystal Cloud or remote instance",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional token for a protected ChatCrystal Cloud or remote instance."
    }
  ]
