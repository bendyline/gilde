    "entry": "dist/server/src/cli/index.js",
    "args": [
      "mcp"
    ],
    "envHints": [
      "CHATCRYSTAL_BASE_URL",
      "CHATCRYSTAL_API_TOKEN"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "CHATCRYSTAL_BASE_URL",
      "envVar": "CHATCRYSTAL_BASE_URL",
      "label": "Optional ChatCrystal Core URL",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
