{
  "schemaVersion": 1,
  "version": "0.7.1",
  "releasedAt": "2026-11-11T17:00:59.772363Z",
  "runtime": {
    "kind": "npm-package",
    "package": "chatcrystal",
    "version": "0.7.1",
