{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-11-12T19:46:13.483141Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://systra.tools/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Without a key the free components work. For the full library, create a Premium key at https://systra.tools/mcp",
      "default": "Bearer {systra_mcp_key}"
    }
  ]
}
