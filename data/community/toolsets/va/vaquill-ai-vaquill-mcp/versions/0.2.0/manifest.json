{
  "schemaVersion": 1,
  "version": "0.2.0",
  "releasedAt": "2026-08-08T10:44:16.596593Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.vaquill.ai/s/_",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token using a Vaquill API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token using a Vaquill API key. Format: 'Bearer vq_key_...'. Get a key at https://www.vaquill.ai/legal-api."
    }
  ]
}
