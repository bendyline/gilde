{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-05-15T05:21:53.271948Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://courtlistener-mcp.vaquill.ai/mcp/",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-CourtListener-Token"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-CourtListener-Token",
      "envVar": "X-CourtListener-Token",
      "label": "Your free CourtListener API token from https://www",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your free CourtListener API token from https://www.courtlistener.com/help/api/rest/. The server never stores your key."
    }
  ]
}
