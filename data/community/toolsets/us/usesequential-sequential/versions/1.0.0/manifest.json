{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-11-11T08:57:20.175223Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.usesequential.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <project access token>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <project access token>. Create the token in Sequential under Agents."
    }
  ]
}
