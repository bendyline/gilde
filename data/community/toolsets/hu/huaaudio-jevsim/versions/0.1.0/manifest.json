  "runtime": {
    "kind": "npm-package",
    "package": "@huaaudio/jevsim",
    "version": "0.1.0",
    "sha256": "d3029f8e8f47d8e67840f71f20c65325516b89a2fe60bc5041ec27f17c609819",
    "entry": "dist/server.js",
    "args": [],
    "envHints": [
      "TYPESAFE_API_KEY",
      "JEVSIM_MODEL",
      "JEVSIM_XCODE_COMMAND",
      "JEVSIM_XCODE_ARGS",
      "JEVSIM_ANDROID_APPIUM_URL",
      "JEVSIM_ADB_COMMAND"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "TYPESAFE_API_KEY",
      "envVar": "TYPESAFE_API_KEY",
      "label": "TypeSafe API key for semantic selection",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "TypeSafe API key for semantic selection. Exact-identifier workflows need no key."
    },
    {
      "id": "JEVSIM_MODEL",
      "envVar": "JEVSIM_MODEL",
      "label": "TypeSafe selection model",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "TypeSafe selection model.",
      "default": "jev-latest"
    },
    {
      "id": "JEVSIM_XCODE_COMMAND",
      "envVar": "JEVSIM_XCODE_COMMAND",
      "label": "iOS only: XcodeBuildMCP executable",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "iOS only: XcodeBuildMCP executable. Use an absolute path if needed.",
      "default": "npx"
    },
    {
      "id": "JEVSIM_XCODE_ARGS",
      "envVar": "JEVSIM_XCODE_ARGS",
      "label": "iOS only: JSON array of XcodeBuildMCP arguments",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "iOS only: JSON array of XcodeBuildMCP arguments.",
      "default": "[\"-y\",\"xcodebuildmcp@2.7.0\",\"mcp\"]"
    },
    {
      "id": "JEVSIM_ANDROID_APPIUM_URL",
      "envVar": "JEVSIM_ANDROID_APPIUM_URL",
      "label": "Android only: separately running Appium 3/UIAutomator2 server on loopback",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Android only: separately running Appium 3/UIAutomator2 server on loopback.",
      "default": "http://127.0.0.1:4723"
    },
    {
      "id": "JEVSIM_ADB_COMMAND",
      "envVar": "JEVSIM_ADB_COMMAND",
      "label": "Android only: adb executable",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Android only: adb executable. Use an absolute path if needed.",
      "default": "adb"
    }
  ]
}
