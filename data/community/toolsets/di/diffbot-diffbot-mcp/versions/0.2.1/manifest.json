{
  "schemaVersion": 1,
  "version": "0.2.1",
  "releasedAt": "2026-11-10T20:29:38.247722Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.diffbot.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Diffbot token as 'Bearer <token>' for clients without OAuth. Free token: https://app.diffbot.com/get-started",
      "default": "Bearer {diffbot_token}"
    }
  ]
}
