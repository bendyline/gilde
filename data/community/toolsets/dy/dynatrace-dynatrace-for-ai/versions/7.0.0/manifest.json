{
  "schemaVersion": 1,
  "version": "7.0.0",
  "releasedAt": "2026-08-31T07:39:06.514514Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{environment_id}.apps.dynatrace.com/platform-reserved/mcp-gateway/v0.1/servers/dynatrace-mcp/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization",
      "X-Http-Source"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Dynatrace Platform Token with MCP gateway scopes",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Dynatrace Platform Token with MCP gateway scopes",
      "default": "Bearer {platform_token}"
    },
    {
      "id": "X-Http-Source",
      "envVar": "X-Http-Source",
      "label": "X-Http-Source",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "default": "dynatrace-for-ai/7.0.0"
    }
  ]
}
