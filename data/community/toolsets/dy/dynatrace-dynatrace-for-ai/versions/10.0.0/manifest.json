{
  "schemaVersion": 1,
  "version": "10.0.0",
  "releasedAt": "2026-11-03T11:58:16.906282Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{environment_id}.apps.dynatrace.com/platform-reserved/mcp-gateway/v0.1/servers/dynatrace-mcp/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization",
      "Dt-External-Source"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Dynatrace Platform Token with MCP gateway scopes",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Dynatrace Platform Token with MCP gateway scopes",
      "default": "Bearer {platform_token}"
    },
    {
      "id": "Dt-External-Source",
      "envVar": "Dt-External-Source",
      "label": "Dt-External-Source",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "default": "dynatrace-for-ai/10.0.0"
    }
  ]
}
