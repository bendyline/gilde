{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-09T14:28:14.0478Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://control.boardroom-ai.ae/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <token>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <token>. The workspace owner issues and revokes it in Integrations > API and MCP."
    }
  ]
