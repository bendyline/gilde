{
  "schemaVersion": 1,
  "version": "0.1.5",
  "releasedAt": "2026-10-28T21:04:35.000259Z",
  "runtime": {
    "kind": "npm-package",
    "package": "airlox",
    "version": "0.1.5",
    "sha256": "a5e311fcc7bbd287e3df2c3d3585a6c5495b3082517f2cd2e48c3dc041a68028",
    "entry": "bin/airlox.js",
    "args": [
      "mcp",
      "--allow-dir"
    ],
    "envHints": [
      "AIRLOX_OWNER_INVITE_DIR",
      "AIRLOX_NAME",
      "AIRLOX_RELAY"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "AIRLOX_OWNER_INVITE_DIR",
      "envVar": "AIRLOX_OWNER_INVITE_DIR",
      "label": "Where to save the owner link of each session the agent creates, for you to open",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Where to save the owner link of each session the agent creates, for you to open. The tools cannot read it."
    },
    {
      "id": "AIRLOX_NAME",
      "envVar": "AIRLOX_NAME",
      "label": "The name other participants see",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "The name other participants see.",
      "default": "mcp"
    },
    {
      "id": "AIRLOX_RELAY",
      "envVar": "AIRLOX_RELAY",
      "label": "The relay for new sessions (for a self-hosted relay)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "The relay for new sessions (for a self-hosted relay).",
      "default": "https://airlox.app"
    }
  ]
}
