{
  "schemaVersion": 1,
  "version": "0.8.0",
  "releasedAt": "2026-10-17T10:53:24.174989Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{ramen_edge}/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization",
      "ramen-group",
      "ramen-zone"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Group MCP key, or use OAuth sign-in instead",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Group MCP key, or use OAuth sign-in instead",
      "default": "Bearer {key}"
    },
    {
      "id": "ramen-group",
      "envVar": "ramen-group",
      "label": "Ramen group to route to",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Ramen group to route to",
      "default": "{group}"
    },
    {
      "id": "ramen-zone",
      "envVar": "ramen-zone",
      "label": "Ramen zone to route to",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Ramen zone to route to",
      "default": "{zone}"
    }
  ]
}
