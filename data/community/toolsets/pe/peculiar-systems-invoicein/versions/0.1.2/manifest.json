{
  "schemaVersion": 1,
  "version": "0.1.2",
  "releasedAt": "2026-09-10T14:57:36.165209Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://invoicein-api.peculiar.systems/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-Api-Key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-Api-Key",
      "envVar": "X-Api-Key",
      "label": "InvoiceIn API key",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "InvoiceIn API key. Optional: without it the demo quota of 20 invoices a day per IP applies."
    }
  ]
}
