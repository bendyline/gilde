{
  "schemaVersion": 1,
  "version": "3.1.0",
  "releasedAt": "2026-10-26T15:26:11.803856Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://app.nynch.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <your Nynch MCP API key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <your Nynch MCP API key>. Create one in Nynch: Settings > Integrations > Claude & AI Assistants. Docs: https://www.nynch.com/developers"
    }
  ]
}
