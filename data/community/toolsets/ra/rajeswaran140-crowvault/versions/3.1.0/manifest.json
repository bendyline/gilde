{
  "schemaVersion": 1,
  "version": "3.1.0",
  "releasedAt": "2026-11-16T15:19:00.906173Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.crowvault.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "CrowVault API key (starts with cv_)",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "CrowVault API key (starts with cv_). Free key with 50 calls/month at https://crowvault.ai/register",
      "default": "Bearer {api_key}"
    }
  ]
}
