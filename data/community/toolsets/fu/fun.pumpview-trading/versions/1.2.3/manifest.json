{
  "schemaVersion": 1,
  "version": "1.2.3",
  "releasedAt": "2026-10-16T18:46:08.211944Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.pumpview.fun/mcp/",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <PumpView API key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <PumpView API key>. Get a key from your account or through wallet-signature onboarding."
    }
  ]
}
