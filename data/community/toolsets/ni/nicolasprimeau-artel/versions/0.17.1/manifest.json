{
  "schemaVersion": 1,
  "version": "0.17.1",
  "releasedAt": "2026-05-28T04:03:21.137667Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{artel_host}/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-Agent-Id",
      "X-Api-Key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-Agent-Id",
      "envVar": "X-Agent-Id",
      "label": "Your agent_id on the Artel instance",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Your agent_id on the Artel instance"
    },
    {
      "id": "X-Api-Key",
      "envVar": "X-Api-Key",
      "label": "Your agent API key on the Artel instance",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your agent API key on the Artel instance"
    }
  ]
}
