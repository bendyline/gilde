      "id": "THREE_WS_API_KEY",
      "envVar": "THREE_WS_API_KEY",
      "label": "A three",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "A three.ws API key (sk_live_… / sk_test_…) or OAuth access token. Optional: needed only for knock_inbox and knock_act, which manage your own door. Quoting, browsing, knocking and reading a receipt all work without it. Treat like a password."
    },
    {
      "id": "THREE_WS_BASE",
      "envVar": "THREE_WS_BASE",
      "label": "Base URL of the three",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Base URL of the three.ws API. Override only when self-hosting or targeting a preview deployment.",
      "default": "https://three.ws"
    },
    {
      "id": "THREE_WS_TIMEOUT_MS",
      "envVar": "THREE_WS_TIMEOUT_MS",
