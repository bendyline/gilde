{
  "schemaVersion": 1,
  "version": "1.29.0",
  "releasedAt": "2026-08-02T14:40:16.04551Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.layero.ru/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Layero token, issued at https://app",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Layero token, issued at https://app.layero.ru/settings/cli. Optional: building a landing works anonymously; publishing, domains and analytics need it.",
      "placeholder": "Bearer layero_ci_..."
    }
  ]
}
