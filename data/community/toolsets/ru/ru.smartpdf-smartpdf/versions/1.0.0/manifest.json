{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-04T20:02:02.416145Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.smartpdf.ru/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "SmartPDF API key with the Bearer prefix",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "SmartPDF API key with the Bearer prefix",
      "default": "Bearer {api_key}"
    }
  ]
}
