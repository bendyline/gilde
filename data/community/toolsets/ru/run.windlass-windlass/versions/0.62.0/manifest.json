{
  "schemaVersion": 1,
  "version": "0.62.0",
  "releasedAt": "2026-11-13T20:30:24.072329Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://{host}/api/v1/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer followed by a Windlass API token from Settings, API tokens",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer followed by a Windlass API token from Settings, API tokens"
    }
  ]
}
