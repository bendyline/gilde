{
  "schemaVersion": 1,
  "version": "0.2.0",
  "releasedAt": "2026-10-29T10:57:02.995274Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://proof.zketernity.app/agent/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer followed by your wallet key (starts with aw_)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer followed by your wallet key (starts with aw_). Get one with the create_wallet tool, which needs no key."
    }
  ]
}
