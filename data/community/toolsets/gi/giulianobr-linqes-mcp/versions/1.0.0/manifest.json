{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-11-15T19:34:55.252346Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://linq.es/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer personal API key generated in Linq",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Bearer personal API key generated in Linq.es Account Settings (/admin/account-settings)",
      "default": "Bearer {api_key}"
    }
  ]
}
