{
  "schemaVersion": 1,
  "version": "0.2.13",
  "releasedAt": "2026-09-06T17:30:06.343812Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://hatchloop.dev/mcp/agent-broker",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-Agent-Identity"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-Agent-Identity",
      "envVar": "X-Agent-Identity",
      "label": "Agent identity key",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Agent identity key. Free tier needs no key. Also accepted as 'Authorization: Bearer <key>' or 'X-Api-Key: <key>'."
    }
  ]
}
