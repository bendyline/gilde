{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-11-03T13:51:33.768885Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.finekot.com/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer token. Get a key with EUR 1 free credit: POST https://api.finekot.com/v1/keys {\"email\": \"...\"}",
      "default": "Bearer {api_key}"
    }
  ]
}
