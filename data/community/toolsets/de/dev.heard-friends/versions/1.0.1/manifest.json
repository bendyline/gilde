{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-10-06T02:15:50.026024Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.heard.dev/v1/mcp/share",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer key from https://heard",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer key from https://heard.dev/connect, written as: Bearer hgs_..."
    }
  ]
}
