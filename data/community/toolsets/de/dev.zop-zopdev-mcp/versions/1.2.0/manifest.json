{
  "schemaVersion": 1,
  "version": "1.2.0",
  "releasedAt": "2026-09-16T09:21:45.469168Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.zop.dev/mcp-server",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer token. Interactive clients obtain one automatically via OAuth 2.1 (no setup); CI and non-browser clients send a Zop personal access token."
    }
  ]
}
