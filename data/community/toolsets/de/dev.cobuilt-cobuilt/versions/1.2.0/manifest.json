{
  "schemaVersion": 1,
  "version": "1.2.0",
  "releasedAt": "2026-11-06T07:53:50.198282Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://cobuilt.dev/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your personal cobuilt agent token, sent as a bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your personal cobuilt agent token, sent as a bearer token.",
      "default": "Bearer {token}"
    }
  ]
}
