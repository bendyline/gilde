{
  "schemaVersion": 1,
  "version": "0.1.1",
  "releasedAt": "2026-09-01T04:48:50.69899Z",
  "runtime": {
    "kind": "npm-package",
    "package": "regionfetch-mcp",
    "version": "0.1.1",
    "sha256": "9dfe8c0304d215d8143da64717cd715fc6fb222a3c6be9d911a2047b26dbb32d",
    "entry": "dist/index.js",
    "args": [],
    "envHints": [
      "REGION_FETCH_WALLET_PRIVATE_KEY",
      "REGION_FETCH_MAX_PAYMENT",
      "REGION_FETCH_BASE_URL",
      "REGION_FETCH_PAYMENT_SIGNATURE"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "REGION_FETCH_WALLET_PRIVATE_KEY",
      "envVar": "REGION_FETCH_WALLET_PRIVATE_KEY",
      "label": "Private key of a funded Base wallet",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Private key of a funded Base wallet. The server signs one fresh x402 authorization per tool call. Keep it in the host's env block; it is never a tool argument."
    },
    {
      "id": "REGION_FETCH_MAX_PAYMENT",
      "envVar": "REGION_FETCH_MAX_PAYMENT",
      "label": "Per-payment ceiling, for example \"$0",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Per-payment ceiling, for example \"$0.10\". Use \"off\" to disable the cap.",
      "default": "$0.10"
    },
    {
      "id": "REGION_FETCH_BASE_URL",
      "envVar": "REGION_FETCH_BASE_URL",
      "label": "Deployment origin",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Deployment origin.",
      "default": "https://regionfetch.dev"
    },
    {
      "id": "REGION_FETCH_PAYMENT_SIGNATURE",
      "envVar": "REGION_FETCH_PAYMENT_SIGNATURE",
      "label": "A single pre-made x402 authorization",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "A single pre-made x402 authorization. Funds exactly one request, so this is for one-shot testing only; prefer the wallet key."
    }
  ]
}
