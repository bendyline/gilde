{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-30T03:02:20.220406Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.uberllm.dev/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your UberLLM API key, sent as a Bearer token",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Your UberLLM API key, sent as a Bearer token. Create one at https://uberllm.dev/dashboard/keys",
      "default": "Bearer {api_key}"
    }
  ]
}
