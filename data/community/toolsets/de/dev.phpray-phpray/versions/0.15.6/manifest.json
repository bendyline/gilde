{
  "schemaVersion": 1,
  "version": "0.15.6",
  "releasedAt": "2026-09-22T08:28:43.327985Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://phpray.dev/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <console token>",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer <console token>. Omit the header entirely to use the read-only public demo account."
    }
  ]
}
