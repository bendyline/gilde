{
  "schemaVersion": 1,
  "version": "1.0.6",
  "releasedAt": "2026-10-12T17:34:15.68375Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@octri/cli",
    "version": "1.0.6",
    "sha256": "facd1d783f6f9f09a301f8fb0c01d1e0b6f1d920c8a4b4a233a01e2e1485f505",
    "entry": "dist/bin.js",
    "args": [
      "mcp",
      "serve"
    ],
    "envHints": [
      "OCTRI_API_KEY",
      "OCTRI_PROJECT_ID",
      "OCTRI_PROFILE",
      "HTTPS_PROXY",
      "NO_PROXY"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "OCTRI_API_KEY",
      "envVar": "OCTRI_API_KEY",
      "label": "Octri API key",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Octri API key. Not needed if you have signed in with `octri auth login`."
    },
    {
      "id": "OCTRI_PROJECT_ID",
      "envVar": "OCTRI_PROJECT_ID",
      "label": "Project to use when a tool call names none",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Project to use when a tool call names none. Defaults to the CLI's selected project."
    },
    {
      "id": "OCTRI_PROFILE",
      "envVar": "OCTRI_PROFILE",
      "label": "Stored CLI profile to use instead of the current one",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Stored CLI profile to use instead of the current one."
    },
    {
      "id": "HTTPS_PROXY",
      "envVar": "HTTPS_PROXY",
      "label": "Proxy for requests to Octri, e",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Proxy for requests to Octri, e.g. http://proxy.internal:3128. Needed behind a corporate proxy, since MCP clients rarely pass your shell's environment through."
    },
    {
      "id": "NO_PROXY",
      "envVar": "NO_PROXY",
      "label": "Comma-separated hosts that skip HTTPS_PROXY",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Comma-separated hosts that skip HTTPS_PROXY."
    }
  ]
}
