      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Email associated with the API token"
    },
    {
      "id": "JIRA_API_TOKEN",
      "envVar": "JIRA_API_TOKEN",
      "label": "Scoped API token from https://id",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
