  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.fruitstand.dev/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer token — your Fruit Stand API key",
