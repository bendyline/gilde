{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-08-13T16:49:23.825885Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.lastping.dev",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <LastPing API key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <LastPing API key>. Create one at https://app.lastping.dev/app/connect — the key scopes every call to your project."
    }
  ]
}
