{
  "schemaVersion": 1,
  "version": "0.2.0",
  "releasedAt": "2026-09-20T05:03:15.325624Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://app.getcited.dev/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer API key created on Settings -> API keys",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer API key created on Settings -> API keys. Format: 'Bearer vseo_...'. Never put the key in the URL.",
      "placeholder": "Bearer vseo_..."
    }
  ]
}
