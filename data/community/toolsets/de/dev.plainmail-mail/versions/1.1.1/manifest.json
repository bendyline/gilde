{
  "schemaVersion": 1,
  "version": "1.1.1",
  "releasedAt": "2026-11-07T00:15:02.555332Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://app.plainmail.dev/api/mcp/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. The server supports OAuth: connect with no key and sign in with Plainmail. Alternatively send a Plainmail API key, created at https://app.plainmail.dev/settings",
      "default": "Bearer {api_key}"
    }
  ]
}
