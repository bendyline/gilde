{
  "schemaVersion": 1,
  "version": "0.1.3",
  "releasedAt": "2026-10-01T06:10:44.14841Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://datagokr.dev/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-DataGoKr-Key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-DataGoKr-Key",
      "envVar": "X-DataGoKr-Key",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Your personal data.go.kr service key; only needed to preview keyed (OPENAPI) datasets. Used per request, never stored."
    }
  ]
}
