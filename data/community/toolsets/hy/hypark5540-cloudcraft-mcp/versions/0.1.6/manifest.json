{
  "schemaVersion": 1,
  "version": "0.1.6",
  "releasedAt": "2026-07-23T03:21:34.243343Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@hypark5540/cloudcraft-mcp",
    "version": "0.1.6",
    "sha256": "92ef2778f86f0bfa55c880a9d814742418786621ddb4a877e9b7eaf138841f6c",
    "entry": "bin/cloudcraft-mcp.mjs",
    "args": [],
    "envHints": [
      "CLOUDCRAFT_API_KEY",
      "CLOUDCRAFT_BASE_URL",
      "CLOUDCRAFT_LOG_LEVEL",
      "CLOUDCRAFT_EXPORT_DIR",
      "CLOUDCRAFT_ENABLE_WRITES",
      "CLOUDCRAFT_ENABLE_DELETES",
      "CLOUDCRAFT_MAX_RESPONSE_BYTES"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "CLOUDCRAFT_API_KEY",
      "envVar": "CLOUDCRAFT_API_KEY",
      "label": "Cloudcraft API key with access to the target account",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Cloudcraft API key with access to the target account"
    },
    {
      "id": "CLOUDCRAFT_BASE_URL",
      "envVar": "CLOUDCRAFT_BASE_URL",
      "label": "Cloudcraft API base URL; HTTPS is required except for loopback testing",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Cloudcraft API base URL; HTTPS is required except for loopback testing",
      "default": "https://api.cloudcraft.co"
    },
    {
      "id": "CLOUDCRAFT_LOG_LEVEL",
      "envVar": "CLOUDCRAFT_LOG_LEVEL",
      "label": "Minimum log level written to stderr",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Minimum log level written to stderr",
      "default": "WARNING",
      "options": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ]
    },
    {
      "id": "CLOUDCRAFT_EXPORT_DIR",
      "envVar": "CLOUDCRAFT_EXPORT_DIR",
      "label": "Directory under which exported blueprint files may be written",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Directory under which exported blueprint files may be written"
    },
    {
      "id": "CLOUDCRAFT_ENABLE_WRITES",
      "envVar": "CLOUDCRAFT_ENABLE_WRITES",
      "label": "Enable create and update operations",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Enable create and update operations",
      "default": "false",
      "options": [
        "false",
        "true"
      ]
    },
    {
      "id": "CLOUDCRAFT_ENABLE_DELETES",
      "envVar": "CLOUDCRAFT_ENABLE_DELETES",
      "label": "Enable irreversible deletes; writes must also be enabled",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Enable irreversible deletes; writes must also be enabled",
      "default": "false",
      "options": [
        "false",
        "true"
      ]
    },
    {
      "id": "CLOUDCRAFT_MAX_RESPONSE_BYTES",
      "envVar": "CLOUDCRAFT_MAX_RESPONSE_BYTES",
      "label": "Maximum bytes accepted from one Cloudcraft API response",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Maximum bytes accepted from one Cloudcraft API response",
      "default": "26214400"
    }
  ]
}
