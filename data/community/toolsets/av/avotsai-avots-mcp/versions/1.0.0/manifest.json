  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.avots.ai/",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your av_mcp_ API key from avots",
