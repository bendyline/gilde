{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-11-16T09:49:39.816758Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://tool.modellix.ai/mcp/media",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Modellix API key in the Authorization bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Modellix API key in the Authorization bearer token.",
      "default": "Bearer {api_key}"
    }
  ]
}
