{
  "schemaVersion": 1,
  "version": "1.1.0",
  "releasedAt": "2026-11-07T22:57:20.456411Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mentionagent.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Leave it out to sign in with OAuth. Or Bearer <API key> from Settings, Agent access in the dashboard."
    }
  ]
}
