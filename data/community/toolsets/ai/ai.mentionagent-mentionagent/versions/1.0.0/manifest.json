{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-09-11T11:21:37.68972Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mentionagent.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <API key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <API key>. Keys are created in the MentionAgent dashboard under Settings, Agent access, and shown once."
    }
  ]
}
