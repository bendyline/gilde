{
  "schemaVersion": 1,
  "version": "1.6.7",
  "releasedAt": "2026-08-09T17:30:10.219846Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.statemind.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <key>. Get one for free, no account: curl -X POST https://api.statemind.ai/v1/keys"
    }
  ]
}
