{
  "schemaVersion": 1,
  "version": "1.2.2",
  "releasedAt": "2026-10-15T07:45:02.896498Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.specstream.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your SpecStream API key as a Bearer token",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Your SpecStream API key as a Bearer token. Create one under Agents & API in the workspace. Clients that support MCP sign-in can leave this empty.",
      "default": "Bearer {api_key}"
    }
  ]
}
