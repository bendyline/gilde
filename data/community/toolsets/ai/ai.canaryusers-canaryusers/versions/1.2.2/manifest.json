{
  "schemaVersion": 1,
  "version": "1.2.2",
  "releasedAt": "2026-06-13T18:31:58.336704Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://www.canaryusers.ai/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <your CanaryUsers API token>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <your CanaryUsers API token>. Generate it at canaryusers.ai/dashboard then CI & API, and toggle MCP on."
    }
  ]
}
