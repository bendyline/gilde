{
  "schemaVersion": 1,
  "version": "2.1.0",
  "releasedAt": "2026-06-04T12:38:06.605598Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://gateway.drillr.ai/mcp/data",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer drl_*",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer drl_*. Get a key at https://drillr.ai/developer/keys?ref=mp_registry"
    }
  ]
}
