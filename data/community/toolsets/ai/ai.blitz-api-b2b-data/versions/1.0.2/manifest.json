{
  "schemaVersion": 1,
  "version": "1.0.2",
  "releasedAt": "2026-10-19T12:34:28.754717Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.blitz-api.ai/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "x-api-key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-api-key",
      "envVar": "x-api-key",
      "label": "Your BlitzAPI API key",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Your BlitzAPI API key. Optional: leave empty to sign in with OAuth instead."
    }
  ]
}
