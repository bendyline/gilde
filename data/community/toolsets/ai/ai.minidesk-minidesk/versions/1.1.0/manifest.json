  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.minidesk.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Leave it out to sign in to miniDesk with OAuth. Or Bearer followed by an MCP token from Settings → MCP, for example: Bearer mdsk_mcp_..."
    }
  ]
}
