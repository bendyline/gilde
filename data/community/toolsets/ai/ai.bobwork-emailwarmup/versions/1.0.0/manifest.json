{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-11-02T13:29:36.928492Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://app-emailwarmup.bobwork.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "BobWork Email Warm-up API key (bwk_",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "BobWork Email Warm-up API key (bwk_...). An agent can get one with no browser: POST https://app-emailwarmup.bobwork.ai/api/v1/signup/code then /signup/verify.",
      "default": "Bearer {api_key}"
    }
  ]
}
