{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-06-10T05:44:10.419193Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.auralogs.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer aura_read_YOUR_KEY",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer aura_read_YOUR_KEY. Create a read-only project key in the Auralogs dashboard under Settings, API & MCP keys."
    }
  ]
}
