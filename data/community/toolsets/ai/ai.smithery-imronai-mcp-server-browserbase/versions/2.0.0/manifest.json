  "runtime": {
    "kind": "http-mcp",
    "url": "https://server.smithery.ai/@ImRonAI/mcp-server-browserbase/mcp",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
