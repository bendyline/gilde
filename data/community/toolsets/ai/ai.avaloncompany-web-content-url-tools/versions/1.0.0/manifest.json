{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-03T14:09:40.783985Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://avalonai--web-content-url-tools-mcp.apify.actor/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Apify API token as a Bearer token: Bearer <YOUR_APIFY_TOKEN>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Apify API token as a Bearer token: Bearer <YOUR_APIFY_TOKEN>",
      "default": "Bearer {apify_token}"
    }
  ]
}
