{
  "schemaVersion": 1,
  "version": "1.1.0",
  "releasedAt": "2026-10-29T17:54:00.535894Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://asms.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional: \"Bearer <asms API key>\" from https://asms",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional: \"Bearer <asms API key>\" from https://asms.ai/dashboard. Clients that support MCP sign-in (OAuth) don't need it."
    }
  ]
