{
  "schemaVersion": 1,
  "version": "0.2.3",
  "releasedAt": "2026-10-13T10:41:09.807463Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://everpod.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <your API key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <your API key>. The account's owner makes keys at https://everpod.ai/account/keys."
    }
  ]
}
