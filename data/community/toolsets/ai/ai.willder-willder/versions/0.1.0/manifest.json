{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-10-30T08:53:00.883425Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://willder.ai/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <capability token>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <capability token>. Issue one per agent in Access > Tokens; it is shown once.",
      "default": "Bearer {token}"
    }
  ]
}
