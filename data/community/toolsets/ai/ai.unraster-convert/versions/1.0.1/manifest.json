{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-11-08T05:05:27.743629Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://unraster.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <API key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <API key>. Create a key at https://unraster.ai/developers/api-keys"
    }
  ]
