{
  "schemaVersion": 1,
  "version": "1.3.0",
  "releasedAt": "2026-10-29T04:00:15.158393Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://youtube-transcript.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "API key sent as a Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "API key sent as a Bearer token. Create a free key at https://youtube-transcript.ai/get-api-key",
      "default": "Bearer {api_key}"
    }
  ]
}
