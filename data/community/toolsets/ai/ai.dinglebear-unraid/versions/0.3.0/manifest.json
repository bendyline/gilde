{
  "schemaVersion": 1,
  "version": "0.3.0",
  "releasedAt": "2026-08-04T14:11:59.281461Z",
  "runtime": {
    "kind": "npm-package",
    "package": "@dinglebear/unraid",
    "version": "0.3.0",
    "sha256": "b440593d0ee98c0715f99aeb7104c4af3ec8f5e9751a47093240ad3c51ca9649",
    "entry": "bin/runraid.js",
    "args": [
      "mcp"
    ],
    "envHints": [
      "UNRAID_API_URL",
      "UNRAID_API_KEY",
      "UNRAID_RMCP_VERSION",
      "UNRAID_RMCP_REPO",
      "UNRAID_RMCP_RELEASE_BASE_URL",
      "RUST_LOG"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "UNRAID_API_URL",
      "envVar": "UNRAID_API_URL",
      "label": "Full Unraid GraphQL endpoint URL",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Full Unraid GraphQL endpoint URL.",
      "placeholder": "https://unraid.example.com/graphql"
    },
    {
      "id": "UNRAID_API_KEY",
      "envVar": "UNRAID_API_KEY",
      "label": "Unraid API key",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Unraid API key."
    },
    {
      "id": "UNRAID_RMCP_VERSION",
      "envVar": "UNRAID_RMCP_VERSION",
      "label": "Optional GitHub release tag override for the downloaded Unraid RMCP binary",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional GitHub release tag override for the downloaded Unraid RMCP binary.",
      "placeholder": "v0.2.2"
    },
    {
      "id": "UNRAID_RMCP_REPO",
      "envVar": "UNRAID_RMCP_REPO",
      "label": "Optional GitHub owner/repo override for release asset downloads",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional GitHub owner/repo override for release asset downloads.",
      "default": "dinglebear-ai/unraid-mcp",
      "placeholder": "dinglebear-ai/unraid-mcp"
    },
    {
      "id": "UNRAID_RMCP_RELEASE_BASE_URL",
      "envVar": "UNRAID_RMCP_RELEASE_BASE_URL",
      "label": "Optional release download base URL override",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Optional release download base URL override."
    },
    {
      "id": "RUST_LOG",
      "envVar": "RUST_LOG",
      "label": "Tracing filter for Unraid RMCP logs",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Tracing filter for Unraid RMCP logs.",
      "default": "info",
      "placeholder": "info"
    }
  ]
}
