{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-11-11T13:35:44.223779Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.finvector.ai/v1/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer followed by your FinVector API key, from https://app",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer followed by your FinVector API key, from https://app.finvector.ai/keys",
      "default": "Bearer {api_key}"
    }
  ]
}
