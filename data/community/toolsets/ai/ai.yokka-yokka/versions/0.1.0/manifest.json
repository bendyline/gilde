{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-10-01T22:30:45.602589Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.yokka.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your Yokka workspace token as a bearer header",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your Yokka workspace token as a bearer header. Get it from the connect screen or Workspace settings → Agents.",
      "default": "Bearer {token}"
    }
  ]
}
