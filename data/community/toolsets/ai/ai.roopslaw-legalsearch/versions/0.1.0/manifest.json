{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-05-25T07:11:07.724108Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.roopslaw.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional bearer token for authenticated LegalSearch access",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional bearer token for authenticated LegalSearch access. Use: Bearer ${ROOP_PUBLIC_MCP_API_KEY}"
    }
  ]
}
