{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-04T17:03:17.839017Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://burrowbox.dev/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your Burrowbox API key (tmk_",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your Burrowbox API key (tmk_...), from Account → API keys at https://burrowbox.dev",
      "default": "Bearer {api_key}"
    }
  ]
}
