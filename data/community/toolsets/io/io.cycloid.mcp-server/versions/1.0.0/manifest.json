{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2025-10-08T10:47:05.417233Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.cycloid.io/mcp",
    "authHint": "none",
    "envHints": ["X-CY-API-KEY", "X-CY-ORG"]
  },
  "tools": [],
  "config": [
    {
      "id": "X-CY-API-KEY",
      "envVar": "X-CY-API-KEY",
      "label": "API key for authentication",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "API key for authentication"
    },
    {
      "id": "X-CY-ORG",
      "envVar": "X-CY-ORG",
      "label": "The organization canonical name (tenant) you want to interact with",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "The organization canonical name (tenant) you want to interact with"
    }
  ]
}
