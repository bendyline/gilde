{
  "schemaVersion": 1,
  "version": "1.0.3",
  "releasedAt": "2026-11-02T13:45:58.041393Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://app.tempost.io/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional when your client supports OAuth",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional when your client supports OAuth. Otherwise 'Bearer <key>' with a Tempost API key from app.tempost.io > Agents."
    }
  ]
}
