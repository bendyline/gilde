    "entry": "dist/index.js",
    "args": [],
    "envHints": [
      "DOCMAKE_API_KEY",
      "DOCMAKE_OUTPUT_DIR",
      "DOCMAKE_API_BASE"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "DOCMAKE_API_KEY",
      "envVar": "DOCMAKE_API_KEY",
      "label": "DocMake API key, created at app",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "DocMake API key, created at app.docmake.io under Settings > API Keys",
      "placeholder": "dm_your_key_here"
    },
    {
      "id": "DOCMAKE_OUTPUT_DIR",
      "envVar": "DOCMAKE_OUTPUT_DIR",
      "label": "Directory rendered documents are saved to",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Directory rendered documents are saved to. Defaults to ~/Downloads/DocMake"
    },
    {
      "id": "DOCMAKE_API_BASE",
      "envVar": "DOCMAKE_API_BASE",
      "label": "API base URL, for self-hosted setups",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "API base URL, for self-hosted setups. Defaults to https://app.docmake.io/api/v1",
      "default": "https://app.docmake.io/api/v1"
    }
  ]
}
