{
  "schemaVersion": 1,
  "version": "1.29.0",
  "releasedAt": "2026-10-05T19:06:09.38388Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.stockdrifts.io/mcp/",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <your StockDrifts API key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <your StockDrifts API key>. Create one at https://app.stockdrifts.io/settings/api-keys"
    }
  ]
}
