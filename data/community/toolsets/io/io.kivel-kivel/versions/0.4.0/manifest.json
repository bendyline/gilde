{
  "schemaVersion": 1,
  "version": "0.4.0",
  "releasedAt": "2026-11-13T21:00:07.948207Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://kivel.io/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Bearer token from a Kivel workspace (kv_...). Without it, agents can start a free trial or sign in with the start_login tool."
    }
  ]
}
