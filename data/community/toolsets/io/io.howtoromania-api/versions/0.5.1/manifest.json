{
  "schemaVersion": 1,
  "version": "0.5.1",
  "releasedAt": "2026-11-11T17:18:16.805801Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.howtoromania.io/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <api_key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <api_key>. Get a free key: POST https://api.howtoromania.io/v1/keys {\"email\":\"you@example.com\"}"
    }
  ]
}
