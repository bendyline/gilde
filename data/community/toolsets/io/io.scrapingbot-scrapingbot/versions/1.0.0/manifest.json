{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-03T22:14:49.423052Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://scrapingbot.io/api/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "x-api-key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "x-api-key",
      "envVar": "x-api-key",
      "label": "Your ScrapingBot API key, from https://scrapingbot",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your ScrapingBot API key, from https://scrapingbot.io/dashboard/api-keys (100 free credits on sign-up)."
    }
  ]
}
