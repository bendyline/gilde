{
  "schemaVersion": 1,
  "version": "2.5.0",
  "releasedAt": "2026-11-10T07:12:04.643565Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.vulntracker.io/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "VulnTracker API key as a bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "VulnTracker API key as a bearer token. Create one at https://vulntracker.io/settings/api-keys (free account: 30 read-only calls a day).",
      "default": "Bearer {api_key}"
    }
  ]
}
