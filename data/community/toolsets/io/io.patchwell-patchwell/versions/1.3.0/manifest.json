{
  "schemaVersion": 1,
  "version": "1.3.0",
  "releasedAt": "2026-11-08T23:27:33.584697Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://patchwell.io/mcp/",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <your Patchwell API key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <your Patchwell API key>. Free $1 key: POST https://patchwell.io/v1/credits/trial"
    }
  ]
}
