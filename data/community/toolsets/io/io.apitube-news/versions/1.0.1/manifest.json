{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-08-17T16:42:42.109069Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.apitube.io/",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <APITube API key> from apitube",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <APITube API key> from apitube.io. Requires a paid plan (Starter and up)."
    }
  ]
}
