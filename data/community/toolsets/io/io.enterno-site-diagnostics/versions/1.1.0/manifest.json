{
  "schemaVersion": 1,
  "version": "1.1.0",
  "releasedAt": "2026-10-20T06:46:25.267414Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://enterno.io/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your Enterno",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your Enterno.io API key as a Bearer token. Create a free key at https://enterno.io/en/register.",
      "default": "Bearer {api_key}"
    }
  ]
}
