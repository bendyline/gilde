{
  "schemaVersion": 1,
  "version": "2.1.0",
  "releasedAt": "2026-10-11T01:13:19.39758Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://packetexchange.io/mcp/http",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your PacketExchange API key as a Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Your PacketExchange API key as a Bearer token. Create one at https://packetexchange.io/dashboard/api-keys",
      "default": "Bearer {api_key}"
    }
  ]
}
