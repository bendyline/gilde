{
  "schemaVersion": 1,
  "version": "0.2.2",
  "releasedAt": "2026-10-29T12:36:21.36032Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://slopit.io/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <api_key>",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Bearer <api_key>. No key yet? Call the public signup tool first; it returns one."
    }
  ]
}
