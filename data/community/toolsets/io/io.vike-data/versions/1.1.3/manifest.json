{
  "schemaVersion": 1,
  "version": "1.1.3",
  "releasedAt": "2026-10-28T18:15:57.450795Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://data.vike.io/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-API-KEY"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-API-KEY",
      "envVar": "X-API-KEY",
      "label": "Vike API key from https://vike",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Vike API key from https://vike.io/account?tab=api-keys. Optional: OAuth 2.1 is also supported."
    }
  ]
}
