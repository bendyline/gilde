{
  "schemaVersion": 1,
  "version": "1.0.1",
  "releasedAt": "2026-09-29T12:57:53.888819Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.menso.io/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <your Menso API key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <your Menso API key>. Create the key at menso.io/settings (Settings, API key)."
    }
  ]
}
