{
  "schemaVersion": 1,
  "version": "1.0.3",
  "releasedAt": "2026-10-06T14:11:40.32611Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.aaly.io",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Prefer OAuth 2.1 + PKCE (browser consent). For CI/headless only: Bearer aaly_<id>_<secret> from https://app.aaly.io.",
      "placeholder": "Bearer aaly_<id>_<secret>"
    }
  ]
}
