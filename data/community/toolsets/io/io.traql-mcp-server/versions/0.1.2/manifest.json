    "entry": "dist/index.js",
    "args": [],
    "envHints": [
      "TRAQL_API_KEY",
      "TRAQL_API_URL",
      "TRAQL_TIMEOUT_MS"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "TRAQL_API_KEY",
      "envVar": "TRAQL_API_KEY",
      "label": "API key from https://app",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "API key from https://app.traql.io. Without it the server runs on the keyless tier: a coarse verdict, 3 free checks per IP per day, then payment-gated on the hosted API."
    },
    {
      "id": "TRAQL_API_URL",
      "envVar": "TRAQL_API_URL",
      "label": "Base URL of the traql API",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Base URL of the traql API. Override only when self-hosting.",
      "default": "https://api.traql.io"
    },
    {
      "id": "TRAQL_TIMEOUT_MS",
      "envVar": "TRAQL_TIMEOUT_MS",
      "label": "Per-request timeout in milliseconds",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Per-request timeout in milliseconds.",
      "default": "30000"
    }
  ]
}
