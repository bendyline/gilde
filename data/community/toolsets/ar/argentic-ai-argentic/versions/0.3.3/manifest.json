{
  "schemaVersion": 1,
  "version": "0.3.3",
  "releasedAt": "2026-11-10T10:25:35.718537Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://getargentic.com/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-Model-Key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-Model-Key",
      "envVar": "X-Model-Key",
      "label": "Your own key for the model provider your agents run on",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Your own key for the model provider your agents run on. Only needed to wake an agent; Argentic does not store it."
    }
  ]
}
