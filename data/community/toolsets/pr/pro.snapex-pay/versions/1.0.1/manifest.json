    {
      "id": "SNAPEX_BASE_URL",
      "envVar": "SNAPEX_BASE_URL",
      "label": "API base URL",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "API base URL.",
      "default": "https://pay.snapex.pro"
    },
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional: \"Bearer smk_…\" merchant API key",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional: \"Bearer smk_…\" merchant API key. Without it the agent calls create_account and the session goes on with the new key."
