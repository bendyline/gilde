{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-09-02T08:09:13.92117Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.aon.pro/v1/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <AON API key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <AON API key>. Use an issued live key from https://developer.aon.pro; no credential is embedded in this manifest."
    }
  ]
}
