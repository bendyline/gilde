{
  "schemaVersion": 1,
  "version": "0.3.0",
  "releasedAt": "2026-10-22T20:49:15.130767Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.prro.cloud/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Machine API token issued in the PRRO",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Machine API token issued in the PRRO.cloud cabinet",
      "default": "Bearer {token}"
    }
  ]
}
