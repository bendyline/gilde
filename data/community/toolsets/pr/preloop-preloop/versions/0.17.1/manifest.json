  "runtime": {
    "kind": "http-mcp",
    "url": "https://preloop.ai/mcp/v1",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. Preloop access token as 'Bearer <token>' (from 'preloop auth token'). OAuth-capable clients can omit it."
