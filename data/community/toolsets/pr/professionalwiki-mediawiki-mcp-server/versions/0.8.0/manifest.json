    "entry": "dist/index.js",
    "args": [],
    "envHints": [
      "CONFIG",
      "MCP_ALLOW_STATIC_FALLBACK",
      "MCP_CONTENT_MAX_BYTES",
      "MCP_TRANSPORT",
      "PORT"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "CONFIG",
      "envVar": "CONFIG",
      "label": "Path to your configuration file",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Path to your configuration file",
      "default": "config.json"
    },
    {
      "id": "MCP_ALLOW_STATIC_FALLBACK",
      "envVar": "MCP_ALLOW_STATIC_FALLBACK",
      "label": "Set to 'true' to allow HTTP startup when config",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Set to 'true' to allow HTTP startup when config.json has static credentials. Otherwise the server refuses to start, preventing silent shared-identity fallback for unauthenticated requests."
    },
    {
      "id": "MCP_CONTENT_MAX_BYTES",
      "envVar": "MCP_CONTENT_MAX_BYTES",
      "label": "Byte cap for content bodies (wikitext, rendered HTML, diffs) returned by get-page, get-pages, parse-wikitext, and compare-pages",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Byte cap for content bodies (wikitext, rendered HTML, diffs) returned by get-page, get-pages, parse-wikitext, and compare-pages. Oversized bodies are truncated with a trailing marker.",
      "default": "50000"
    },
    {
      "id": "MCP_TRANSPORT",
      "envVar": "MCP_TRANSPORT",
      "label": "Type of MCP server transport",
      "type": "enum",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Type of MCP server transport",
      "default": "stdio",
      "options": [
        "stdio",
        "http"
      ]
    },
    {
      "id": "PORT",
      "envVar": "PORT",
      "label": "Port used for StreamableHTTP transport",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Port used for StreamableHTTP transport",
      "default": "3000"
    }
  ]
}
