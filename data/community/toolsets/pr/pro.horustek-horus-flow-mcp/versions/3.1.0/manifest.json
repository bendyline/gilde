  "runtime": {
    "kind": "http-mcp",
    "url": "https://flow.horustek.pro/mcp",
    "transport": "streamable-http",
    "authHint": "none",
    "envHints": [
      "X-API-Key"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "X-API-Key",
      "envVar": "X-API-Key",
