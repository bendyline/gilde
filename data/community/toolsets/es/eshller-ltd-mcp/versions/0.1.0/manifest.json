{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-08-12T09:20:38.378165Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.eshway.com/mcp/",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "LTD API token as a Bearer token",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "LTD API token as a Bearer token",
      "default": "Bearer {LTD_API_TOKEN}"
    }
  ]
}
