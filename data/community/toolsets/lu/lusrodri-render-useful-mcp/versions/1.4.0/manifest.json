    "entry": "dist/index.js",
    "args": [],
    "envHints": [
      "RENDER_API_KEY",
      "RENDER_WORKSPACE_ID",
      "RENDER_MCP_TOOLSETS",
      "RENDER_MCP_READ_ONLY",
      "RENDER_MCP_DYNAMIC_TOOLSETS"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "RENDER_API_KEY",
      "envVar": "RENDER_API_KEY",
      "label": "Render API key, created at https://dashboard",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Render API key, created at https://dashboard.render.com/u/settings#api-keys",
      "placeholder": "rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    },
    {
      "id": "RENDER_WORKSPACE_ID",
      "envVar": "RENDER_WORKSPACE_ID",
      "label": "Default workspace, applied wherever a tool needs an ownerId and the caller omitted one",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Default workspace, applied wherever a tool needs an ownerId and the caller omitted one.",
      "placeholder": "tea-xxxxxxxxxxxxxxxxxxxx"
    },
    {
      "id": "RENDER_MCP_TOOLSETS",
      "envVar": "RENDER_MCP_TOOLSETS",
      "label": "Comma-separated toolsets to expose, or 'all'",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Comma-separated toolsets to expose, or 'all'. Defaults to all 17 toolsets.",
      "placeholder": "services,logs,postgres"
    },
    {
      "id": "RENDER_MCP_READ_ONLY",
      "envVar": "RENDER_MCP_READ_ONLY",
      "label": "Expose only non-mutating tools",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Expose only non-mutating tools.",
      "default": "false"
    },
    {
      "id": "RENDER_MCP_DYNAMIC_TOOLSETS",
      "envVar": "RENDER_MCP_DYNAMIC_TOOLSETS",
      "label": "Registers the render_toolsets tool, which reports which toolsets exist and which are enabled",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Registers the render_toolsets tool, which reports which toolsets exist and which are enabled.",
      "default": "true"
    }
  ]
