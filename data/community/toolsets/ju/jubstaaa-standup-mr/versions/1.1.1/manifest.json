{
  "schemaVersion": 1,
  "version": "1.1.1",
  "releasedAt": "2026-10-13T07:49:23.064956Z",
  "runtime": {
    "kind": "npm-package",
    "package": "standup-mr",
    "version": "1.1.1",
    "sha256": "97c84850525d0104bfaed86d379fe0465f51eb573a0f5c8d19a131a64a22ba29",
    "entry": "dist/cli.js",
    "args": [
      "mcp"
    ],
    "envHints": [
      "STANDUP_PROVIDER",
      "GITHUB_HOST",
      "GITHUB_TOKEN",
      "GITLAB_HOST",
      "GITLAB_TOKEN"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "STANDUP_PROVIDER",
      "envVar": "STANDUP_PROVIDER",
      "label": "Which provider to read: github or gitlab",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Which provider to read: github or gitlab. Omit to auto-detect."
    },
    {
      "id": "GITHUB_HOST",
      "envVar": "GITHUB_HOST",
      "label": "GitHub host",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "GitHub host. Defaults to github.com; set it for GitHub Enterprise."
    },
    {
      "id": "GITHUB_TOKEN",
      "envVar": "GITHUB_TOKEN",
      "label": "GitHub token",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "GitHub token. Falls back to the gh CLI session when unset."
    },
    {
      "id": "GITLAB_HOST",
      "envVar": "GITLAB_HOST",
      "label": "GitLab host",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "GitLab host. Required for GitLab, which has no default host."
    },
    {
      "id": "GITLAB_TOKEN",
      "envVar": "GITLAB_TOKEN",
      "label": "GitLab token",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "GitLab token. Falls back to the glab CLI session when unset."
    }
  ]
}
