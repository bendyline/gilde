{
  "schemaVersion": 1,
  "version": "1.0.2",
  "releasedAt": "2026-10-22T10:38:45.48749Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://bintu-web-reader.mcpize.run/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer <your MCPize subscription key>",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer <your MCPize subscription key>. Subscribe on the MCPize listing; a free plan is available."
    }
  ]
}
