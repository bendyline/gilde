    {
      "id": "GOOGLE_TASKS_CLIENT_ID",
      "envVar": "GOOGLE_TASKS_CLIENT_ID",
      "label": "Google OAuth2 client id (refresh-token flow)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Google OAuth2 client id (refresh-token flow)."
    },
    {
      "id": "GOOGLE_TASKS_CLIENT_SECRET",
      "envVar": "GOOGLE_TASKS_CLIENT_SECRET",
      "label": "Google OAuth2 client secret (refresh-token flow)",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Google OAuth2 client secret (refresh-token flow). Treat it as a secret."
    },
    {
      "id": "GOOGLE_TASKS_REFRESH_TOKEN",
      "envVar": "GOOGLE_TASKS_REFRESH_TOKEN",
      "label": "Google OAuth2 refresh token, exchanged for access tokens automatically",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Google OAuth2 refresh token, exchanged for access tokens automatically. Treat it as a secret."
    },
    {
      "id": "GOOGLE_TASKS_ACCESS_TOKEN",
      "envVar": "GOOGLE_TASKS_ACCESS_TOKEN",
      "label": "Static OAuth2 access token (~1h lifetime) — alternative to the refresh-token trio, mostly for testing",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Static OAuth2 access token (~1h lifetime) — alternative to the refresh-token trio, mostly for testing."
    },
    {
      "id": "GOOGLE_TASKS_OAUTH_PORT",
      "envVar": "GOOGLE_TASKS_OAUTH_PORT",
      "label": "Fixed port for the loopback listener of the in-chat login (127",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Fixed port for the loopback listener of the in-chat login (127.0.0.1 + PKCE). Set it when the client runs over SSH port forwarding; otherwise a free port is picked per login."
    },
    {
      "id": "GOOGLE_TASKS_API_BASE",
      "envVar": "GOOGLE_TASKS_API_BASE",
      "label": "API root override",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "API root override.",
      "default": "https://tasks.googleapis.com"
    },
    {
      "id": "GOOGLE_TASKS_TIMEOUT_MS",
      "envVar": "GOOGLE_TASKS_TIMEOUT_MS",
      "label": "Per-request timeout in milliseconds",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Per-request timeout in milliseconds.",
      "default": "60000"
    },
    {
      "id": "GOOGLE_TASKS_MAX_RETRIES",
      "envVar": "GOOGLE_TASKS_MAX_RETRIES",
      "label": "Retries on transient errors (429 always; 5xx/network for reads)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Retries on transient errors (429 always; 5xx/network for reads).",
      "default": "3"
    }
