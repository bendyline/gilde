  "config": [
    {
      "id": "GOOGLE_CUSTOM_SEARCH_API_KEY",
      "envVar": "GOOGLE_CUSTOM_SEARCH_API_KEY",
      "label": "Google Cloud API key with the Custom Search API enabled",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Google Cloud API key with the Custom Search API enabled. Treat it as a secret."
    },
    {
      "id": "GOOGLE_CUSTOM_SEARCH_ENGINE_ID",
      "envVar": "GOOGLE_CUSTOM_SEARCH_ENGINE_ID",
      "label": "Default Programmable Search Engine id (cx)",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Default Programmable Search Engine id (cx). Tools accept a per-call engine_id override."
    },
    {
      "id": "GOOGLE_CUSTOM_SEARCH_API_BASE",
      "envVar": "GOOGLE_CUSTOM_SEARCH_API_BASE",
      "label": "API root override",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "API root override.",
      "default": "https://customsearch.googleapis.com"
    },
    {
      "id": "GOOGLE_CUSTOM_SEARCH_TIMEOUT_MS",
      "envVar": "GOOGLE_CUSTOM_SEARCH_TIMEOUT_MS",
