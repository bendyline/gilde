      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Static OAuth2 access token (~1h lifetime) — alternative to the refresh-token trio, e.g. a service-account (Chat app) token or for testing."
    },
    {
      "id": "GOOGLE_CHAT_OAUTH_PORT",
      "envVar": "GOOGLE_CHAT_OAUTH_PORT",
      "label": "Fixed port for the loopback listener of the in-chat login (127",
