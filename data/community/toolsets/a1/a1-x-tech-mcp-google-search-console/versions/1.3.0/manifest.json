      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "API root override.",
      "default": "https://searchconsole.googleapis.com"
    },
    {
      "id": "GOOGLE_SEARCH_CONSOLE_TIMEOUT_MS",
      "envVar": "GOOGLE_SEARCH_CONSOLE_TIMEOUT_MS",
      "label": "Per-request timeout in milliseconds",
      "type": "string",
      "secret": false,
      "required": false,
      "multiline": false,
      "description": "Per-request timeout in milliseconds.",
      "default": "60000"
    },
    {
      "id": "GOOGLE_SEARCH_CONSOLE_MAX_RETRIES",
      "envVar": "GOOGLE_SEARCH_CONSOLE_MAX_RETRIES",
      "label": "Retries on transient errors (429 always; 5xx/network for reads)",
