  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.imagcon.app/",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
