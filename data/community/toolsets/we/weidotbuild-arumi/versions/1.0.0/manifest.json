{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-11-06T12:17:41.590271Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.arumi.ai/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Bearer followed by your Arumi API key, from https://arumi",
      "type": "string",
      "secret": true,
      "required": true,
      "multiline": false,
      "description": "Bearer followed by your Arumi API key, from https://arumi.ai/api-keys"
    }
  ]
}
