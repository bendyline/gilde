  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.webask.io/mcp/v1",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "WebAsk API key: Settings → API / MCP",
