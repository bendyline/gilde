{
  "schemaVersion": 1,
  "version": "1.1.0",
  "releasedAt": "2026-10-15T16:45:28.792512Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://mcp.tallyworkout.app/api/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Optional",
      "type": "string",
      "secret": true,
      "required": false,
      "multiline": false,
      "description": "Optional. OAuth 2.1 is the default. For clients without OAuth: Bearer <API key from Tally → Settings → API keys>."
    }
  ]
}
