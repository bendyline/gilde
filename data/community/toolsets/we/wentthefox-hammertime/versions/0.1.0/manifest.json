{
  "schemaVersion": 1,
  "version": "0.1.0",
  "releasedAt": "2026-10-23T01:49:08.249055Z",
  "runtime": {
    "kind": "http-mcp",
    "url": "https://api.hammertime.cyou/mcp",
    "transport": "streamable-http",
    "authHint": "bearer",
    "envHints": [
      "Authorization"
    ]
  },
  "tools": [],
  "config": [
    {
      "id": "Authorization",
      "envVar": "Authorization",
      "label": "Your HammerTime API key, created at https://hammertime",
      "type": "string",
      "secret": false,
      "required": true,
      "multiline": false,
      "description": "Your HammerTime API key, created at https://hammertime.cyou/en/api",
      "default": "Bearer {api_key}"
    }
  ]
}
