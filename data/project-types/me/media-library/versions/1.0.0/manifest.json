{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-19T00:00:00Z",
  "extends": "media-production",
  "nameTemplate": "Media Library",
  "aboutTemplate": "about.md",
  "missionTemplate": "mission.md",
  "pages": {
    "entry": "index.html",
    "api": 1,
    "reads": [
      {
        "source": "workspace",
        "path": ".",
        "subtree": true
      }
    ],
    "imports": [
      {
        "id": "library",
        "source": "workspace",
        "path": ".",
        "accept": [
          ".jpg",
          ".jpeg",
          ".png",
          ".gif",
          ".webp",
          ".avif",
          ".bmp",
          ".svg",
          ".ico",
          ".heic",
          ".heif",
          ".tif",
          ".tiff",
          ".dng",
          ".raw",
          ".cr2",
          ".cr3",
          ".nef",
          ".arw",
          ".orf",
          ".raf",
          ".mp4",
          ".webm",
          ".mov",
          ".m4v",
          ".ogv",
          ".avi",
          ".mkv",
          ".mpg",
          ".mpeg",
          ".mts",
          ".m2ts",
          ".mp3",
          ".wav",
          ".ogg",
          ".oga",
          ".m4a",
          ".aac",
          ".flac",
          ".opus",
          ".aif",
          ".aiff",
          ".wma"
        ],
        "maxFileBytes": 268435456
      }
    ]
  }
}
