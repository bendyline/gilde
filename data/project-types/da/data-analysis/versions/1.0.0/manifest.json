{
  "schemaVersion": 1,
  "version": "1.0.0",
  "releasedAt": "2026-10-19T00:00:00Z",
  "extends": "data-analysis",
  "nameTemplate": "Data Analysis",
  "aboutTemplate": "about.md",
  "missionTemplate": "mission.md",
  "gezels": [
    {
      "templateId": "researcher",
      "voorman": true
    }
  ],
  "pages": {
    "entry": "index.html",
    "api": 1,
    "reads": [
      {
        "source": "workspace",
        "path": ".",
        "subtree": true
      }
    ],
    "imports": [
      {
        "id": "data",
        "source": "workspace",
        "path": ".",
        "accept": [
          ".csv",
          ".tsv",
          ".tab",
          ".xlsx",
          ".xls",
          ".xlsm",
          ".xlsb",
          ".ods",
          ".numbers",
          ".json",
          ".jsonl",
          ".ndjson",
          ".parquet",
          ".arrow",
          ".feather",
          ".sqlite",
          ".sqlite3",
          ".db",
          ".duckdb",
          ".h5",
          ".hdf5",
          ".rds",
          ".rdata",
          ".sav",
          ".dta",
          ".sas7bdat",
          ".xml",
          ".html",
          ".htm",
          ".pdf",
          ".md",
          ".docx",
          ".pptx",
          ".ipynb"
        ],
        "maxFileBytes": 268435456
      }
    ]
  }
}
