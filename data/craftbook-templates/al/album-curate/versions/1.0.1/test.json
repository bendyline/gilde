  "success": {
    "summary": "albums/lake-weekend.json is a schema-clean manifest of 10+ picks that all exist in the photo index (no invented files, bursts collapsed), each with caption and reason, and report.md tells the album's arc including the cuts.",
    "deliverables": [
      {
        "path": "albums/lake-weekend.json",
        "kind": "json",
        "minBytes": 400,
        "checks": [
          {
            "kind": "recordSchema",
            "file": "albums/lake-weekend.json",
            "fields": [
              {
                "name": "file",
                "type": "nonempty"
              },
              {
                "name": "caption",
                "type": "nonempty"
              },
              {
                "name": "reason",
                "type": "nonempty"
              }
            ],
            "minRows": 10
          },
          {
            "kind": "valuesSubsetOf",
            "file": "albums/lake-weekend.json",
            "sourceFiles": [
              "photos/index.json"
            ],
            "pattern": "(IMG_\\d{4}\\.jpg)",
            "flags": "gi",
            "minMatches": 10
          }
        ]
      },
      {
        "path": "report.md",
        "kind": "markdown-report",
        "minBytes": 500,
        "checks": [
          {
            "kind": "contains",
            "file": "report.md",
            "pattern": "(?:^|\\n)#{1,3}\\s+\\S",
            "flags": "i"
          },
          {
            "kind": "contains",
            "file": "report.md",
            "pattern": "dupl|near-dup|burst|similar",
            "flags": "i",
            "label": "the cull is explained — bursts and near-duplicates named"
          }
        ]
      }
    ]
  },
  "rubric": {
    "artifact": {
      "path": "report.md",
      "kind": "markdown"
    },
    "axes": [
      {
        "name": "curation",
        "description": "The picks are the frames that carry the weekend — the caption-noted standouts are in, filler is out, and the count respects the asked size."
      },
      {
        "name": "dedupe",
        "description": "Each burst cluster (photos seconds apart) contributes at most one frame, chosen for a stated reason."
      },
      {
        "name": "captions",
        "description": "Captions are warm and specific to what the frame shows, leaning on the caption notes where they exist."
      },
      {
        "name": "story-arc",
        "description": "The pick order and the report's arc read as the weekend start to end — arrival to packing the car."
      }
    ]
  },
  "qualityFocus": [
    "no invented photos",
    "burst dedupe",
    "honest reasons per pick"
  ]
