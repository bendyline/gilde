            "label": "include Maya Chen title: VP of Product"
          },
          {
            "kind": "contains",
            "file": "press-release.md",
            "pattern": "18\\s*hours",
            "flags": "i",
            "label": "include the source metric: 18 hours"
          },
          {
            "kind": "contains",
            "file": "press-release.md",
            "pattern": "(?:6|six)\\s*hours",
            "flags": "i",
            "label": "include the source metric: 6 hours"
          },
          {
            "kind": "contains",
            "file": "press-release.md",
