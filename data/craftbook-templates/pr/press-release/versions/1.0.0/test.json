            "flags": "i",
            "label": "include a dated dateline such as \"BOSTON, Mass., June 28, 2026\""
          },
          {
            "kind": "contains",
            "file": "press-release.md",
            "pattern": "Maya Chen",
            "flags": "i",
            "label": "include the approved quote speaker Maya Chen"
          },
          {
            "kind": "contains",
            "file": "press-release.md",
