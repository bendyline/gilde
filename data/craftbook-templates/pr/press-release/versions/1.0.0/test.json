          {
            "kind": "contains",
            "file": "press-release.md",
            "pattern": "(?:^|\\n)###\\s*$",
            "flags": "i",
            "label": "end the release with a standalone ### line"
          },
          {
            "kind": "notContains",
            "file": "press-release.md",
            "pattern": "revolutioniz|game-changing|world-class|guaranteed|transformative|transforming|dramatic|innovative|moderniz|significant(?:ly)?|thorough|rigorous(?:ly)?|major (?:update|step)|massive (?:step|update)|slash(?:es|ed|ing)?|75%|proactive instead of reactive|custom-printed|specialized equipment|large enterprise(?:s)?|creative agencies|enterprise-level|price tag|555",
            "flags": "i",
            "label": "remove promotional hype and invented details not present in the brief"
