{
  "schemaVersion": 1,
  "title": "AP-style press release from news brief",
  "objective": "Measure whether the press-release craftbook scopes the five Ws and writes a factual, standard-format release with quote, boilerplate, contact, and end mark.",
  "tags": [
    "corpus"
  ],
  "prompt": "In the `Press Release Eval` project, read `source/news-brief.md` and write `press-release.md`. Use a standard headline, subhead, dateline, inverted-pyramid lede, attributed quote, boilerplate, media contact, and closing ###. Keep it factual and avoid promotional hype. Use the source boilerplate sentence exactly, without expanding Boreal Desk beyond the brief.",
  "setup": {
    "projectName": "Press Release Eval",
    "about": "Self-contained eval project for press-release. The approved news facts are in workspace/source/news-brief.md.",
    "missionObjectives": "Write a factual AP-style press release from seeded facts with all standard structural elements.",
    "files": [
      {
        "path": "source/news-brief.md",
        "content": "# News brief\n\nCompany: Boreal Desk, maker of workflow software for independent design studios.\nNews: Boreal Desk is launching HarborCRM guided returns intake for Pro accounts.\nTiming: June 28, 2026.\nLocation/dateline: BOSTON, Mass.\nWhy now: a March pilot across 18 home-office accessory SKUs cut median first response from 18 hours to 6 hours and reduced preventable refund leakage from 14.2% to 8.9%.\nQuote: \"Guided intake gives support teams the context they need before the first reply,\" said Maya Chen, VP of Product at Boreal Desk.\nBoilerplate: Boreal Desk builds practical operations tools for independent design studios.\nMedia contact: press@borealdesk.example, Lena Moore.\n"
      }
    ],
    "worker": {
      "name": "Roos",
      "role": "PR Writer"
    }
  },
  "mocks": [],
