{
  "schemaVersion": 1,
  "title": "Juice Pass — feedback on every action, nothing broken",
  "objective": "Measure whether the juice-pass craftbook adds action feedback (flash, shake, particles, sound hooks) to a working but feedback-free canvas game while keeping it fully playable — the script still parses, the loop still runs, game over and restart still work.",
  "tags": [
    "html-game"
  ],
  "prompt": "the game works but feels kinda dead — can you give it some juice? screenshake, hit feedback, that sort of thign",
  "setup": {
    "projectName": "Meteor Lane Arcade",
    "about": "Web arcade project. The game is workspace/index.html — a working canvas dodger with steering, score, game over, and restart, and no feedback effects at all. The juice pass edits it in place.",
    "missionObjectives": "Every player action should get visible feedback, added with restraint — and the game must stay playable after every change. No live services, no real credentials.",
    "files": [
      {
        "path": "index.html",
        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Meteor Lane</title>\n<style>\n  body { margin: 0; background: #0b0e1a; color: #dfe6ff; font-family: monospace;\n         display: flex; flex-direction: column; align-items: center; }\n  h1 { font-size: 18px; margin: 12px 0 4px; }\n  canvas { border: 1px solid #2a3355; background: #101528; }\n  p { font-size: 12px; color: #8a93b8; }\n</style>\n</head>\n<body>\n<h1>Meteor Lane</h1>\n<canvas id=\"game\" width=\"480\" height=\"600\"></canvas>\n<p>Arrow keys to steer. R to restart.</p>\n<script>\nvar canvas = document.getElementById('game');\nvar ctx = canvas.getContext('2d');\nvar W = canvas.width, H = canvas.height;\n\nvar ship, meteors, score, over, spawnTimer, keys = {};\n\nfunction reset() {\n  ship = { x: W / 2, y: H - 48, w: 26, h: 30, speed: 4.2 };\n  meteors = [];\n  score = 0;\n  over = false;\n  spawnTimer = 0;\n}\n\ndocument.addEventListener('keydown', function (e) {\n  keys[e.key] = true;\n  if (over && (e.key === 'r' || e.key === 'R')) reset();\n});\ndocument.addEventListener('keyup', function (e) { keys[e.key] = false; });\n\nfunction spawnMeteor() {\n  var r = 10 + Math.random() * 16;\n  meteors.push({ x: r + Math.random() * (W - 2 * r), y: -r, r: r, vy: 1.6 + Math.random() * 2.2 });\n}\n\nfunction update() {\n  if (over) return;\n  if (keys.ArrowLeft) ship.x -= ship.speed;\n  if (keys.ArrowRight) ship.x += ship.speed;\n  ship.x = Math.max(ship.w / 2, Math.min(W - ship.w / 2, ship.x));\n\n  spawnTimer -= 1;\n  if (spawnTimer <= 0) {\n    spawnMeteor();\n    spawnTimer = Math.max(18, 46 - Math.floor(score / 8));\n  }\n\n  for (var i = meteors.length - 1; i >= 0; i--) {\n    var m = meteors[i];\n    m.y += m.vy;\n    if (m.y - m.r > H) {\n      meteors.splice(i, 1);\n      score += 1;\n      continue;\n    }\n    var dx = Math.abs(m.x - ship.x), dy = Math.abs(m.y - ship.y);\n    if (dx < m.r + ship.w / 2 - 4 && dy < m.r + ship.h / 2 - 4) {\n      over = true;\n    }\n  }\n}\n\nfunction drawShip() {\n  ctx.fillStyle = '#9fd0ff';\n  ctx.beginPath();\n  ctx.moveTo(ship.x, ship.y - ship.h / 2);\n  ctx.lineTo(ship.x - ship.w / 2, ship.y + ship.h / 2);\n  ctx.lineTo(ship.x + ship.w / 2, ship.y + ship.h / 2);\n  ctx.closePath();\n  ctx.fill();\n}\n\nfunction draw() {\n  ctx.clearRect(0, 0, W, H);\n  drawShip();\n  ctx.fillStyle = '#b98a5e';\n  for (var i = 0; i < meteors.length; i++) {\n    var m = meteors[i];\n    ctx.beginPath();\n    ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);\n    ctx.fill();\n  }\n  ctx.fillStyle = '#dfe6ff';\n  ctx.font = '16px monospace';\n  ctx.fillText('Score: ' + score, 12, 24);\n  if (over) {\n    ctx.font = '28px monospace';\n    ctx.fillText('GAME OVER', W / 2 - 76, H / 2 - 10);\n    ctx.font = '14px monospace';\n    ctx.fillText('Press R to restart', W / 2 - 72, H / 2 + 16);\n  }\n}\n\nfunction loop() {\n  update();\n  draw();\n  requestAnimationFrame(loop);\n}\n\nreset();\nloop();\n</script>\n</body>\n</html>\n"
      }
    ],
    "worker": {
      "name": "Ties",
      "role": "Game developer"
    }
  },
