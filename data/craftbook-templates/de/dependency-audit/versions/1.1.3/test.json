{
  "schemaVersion": 1,
  "title": "Dependency Audit evidence-discipline eval",
  "objective": "Measure whether the audit prioritizes supplied vulnerability and license evidence without inventing package facts or patch versions.",
  "tags": [
    "corpus"
  ],
  "prompt": "Use the Dependency Audit craftbook for the weekly maintenance review. Treat evidence/dependencies.json as authoritative and write tasks/eval/dependency-audit.md. Do not use the network or modify package files.",
  "setup": {
    "projectName": "Dependency Maintenance Eval",
    "about": "A package fixture with authoritative offline dependency evidence.",
    "missionObjectives": "Prioritize the no-patch critical dependency, exact license issue, maintenance-only upgrade, and clean defer correctly.",
    "files": [
      {
        "path": "package.json",
        "content": "{\n  \"name\": \"returns-desk\",\n  \"dependencies\": {\n    \"legacy-parser\": \"1.2.0\",\n    \"chart-kit\": \"2.0.0\",\n    \"stable-lib\": \"4.2.0\"\n  }\n}\n"
      },
      {
        "path": "evidence/dependencies.json",
        "content": "[\n  {\"name\":\"legacy-parser\",\"installed\":\"1.2.0\",\"latest\":\"1.2.0\",\"advisory\":\"CVE-2026-4242\",\"severity\":\"critical\",\"patchedVersion\":null,\"reachableFrom\":\"src/import.ts\",\"replacement\":\"safe-parser 3.x\",\"license\":\"MIT\"},\n  {\"name\":\"chart-kit\",\"installed\":\"2.0.0\",\"latest\":\"3.1.0\",\"advisory\":null,\"maintenance\":\"major version available\",\"license\":\"GPL-3.0-only\",\"replacement\":\"chart.js 4.x\"},\n  {\"name\":\"stable-lib\",\"installed\":\"4.2.0\",\"latest\":\"4.2.0\",\"advisory\":null,\"maintenance\":null,\"license\":\"MIT\"}\n]\n"
      },
      {
        "path": "src/import.ts",
        "content": "import { parse } from 'legacy-parser';\nexport const importRows = (text: string) => parse(text);\n"
      }
    ],
    "worker": {
      "name": "Rae",
      "role": "Reviewer"
    },
    "craftbookParams": {
      "workPath": "tasks/eval"
    }
  },
  "mocks": [],
  "success": {
    "summary": "tasks/eval/dependency-audit.md follows the evidence, orders the critical no-patch action first, and handles license and clean dependencies honestly.",
    "deliverables": [
      {
        "path": "tasks/eval/dependency-audit.md",
        "kind": "markdown-report",
        "minBytes": 1300,
        "checks": [
          {
            "kind": "contains",
            "file": "tasks/eval/dependency-audit.md",
            "pattern": "legacy-parser[\\s\\S]{0,300}CVE-2026-4242",
            "flags": "i"
          },
          {
            "kind": "contains",
            "file": "tasks/eval/dependency-audit.md",
            "pattern": "safe-parser 3\\.x|no patched version|contain",
            "flags": "i",
            "label": "no-patch action"
          },
          {
            "kind": "contains",
            "file": "tasks/eval/dependency-audit.md",
            "pattern": "chart-kit[\\s\\S]{0,300}GPL-3\\.0-only",
            "flags": "i"
          },
          {
            "kind": "contains",
            "file": "tasks/eval/dependency-audit.md",
            "pattern": "chart\\.js 4\\.x",
            "flags": "i"
          },
          {
            "kind": "contains",
            "file": "tasks/eval/dependency-audit.md",
            "pattern": "stable-lib[\\s\\S]{0,200}(defer|no action|current)",
            "flags": "i"
          },
          {
            "kind": "notContains",
            "file": "tasks/eval/dependency-audit.md",
            "pattern": "legacy-parser[\\s\\S]{0,120}(patch upgrade|upgrade to 1\\.)",
            "flags": "i",
            "label": "do not invent a patch"
          }
        ]
      }
    ]
  },
  "rubric": {
    "artifact": {
      "path": "tasks/eval/dependency-audit.md",
      "kind": "markdown"
    },
    "axes": [
      {
        "name": "evidence discipline",
        "description": "Package facts and versions come only from supplied evidence."
      },
      {
        "name": "prioritization",
        "description": "Risk, reachability, license, and migration cost drive a sensible order."
      },
      {
        "name": "actionability",
        "description": "Each package receives an exact upgrade, replace, contain, or defer action."
      }
    ]
  },
  "qualityFocus": [
    "offline evidence fidelity",
    "no-patch handling",
    "license accuracy"
  ]
}
