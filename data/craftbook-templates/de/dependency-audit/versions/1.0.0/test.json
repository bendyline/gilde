{
  "schemaVersion": 1,
  "title": "Dependency remediation report from fake audit inputs",
  "objective": "Measure whether the dependency-audit craftbook turns manifest/audit evidence into prioritized, justified upgrade/remove/replace actions.",
  "tags": [
    "code"
  ],
  "prompt": "In the `Dependency Audit Eval` project, read `source/package.json`, `source/npm-audit.json`, and `source/dependency-notes.md`, then write `dependency-audit.md` with Summary, Action plan, License flags, Needs human decision, and Recommended order. Use only the seeded evidence; do not run network audits.",
  "setup": {
    "projectName": "Dependency Audit Eval",
    "about": "Self-contained eval project for dependency-audit. Fake manifest and audit evidence are under workspace/source.",
    "missionObjectives": "Write a prioritized dependency risk report with concrete actions, CVE/license/staleness evidence, and migration notes.",
    "files": [
      {
        "path": "source/package.json",
        "content": "{\n  \"dependencies\": {\n    \"express\": \"4.17.1\",\n    \"lodash\": \"4.17.19\",\n    \"left-pad\": \"1.3.0\",\n    \"old-chart\": \"0.9.0\",\n    \"pdfkit\": \"0.12.1\"\n  }\n}\n"
      },
      {
        "path": "source/npm-audit.json",
        "content": "{\n  \"vulnerabilities\": {\n    \"lodash\": { \"severity\": \"high\", \"cve\": \"CVE-2025-7781\", \"installed\": \"4.17.19\", \"patched\": \"4.17.21\" },\n    \"old-chart\": { \"severity\": \"critical\", \"cve\": \"CVE-2024-6610\", \"installed\": \"0.9.0\", \"patched\": null }\n  }\n}\n"
      },
      {
        "path": "source/dependency-notes.md",
        "content": "# Dependency notes\n\n- express 4.17.1 is behind current 4.x but no seeded CVE; patch-upgrade to 4.18.3 is low effort.\n- lodash has high CVE-2025-7781; code uses templating path, so exposure is real. Patch to 4.17.21.\n- left-pad is unused; remove.\n- old-chart is archived, GPL-3.0-only, and has critical CVE-2024-6610 with no patched version; replace with chart.js 4.x, migration medium.\n- pdfkit has MIT license and no seeded issue; defer.\n"
      }
    ],
    "worker": {
      "name": "Puck",
      "role": "Security Reviewer"
    }
  },
  "mocks": [],
  "success": {
    "summary": "workspace/dependency-audit.md prioritizes seeded dependency risks with concrete upgrade/remove/replace targets, CVEs, license flags, and migration order.",
    "deliverables": [
      {
        "path": "dependency-audit.md",
        "kind": "markdown-report",
        "minBytes": 2200,
        "checks": [
          {
            "kind": "contains",
            "file": "dependency-audit.md",
            "pattern": "(?:^|\\n)#{1,3}\\s+\\S",
            "flags": "i"
          },
          {
            "kind": "contains",
            "file": "dependency-audit.md",
            "pattern": "Summary|Action plan|License flags|Needs human decision|Recommended order",
            "flags": "i"
          },
          {
            "kind": "contains",
            "file": "dependency-audit.md",
            "pattern": "lodash[\\s\\S]{0,260}CVE-2025-7781|CVE-2025-7781[\\s\\S]{0,260}lodash",
            "flags": "i"
          },
          {
            "kind": "contains",
            "file": "dependency-audit.md",
            "pattern": "lodash[\\s\\S]{0,260}4\\.17\\.21|4\\.17\\.21[\\s\\S]{0,260}lodash",
            "flags": "i"
          },
          {
            "kind": "contains",
            "file": "dependency-audit.md",
            "pattern": "old-chart[\\s\\S]{0,500}CVE-2024-6610|CVE-2024-6610[\\s\\S]{0,500}old-chart",
            "flags": "i",
            "label": "old-chart includes its seeded CVE"
          },
          {
            "kind": "contains",
            "file": "dependency-audit.md",
            "pattern": "old-chart[\\s\\S]{0,500}critical|critical[\\s\\S]{0,500}old-chart",
            "flags": "i",
            "label": "old-chart stays critical"
          },
          {
            "kind": "contains",
            "file": "dependency-audit.md",
            "pattern": "old-chart[\\s\\S]{0,500}GPL-3\\.0-only|GPL-3\\.0-only[\\s\\S]{0,500}old-chart",
            "flags": "i",
            "label": "old-chart license flag is GPL-3.0-only"
          },
          {
            "kind": "contains",
            "file": "dependency-audit.md",
            "pattern": "old-chart[\\s\\S]{0,500}(replace|chart\\.js)|chart\\.js[\\s\\S]{0,500}old-chart",
            "flags": "i",
            "label": "old-chart action is replacement-oriented"
          },
          {
            "kind": "contains",
            "file": "dependency-audit.md",
            "pattern": "old-chart[\\s\\S]{0,600}chart\\.js\\s*4\\.x|chart\\.js\\s*4\\.x[\\s\\S]{0,600}old-chart",
            "flags": "i",
            "label": "old-chart replacement target is chart.js 4.x"
          },
          {
            "kind": "contains",
            "file": "dependency-audit.md",
            "pattern": "old-chart[\\s\\S]{0,500}(no patched version|no patch)|(?:no patched version|no patch)[\\s\\S]{0,500}old-chart",
            "flags": "i",
            "label": "old-chart no-patch evidence is preserved"
          },
          {
            "kind": "contains",
            "file": "dependency-audit.md",
            "pattern": "License flags[\\s\\S]{0,700}(old-chart[\\s\\S]{0,300}GPL-3\\.0-only|GPL-3\\.0-only[\\s\\S]{0,300}old-chart)",
            "flags": "i",
            "label": "license section names old-chart GPL-3.0-only flag"
          },
          {
            "kind": "contains",
            "file": "dependency-audit.md",
            "pattern": "left-pad[\\s\\S]{0,220}(unused|remove|removal)|(?:unused|remove|removal)[\\s\\S]{0,220}left-pad",
            "flags": "i",
            "label": "left-pad is unused/remove"
          },
          {
            "kind": "contains",
            "file": "dependency-audit.md",
            "pattern": "express[\\s\\S]{0,220}4\\.18\\.3|4\\.18\\.3[\\s\\S]{0,220}express",
            "flags": "i",
            "label": "express maintenance action names target 4.18.3"
          },
          {
            "kind": "contains",
            "file": "dependency-audit.md",
            "pattern": "express[\\s\\S]{0,260}(low effort|patch-upgrade|maintenance)|(?:low effort|patch-upgrade|maintenance)[\\s\\S]{0,260}express",
            "flags": "i",
            "label": "express is a maintenance/low-effort upgrade, not CVE-driven"
          },
          {
            "kind": "contains",
            "file": "dependency-audit.md",
            "pattern": "pdfkit[\\s\\S]{0,260}(\\bMIT\\b|no seeded issue|defer)|(?:\\bMIT\\b|no seeded issue|defer)[\\s\\S]{0,260}pdfkit",
            "flags": "i",
            "label": "pdfkit is explicitly deferred"
          },
          {
            "kind": "notContains",
            "file": "dependency-audit.md",
            "pattern": "No specific license flags were found|all listed dependencies are currently compliant|no (?:specific )?license flags (?:were )?found",
            "flags": "i",
            "label": "must not deny seeded GPL flag"
          },
          {
            "kind": "notContains",
            "file": "dependency-audit.md",
            "pattern": "(?:update|upgrade|patch-upgrade)\\s+`?old-chart`?\\s+(?:from|to)|old-chart[\\s\\S]{0,120}to a patched version",
            "flags": "i",
            "label": "old-chart must not be treated as patch-upgradeable"
          },
          {
            "kind": "notContains",
            "file": "dependency-audit.md",
            "pattern": "(?:Update|Upgrade)\\s+`?old-chart`?",
            "flags": "i",
            "label": "old-chart action heading must be replace/remove, not update/upgrade"
          },
          {
            "kind": "notContains",
            "file": "dependency-audit.md",
            "pattern": "express[^\\n]*(?:CVE-\\d{4}-\\d+|security|advisory|advisories|vulnerab|patches)",
            "flags": "i",
            "label": "express lines must be maintenance-only: remove security, advisory, vulnerability, patch, or posture wording unless evidence names a CVE"
          },
          {
            "kind": "notContains",
            "file": "dependency-audit.md",
            "pattern": "express(?:(?!\\n### ).){0,500}(?:security posture|security improvement|security and maintenance|security best practices|security patches|advisory|advisories)",
            "flags": "is",
            "label": "express section must stay maintenance-only; remove unsupported security/advisory/posture wording"
          },
          {
            "kind": "notContains",
            "file": "dependency-audit.md",
            "pattern": "^.*pdfkit.*(?:should|recommend(?:ed)?|needs?|requires?|benefit).*?(?:upgrade|replace|moderni[sz]ation|full rewrite|outdated).*$|^.*(?:upgrade|replace|moderni[sz]ation|full rewrite|outdated).*?pdfkit.*$",
            "flags": "im",
            "label": "pdfkit has no seeded remediation"
          },
          {
            "kind": "notContains",
            "file": "dependency-audit.md",
            "pattern": "Action plan(?:(?!\\n## ).){0,1200}(?:lodash|left-pad|express)(?:(?!\\n## ).){0,500}old-chart",
            "flags": "is",
            "label": "action plan must put old-chart before lower-priority work"
          },
          {
            "kind": "notContains",
            "file": "dependency-audit.md",
            "pattern": "Recommended order(?:(?!\\n## ).){0,1200}(?:lodash|left-pad|express)(?:(?!\\n## ).){0,500}old-chart",
            "flags": "is",
            "label": "recommended order must put old-chart before lower-priority work"
          },
          {
            "kind": "notContains",
            "file": "dependency-audit.md",
            "pattern": "just update|run\\s+npm\\s+audit|run npm audit and decide later",
            "flags": "i"
          },
          {
            "kind": "notContains",
            "file": "dependency-audit.md",
            "pattern": "\\bAssumed\\b|\\(Assumed\\)",
            "flags": "i",
            "label": "do not infer missing licenses"
          }
        ]
      }
    ]
  },
  "rubric": {
    "artifact": {
      "path": "dependency-audit.md",
      "kind": "markdown"
    },
    "axes": [
      {
        "name": "correctness",
        "description": "The module does what the requirements ask, with sensible edge handling."
      },
      {
        "name": "verification",
        "description": "Self-tests exercise real behavior, not trivial truths."
      },
      {
        "name": "clarity",
        "description": "Exports, naming, and structure make the module usable without reading every line."
      },
      {
        "name": "robustness",
        "description": "Invalid input and boundary cases fail loudly rather than silently."
      }
    ]
  },
  "qualityFocus": [
    "risk tiering",
    "concrete remediation",
    "license/staleness evidence"
  ]
}
